<MudPaper Outlined="true" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="Model.PlateNumber" Label="Biển số" Required="true" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="Model.VehicleCode" Label="Mã xe" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6" md="4"><MudNumericField T="int?" @bind-Value="Model.SeatCount" Label="Số chỗ" Min="1" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="Model.Brand" Label="Hãng xe" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="Model.Model" Label="Dòng xe" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="Model.VehicleType" Label="Loại xe" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="Model.Color" Label="Màu xe" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="Model.ChassisNumber" Label="Số khung" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="Model.EngineNumber" Label="Số máy" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.OwnerName" Label="Họ tên chủ sở hữu" Required="true" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.OwnerCitizenId" Label="CCCD chủ sở hữu" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="Model.OwnerCitizenIdIssuedDate" Label="Ngày cấp CCCD" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.OwnerCitizenIdIssuedPlace" Label="Nơi cấp CCCD" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.OwnerPhoneNumber" Label="Điện thoại chủ xe" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="Model.OwnerAddress" Label="Địa chỉ chủ xe" Lines="2" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12"><MudSwitch T="bool" @bind-Value="Model.IsActive" Label="Đang sử dụng" Color="Color.Primary" /></MudItem>
    </MudGrid>
    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
        <MudButton Href="@BackUrl" Variant="Variant.Outlined">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@Saving" OnClick="SubmitAsync" StartIcon="@Icons.Material.Filled.Save">@SubmitText</MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public VehicleFormModel Model { get; set; } = null!;
    [Parameter] public bool Saving { get; set; }
    [Parameter] public string SubmitText { get; set; } = "Lưu";
    [Parameter] public string BackUrl { get; set; } = "/admin/vehicles";
    [Parameter] public EventCallback OnSubmit { get; set; }
    private Task SubmitAsync() => OnSubmit.InvokeAsync();
}
