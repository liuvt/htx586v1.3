<MudChip T="string"
         Size="@ChipSize"
         Color="@StatusColor"
         Variant="Variant.Filled"
         Style="font-weight:700; white-space:nowrap;">
    @StatusText
</MudChip>

@code {
    [Parameter, EditorRequired]
    public ContractStatus Status { get; set; }

    [Parameter]
    public Size ChipSize { get; set; } = MudBlazor.Size.Small;

    private Color StatusColor => Status == ContractStatus.Completed
        ? Color.Success
        : Color.Warning;

    private string StatusText => Status == ContractStatus.Completed
        ? "Hoàn tất"
        : "Chờ xác nhận từ khách hàng";
}
