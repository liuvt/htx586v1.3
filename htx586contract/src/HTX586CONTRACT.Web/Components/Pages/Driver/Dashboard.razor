@page "/driver/dashboard"
@attribute [Authorize(Roles = "Driver")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Tổng quan tài xế</PageTitle>
<PageHeader Title="Tổng quan tài xế" Subtitle="Tài xế tự nhập xe, chủ xe, khách hàng và nội dung trên từng hợp đồng.">
    <MudButton Href="/driver/contracts/create" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">Tạo hợp đồng</MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (!_hasDriverSignature || !_hasCompanySignature)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            @(!_hasDriverSignature ? "Tài khoản chưa có chữ ký tài xế cố định. " : string.Empty)
            @(!_hasCompanySignature ? "Công ty chưa có chữ ký cố định. " : string.Empty)
            Bạn vẫn có thể lưu hợp đồng nhưng chưa thể hoàn thành hợp đồng.
        </MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h5">@(_companyName ?? "Chưa xác định công ty")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Thống kê hợp đồng tháng @((_month ?? DateTime.Today).ToString("MM/yyyy"))</MudText>
            </div>
            <MudSpacer />
            <MudDatePicker Date="_month" DateChanged="ChangeMonthAsync" Label="Tháng" DateFormat="MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudStack>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Tổng hợp đồng" Value="@_total.ToString("N0")" Hint="Tạo trong tháng" Icon="@Icons.Material.Filled.Description" Color="Color.Primary" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Đã hoàn thành" Value="@_completed.ToString("N0")" Hint="Đã khóa đủ 4 chữ ký" Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Success" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Đang xử lý" Value="@_processing.ToString("N0")" Hint="Có thể tiếp tục sửa và ký lại" Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Doanh thu" Value="@($"{_revenue:N0} ₫")" Hint="Hợp đồng hoàn thành" Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Info" /></MudItem>
    </MudGrid>

    <MudGrid Class="mt-2">
        <MudItem xs="12" md="6"><MudButton Href="/driver/contracts/create" FullWidth="true" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PostAdd">Tạo hợp đồng mới</MudButton></MudItem>
        <MudItem xs="12" md="6"><MudButton Href="/driver/contracts" FullWidth="true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ListAlt">Danh sách hợp đồng</MudButton></MudItem>
    </MudGrid>
}

@code {
    private string _driverId = string.Empty;
    private string? _companyName;
    private bool _hasDriverSignature;
    private bool _hasCompanySignature;
    private DateTime? _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private int _total;
    private int _completed;
    private int _processing;
    private decimal _revenue;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _driverId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadAsync();
    }

    private async Task ChangeMonthAsync(DateTime? value)
    {
        _month = value ?? DateTime.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await Factory.CreateDbContextAsync();
        var driver = await db.Users.AsNoTracking()
            .Where(x => x.Id == _driverId)
            .Select(x => new
            {
                x.DriverSignatureFileUrl,
                CompanyName = x.AdminAccount == null ? null :
                    (string.IsNullOrWhiteSpace(x.AdminAccount.CompanyBranchName)
                        ? x.AdminAccount.CompanyName
                        : x.AdminAccount.CompanyName + " - " + x.AdminAccount.CompanyBranchName),
                CompanySignature = x.AdminAccount == null ? null : x.AdminAccount.CompanySignatureFileUrl
            }).FirstOrDefaultAsync();
        _companyName = driver?.CompanyName;
        _hasDriverSignature = !string.IsNullOrWhiteSpace(driver?.DriverSignatureFileUrl);
        _hasCompanySignature = !string.IsNullOrWhiteSpace(driver?.CompanySignature);

        var month = _month ?? DateTime.Today;
        var start = new DateTime(month.Year, month.Month, 1);
        var end = start.AddMonths(1);
        var contracts = db.Contracts.AsNoTracking().Where(x => x.DriverId == _driverId && x.CreatedAt >= start && x.CreatedAt < end);
        _total = await contracts.CountAsync();
        _completed = await contracts.CountAsync(x =>
            x.Status == ContractStatus.Completed &&
            x.PdfFileUrl != null && x.PdfFileUrl != "" &&
            x.PdfSha256 != null && x.PdfSha256 != "" &&
            x.PdfGeneratedAt.HasValue);
        _processing = await contracts.CountAsync(x =>
            x.Status != ContractStatus.Cancelled &&
            x.Status != ContractStatus.Expired &&
            x.Status != ContractStatus.Invalidated &&
            !(x.Status == ContractStatus.Completed &&
              x.PdfFileUrl != null && x.PdfFileUrl != "" &&
              x.PdfSha256 != null && x.PdfSha256 != "" &&
              x.PdfGeneratedAt.HasValue));
        _revenue = await contracts
            .Where(x => x.Status == ContractStatus.Completed &&
                        x.PdfFileUrl != null && x.PdfFileUrl != "" &&
                        x.PdfSha256 != null && x.PdfSha256 != "" &&
                        x.PdfGeneratedAt.HasValue)
            .SumAsync(x => x.ContractValue ?? 0);
        _loading = false;
    }
}
