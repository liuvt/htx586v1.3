@page "/driver/account"
@attribute [Authorize(Roles = "Driver")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDriverAccountService Service

<PageTitle>Hồ sơ cá nhân</PageTitle>
<PageHeader Title="Hồ sơ cá nhân" Subtitle="Thông tin và chữ ký cố định của tài xế.">
    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.LockReset" Disabled="@(OpenChangePassword is null)" OnClick="ChangePasswordAsync">Đổi mật khẩu</MudButton>
</PageHeader>

@if (_loading) { <MudProgressLinear Indeterminate="true" /> }
else if (_detail is null) { <MudAlert Severity="Severity.Warning">Không tìm thấy thông tin tài khoản.</MudAlert> }
else
{
    <MudGrid>
        <MudItem xs="12" lg="8">
            <MudPaper Outlined="true" Class="pa-4">
                <MudGrid>
                    <MudItem xs="12" md="6"><InfoListItem Label="Tên đăng nhập" Value="@Display(_detail.UserName)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Họ và tên" Value="@Display(_detail.FullName)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Công ty" Value="@Display(_detail.CompanyName)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Số điện thoại" Value="@Display(_detail.PhoneNumber)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Ngày sinh" Value="@FormatDate(_detail.DateOfBirth)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="CCCD" Value="@Display(_detail.CitizenId)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Ngày cấp CCCD" Value="@FormatDate(_detail.CitizenIdIssuedDate)" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Nơi cấp CCCD" Value="@Display(_detail.CitizenIdIssuedPlace)" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Địa chỉ" Value="@Display(_detail.Address)" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Khu vực" Value="@Display(_detail.AreaCode)" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Số GPLX" Value="@Display(_detail.DriverLicenseNumber)" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Hạng GPLX" Value="@Display(_detail.DriverLicenseClass)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Ngày cấp GPLX" Value="@FormatDate(_detail.DriverLicenseIssuedDate)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Ngày hết hạn GPLX" Value="@FormatDate(_detail.DriverLicenseExpiryDate)" /></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Chữ ký cố định</MudText>
                <SignaturePad Disabled="true" ExistingSignatureUrl="@_detail.DriverSignatureFileUrl" SignerName="@_detail.FullName" SignedAt="@_detail.DriverSignedAt" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Chữ ký này tự động được chụp vào mỗi hợp đồng mới.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [CascadingParameter(Name = "OpenChangePassword")] private Func<Task>? OpenChangePassword { get; set; }
    private DriverAccountDetailDto? _detail;
    private bool _loading = true;
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        _detail = await Service.GetDetailAsync(userId);
        _loading = false;
    }
    private Task ChangePasswordAsync() => OpenChangePassword?.Invoke() ?? Task.CompletedTask;
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;
    private static string FormatDate(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật";
}
