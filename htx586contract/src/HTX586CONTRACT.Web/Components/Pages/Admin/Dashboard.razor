@page "/admin/dashboard"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Tổng quan công ty</PageTitle>
<PageHeader Title="Tổng quan công ty" Subtitle="Số liệu của đúng tài khoản Admin hiện tại." />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (string.IsNullOrWhiteSpace(_companyName) || !_hasCompanySignature)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Thông tin hoặc chữ ký công ty chưa đầy đủ. <MudLink Href="/admin/company-profile">Cập nhật ngay</MudLink> để tài xế có thể hoàn thành hợp đồng.
        </MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h5">@(_companyName ?? "Chưa cập nhật tên công ty")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Thống kê tháng @((_month ?? DateTime.Today).ToString("MM/yyyy"))</MudText>
            </div>
            <MudSpacer />
            <MudDatePicker Date="_month" DateChanged="ChangeMonthAsync" DateFormat="MM/yyyy" Label="Tháng" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudStack>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Hợp đồng" Value="@_totalContracts.ToString("N0")" Hint="Tạo trong tháng" Icon="@Icons.Material.Filled.Description" Color="Color.Primary" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Đã hoàn thành" Value="@_completedContracts.ToString("N0")" Hint="Đủ 4 chữ ký" Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Success" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Tài xế hoạt động" Value="@_driverCount.ToString("N0")" Hint="Đã duyệt" Icon="@Icons.Material.Filled.Badge" Color="Color.Info" /></MudItem>
        <MudItem xs="12" sm="6" lg="3"><StatCard Title="Xe công ty" Value="@_vehicleCount.ToString("N0")" Hint="Danh mục hiện tại" Icon="@Icons.Material.Filled.DirectionsCar" Color="Color.Warning" /></MudItem>
    </MudGrid>

    <MudGrid Class="mt-2">
        <MudItem xs="12" md="4"><MudButton Href="/admin/company-profile" FullWidth="true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Apartment">Thông tin công ty</MudButton></MudItem>
        <MudItem xs="12" md="4"><MudButton Href="/admin/driver-registrations" FullWidth="true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonAddAlt1">Duyệt tài xế</MudButton></MudItem>
        <MudItem xs="12" md="4"><MudButton Href="/admin/contracts" FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Description">Xem hợp đồng</MudButton></MudItem>
    </MudGrid>
}

@code {
    private string _adminId = string.Empty;
    private string? _companyName;
    private bool _hasCompanySignature;
    private DateTime? _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private int _totalContracts;
    private int _completedContracts;
    private int _driverCount;
    private int _vehicleCount;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _adminId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadAsync();
    }

    private async Task ChangeMonthAsync(DateTime? value)
    {
        _month = value ?? DateTime.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await Factory.CreateDbContextAsync();
        var admin = await db.Users.AsNoTracking().FirstOrDefaultAsync(x => x.Id == _adminId && !x.IsDeleted);
        _companyName = admin is null ? null : string.IsNullOrWhiteSpace(admin.CompanyBranchName)
            ? admin.CompanyName
            : $"{admin.CompanyName} - {admin.CompanyBranchName}";
        _hasCompanySignature = !string.IsNullOrWhiteSpace(admin?.CompanySignatureFileUrl);

        var month = _month ?? DateTime.Today;
        var start = new DateTime(month.Year, month.Month, 1);
        var end = start.AddMonths(1);
        _totalContracts = await db.Contracts.CountAsync(x => x.AdminId == _adminId && x.CreatedAt >= start && x.CreatedAt < end);
        _completedContracts = await db.Contracts.CountAsync(x =>
            x.AdminId == _adminId && x.CreatedAt >= start && x.CreatedAt < end &&
            x.Status == ContractStatus.Completed &&
            x.PdfFileUrl != null && x.PdfFileUrl != "" &&
            x.PdfSha256 != null && x.PdfSha256 != "" &&
            x.PdfGeneratedAt.HasValue);
        _driverCount = await db.Users.CountAsync(x => x.AdminId == _adminId && x.IsActive && !x.IsDeleted && x.RegistrationStatus == "Approved");
        _vehicleCount = await db.Vehicles.CountAsync(x => x.AdminId == _adminId && x.IsActive && !x.IsDeleted);
        _loading = false;
    }
}
