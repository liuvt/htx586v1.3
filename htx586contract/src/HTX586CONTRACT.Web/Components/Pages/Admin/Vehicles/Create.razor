@page "/admin/vehicles/create"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Thêm xe</PageTitle>
<PageHeader Title="Thêm xe" Subtitle="Xe được khởi tạo theo Admin/công ty đang đăng nhập." />
<VehicleForm Model="_model" Saving="_saving" SubmitText="Tạo xe" OnSubmit="SaveAsync" BackUrl="/admin/vehicles" />

@code {
    private string _adminId = string.Empty;
    private bool _saving;
    private VehicleFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _adminId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    }

    private async Task SaveAsync()
    {
        if (!_model.IsValid(out var error)) { Snackbar.Add(error, Severity.Warning); return; }
        try
        {
            _saving = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var admin = await (from user in db.Users.AsNoTracking()
                               join userRole in db.UserRoles.AsNoTracking() on user.Id equals userRole.UserId
                               join role in db.Roles.AsNoTracking() on userRole.RoleId equals role.Id
                               where user.Id == _adminId && role.Name == "Admin" && user.IsActive && !user.IsDeleted
                               select user).FirstOrDefaultAsync()
                ?? throw new InvalidOperationException("Không tìm thấy Admin đang hoạt động.");
            var plate = _model.PlateNumber.Trim().ToUpperInvariant().Replace(" ", string.Empty);
            if (await db.Vehicles.IgnoreQueryFilters().AnyAsync(x => x.PlateNumber == plate))
                throw new InvalidOperationException("Biển số xe đã tồn tại.");
            var vehicle = _model.ToEntity();
            vehicle.PlateNumber = plate;
            vehicle.AdminId = admin.Id;
            vehicle.CreatedBy = _adminId;
            db.Vehicles.Add(vehicle);
            await db.SaveChangesAsync();
            Snackbar.Add("Đã tạo xe.", Severity.Success);
            Navigation.NavigateTo("/admin/vehicles");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }
}
