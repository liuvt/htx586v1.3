@page "/admin/vehicles"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Xe & chủ sở hữu</PageTitle>
<PageHeader Title="Xe & chủ sở hữu" Subtitle="Danh mục xe thuộc tài khoản Admin hiện tại. Dữ liệu này không tự đổ vào hợp đồng; tài xế nhập tay trên từng hợp đồng." />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField @bind-Value="_search" Label="Tìm biển số, mã xe, chủ sở hữu" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    <MudSpacer />
    <MudButton Href="/admin/vehicles/create" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">Thêm xe</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTable T="VehicleRow" Items="FilteredItems" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="20">
        <HeaderContent>
            <MudTh>Biển số</MudTh><MudTh>Mã xe</MudTh><MudTh>Thông tin xe</MudTh><MudTh>Chủ sở hữu</MudTh><MudTh>Trạng thái</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Biển số"><b>@context.PlateNumber</b></MudTd>
            <MudTd DataLabel="Mã xe">@(context.VehicleCode ?? "—")</MudTd>
            <MudTd DataLabel="Thông tin xe">@context.VehicleDescription</MudTd>
            <MudTd DataLabel="Chủ sở hữu">@context.OwnerName</MudTd>
            <MudTd DataLabel="Trạng thái"><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Đang dùng" : "Ngừng dùng")</MudChip></MudTd>
            <MudTd DataLabel="Thao tác">
                <MudIconButton Href="@($"/admin/vehicles/{context.Id}")" Icon="@Icons.Material.Filled.Visibility" />
                <MudIconButton Href="@($"/admin/vehicles/{context.Id}/edit")" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4">Chưa có xe.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="_pageSizeOptions" /></PagerContent>
    </MudTable>
}

@code {
    private static readonly int[] _pageSizeOptions = [10, 20, 50, 100];
    private string _adminId = string.Empty;
    private string? _search;
    private bool _loading = true;
    private List<VehicleRow> _items = [];
    private IEnumerable<VehicleRow> FilteredItems => string.IsNullOrWhiteSpace(_search) ? _items : _items.Where(x =>
        x.PlateNumber.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ||
        (x.VehicleCode?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
        x.OwnerName.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _adminId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var rows = await db.Vehicles.AsNoTracking().Where(x => x.AdminId == _adminId)
            .OrderBy(x => x.PlateNumber)
            .Select(x => new
            {
                x.Id, x.PlateNumber, x.VehicleCode, x.Brand, x.Model, x.VehicleType, x.OwnerName, x.IsActive
            })
            .ToListAsync();
        _items = rows.Select(x => new VehicleRow(
            x.Id, x.PlateNumber, x.VehicleCode,
            string.Join(" ", new[] { x.Brand, x.Model, x.VehicleType }.Where(v => !string.IsNullOrWhiteSpace(v))),
            x.OwnerName, x.IsActive)).ToList();
        _loading = false;
    }

    private async Task DeleteAsync(VehicleRow row)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var vehicle = await db.Vehicles.FirstOrDefaultAsync(x => x.Id == row.Id && x.AdminId == _adminId);
        if (vehicle is null) return;
        vehicle.IsDeleted = true;
        vehicle.DeletedAt = DateTime.UtcNow;
        vehicle.DeletedBy = _adminId;
        vehicle.UpdatedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
        Snackbar.Add("Đã ẩn xe khỏi danh mục.", Severity.Success);
        await LoadAsync();
    }

    private sealed record VehicleRow(Guid Id, string PlateNumber, string? VehicleCode, string VehicleDescription, string OwnerName, bool IsActive);
}
