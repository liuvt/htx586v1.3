@page "/admin/driver-accounts/{UserId}"
@attribute [Authorize(Roles = "Admin")]
@inject IDriverAccountService DriverAccountService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Chi tiết tài xế</PageTitle>
<PageHeader Title="Chi tiết tài xế" Subtitle="Hồ sơ và chữ ký cố định được lưu cùng tài khoản tài xế." />

@if (_loading) { <MudProgressLinear Indeterminate="true" /> }
else if (_item is null)
{
    <MudAlert Severity="Severity.Warning">Không tìm thấy tài xế thuộc công ty của bạn.</MudAlert>
    <MudButton Href="/admin/driver-accounts" Variant="Variant.Text" Class="mt-3">Quay lại</MudButton>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Outlined="true" Class="pa-4">
                <MudGrid>
                    <MudItem xs="12" md="6"><InfoListItem Label="Họ tên" Value="@_item.FullName" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Tên đăng nhập" Value="@_item.UserName" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Điện thoại" Value="@_item.PhoneNumber" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Ngày sinh" Value="@FormatDate(_item.DateOfBirth)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="CCCD" Value="@_item.CitizenId" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Ngày cấp CCCD" Value="@FormatDate(_item.CitizenIdIssuedDate)" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Nơi cấp CCCD" Value="@_item.CitizenIdIssuedPlace" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Địa chỉ" Value="@_item.Address" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Số GPLX" Value="@_item.DriverLicenseNumber" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Hạng GPLX" Value="@_item.DriverLicenseClass" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Ngày cấp GPLX" Value="@FormatDate(_item.DriverLicenseIssuedDate)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Hết hạn GPLX" Value="@FormatDate(_item.DriverLicenseExpiryDate)" /></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Chữ ký cố định</MudText>
                <SignaturePad Disabled="true" ExistingSignatureUrl="@_item.DriverSignatureFileUrl" SignerName="@_item.FullName" SignedAt="@_item.DriverSignedAt" />
            </MudPaper>
        </MudItem>
    </MudGrid>
    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
        <MudButton Href="/admin/driver-accounts" Variant="Variant.Outlined">Quay lại</MudButton>
        <MudButton Href="@($"/admin/driver-accounts/{UserId}/edit")" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit">Cập nhật</MudButton>
    </MudStack>
}

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
    private bool _loading = true;
    private DriverAccountDetailDto? _item;
    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var adminId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        var item = await DriverAccountService.GetDetailAsync(UserId);
        _item = item is not null && item.AdminId == adminId ? item : null;
        _loading = false;
    }
    private static string FormatDate(DateTime? date) => date?.ToString("dd/MM/yyyy") ?? "—";
}
