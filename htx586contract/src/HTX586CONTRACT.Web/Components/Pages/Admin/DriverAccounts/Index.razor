@page "/admin/driver-accounts"
@attribute [Authorize(Roles = "Admin")]
@inject IDriverAccountService DriverAccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar

<PageTitle>Tài xế</PageTitle>
<PageHeader Title="Tài xế" Subtitle="Tài xế thuộc trực tiếp tài khoản Admin hiện tại. Tài xế mới gửi yêu cầu đăng ký và chữ ký cố định." />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField @bind-Value="_search" Label="Tìm họ tên, tài khoản, điện thoại, CCCD" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    <MudSpacer />
    <MudButton Href="/admin/driver-registrations" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAddAlt1">Yêu cầu đăng ký</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTable T="DriverAccountDto" Items="FilteredItems" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="20">
        <HeaderContent>
            <MudTh>Tài xế</MudTh><MudTh>Điện thoại</MudTh><MudTh>GPLX</MudTh><MudTh>Chữ ký</MudTh><MudTh>Trạng thái</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tài xế"><b>@context.FullName</b><br /><span class="text-secondary">@context.UserName</span></MudTd>
            <MudTd DataLabel="Điện thoại">@(context.PhoneNumber ?? "—")</MudTd>
            <MudTd DataLabel="GPLX">@(context.DriverLicenseNumber ?? "—") @(context.DriverLicenseClass)</MudTd>
            <MudTd DataLabel="Chữ ký">
                <MudChip T="string" Size="Size.Small" Color="@(context.HasDriverSignature ? Color.Success : Color.Warning)">@context.DriverSignatureStatusText</MudChip>
            </MudTd>
            <MudTd DataLabel="Trạng thái"><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Hoạt động" : "Đã khóa")</MudChip></MudTd>
            <MudTd DataLabel="Thao tác">
                <MudIconButton Href="@($"/admin/driver-accounts/{context.Id}")" Icon="@Icons.Material.Filled.Visibility" />
                <MudIconButton Href="@($"/admin/driver-accounts/{context.Id}/edit")" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4">Chưa có tài xế.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="_pageSizeOptions" /></PagerContent>
    </MudTable>
}

@code {
    private static readonly int[] _pageSizeOptions = [10, 20, 50, 100];
    private string _adminId = string.Empty;
    private string? _search;
    private bool _loading = true;
    private IReadOnlyList<DriverAccountDto> _items = [];
    private IEnumerable<DriverAccountDto> FilteredItems => string.IsNullOrWhiteSpace(_search) ? _items : _items.Where(x =>
        x.FullName.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ||
        x.UserName.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ||
        (x.PhoneNumber?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
        (x.CitizenId?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _adminId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        _items = await DriverAccountService.GetListAsync(new DriverAccountFilter { AdminId = _adminId, PageSize = 500 });
        _loading = false;
    }
}
