@page "/"
@attribute [Authorize]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Đang chuyển hướng</PageTitle>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authenticationState.User;

        // Route "/" chỉ đóng vai trò cổng điều hướng theo quyền.
        // Ưu tiên Admin để tài khoản quản lý luôn vào đúng dashboard quản trị,
        // kể cả khi tài khoản vô tình có nhiều role.
        if (user.IsInRole("Admin"))
        {
            Navigation.NavigateTo(
                "/admin/dashboard",
                replace: true);
            return;
        }

        if (user.IsInRole("Owner"))
        {
            Navigation.NavigateTo(
                "/owner/dashboard",
                replace: true);
            return;
        }

        if (user.IsInRole("VehicleOwner"))
        {
            Navigation.NavigateTo(
                "/vehicle-owner/dashboard",
                replace: true);
            return;
        }

        // Không hiển thị cảnh báo trung gian tại route gốc.
        // Tài khoản không có role hợp lệ được đưa về trang đăng nhập.
        Navigation.NavigateTo(
            "/account/login",
            forceLoad: true,
            replace: true);
    }
}
