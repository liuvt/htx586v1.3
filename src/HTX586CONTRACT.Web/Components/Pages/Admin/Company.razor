@using HTX586CONTRACT.Domain.Companies
@page "/admin/company"
@attribute [Authorize(Roles = "Admin")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> Factory

<PageTitle>Công ty/Văn phòng</PageTitle>
<PageHeader Title="Công ty/Văn phòng được phân quyền" Subtitle="Một tài khoản Quản lý có thể quản lý nhiều Công ty/Văn phòng; Chủ hệ thống chịu trách nhiệm cập nhật hồ sơ đơn vị." />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_companies.Count == 0)
{
    <MudAlert Severity="Severity.Warning">Tài khoản chưa được phân quyền Công ty/Văn phòng.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var company in _companies)
        {
            <MudItem xs="12" lg="6">
                <MudPaper Class="pa-4 h-100" Elevation="1">
                    <MudText Typo="Typo.h6">@CompanyDisplay(company)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">@company.TaxCode</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6"><InfoListItem Label="Điện thoại" Value="@Display(company.PhoneNumber)" /></MudItem>
                        <MudItem xs="12" md="6"><InfoListItem Label="Email" Value="@Display(company.Email)" /></MudItem>
                        <MudItem xs="12"><InfoListItem Label="Địa chỉ" Value="@company.Address" /></MudItem>
                        <MudItem xs="12" md="6"><InfoListItem Label="Người đại diện" Value="@company.RepresentativeName" /></MudItem>
                        <MudItem xs="12" md="6"><InfoListItem Label="Chức vụ" Value="@Display(company.RepresentativePosition)" /></MudItem>
                        <MudItem xs="12" md="6"><InfoListItem Label="Tài khoản ngân hàng" Value="@Display(company.BankAccountNumber)" /></MudItem>
                        <MudItem xs="12" md="6"><InfoListItem Label="Ngân hàng" Value="@Display(company.BankName)" /></MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<CompanyProfile> _companies = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await using var db = await Factory.CreateDbContextAsync();
        _companies = await db.AdminOffices.AsNoTracking()
            .Where(x => x.AdminUserId == userId && x.IsActive && !x.IsDeleted &&
                        x.CompanyProfile.IsActive && !x.CompanyProfile.IsDeleted)
            .OrderByDescending(x => x.IsPrimary)
            .ThenBy(x => x.CompanyProfile.CompanyName)
            .ThenBy(x => x.CompanyProfile.BranchName)
            .Select(x => x.CompanyProfile)
            .ToListAsync();
        _loading = false;
    }

    private static string CompanyDisplay(CompanyProfile company)
        => string.IsNullOrWhiteSpace(company.BranchName)
            ? company.CompanyName
            : $"{company.CompanyName} - {company.BranchName}";

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
