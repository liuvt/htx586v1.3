@using HTX586CONTRACT.Domain.Companies
@page "/admin/company"
@attribute [Authorize(Roles = "Admin")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> Factory

<PageTitle>Công ty/Văn phòng</PageTitle>
<PageHeader Title="Công ty / Văn phòng"
            Subtitle="Hồ sơ các đơn vị mà tài khoản Quản lý được Owner phân quyền sử dụng.">
    <MudButton Href="/admin/dashboard"
               Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Dashboard">
        Tổng quan
    </MudButton>
    <MudButton Href="/admin/contracts"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Description">
        Hợp đồng
    </MudButton>
</PageHeader>

@if (_loading)
{
    <MudPaper Class="pa-5" Elevation="0" Outlined="true" Style="border-radius:20px;">
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Đang tải hồ sơ Công ty/Văn phòng...</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Hệ thống đang kiểm tra phạm vi đơn vị được Owner phân quyền.</MudText>
    </MudPaper>
}
else if (_companies.Count == 0)
{
    <MudPaper Class="pa-5" Elevation="0" Outlined="true" Style="border-radius:20px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.Apartment" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:700;">Chưa có Công ty/Văn phòng được phân quyền</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Tài khoản Quản lý hiện chưa được gán đơn vị. Vui lòng liên hệ Owner để cập nhật phạm vi quản lý.
                </MudText>
            </div>
        </MudStack>
    </MudPaper>
}
else
{
    <MudPaper Class="admin-company-scope pa-5 mb-4" Elevation="0">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="8">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Style="font-weight:800; letter-spacing:.08em;">PHẠM VI QUẢN LÝ</MudText>
                    </MudStack>
                    <MudText Typo="Typo.h5" Style="font-weight:800;">@_companies.Count Công ty/Văn phòng được phân quyền</MudText>
                    <MudText Typo="Typo.body2" Class="admin-company-scope-copy">
                        Admin được sử dụng thông tin của các đơn vị được Owner gán để quản lý khách hàng và hợp đồng. Hồ sơ pháp lý tại trang này chỉ được xem, không chỉnh sửa.
                    </MudText>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="admin-company-current pa-3" Elevation="0">
                    <MudText Typo="Typo.caption" Class="admin-company-current-label">ĐANG XEM</MudText>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:750;" Class="mt-1">@SelectedCompanyName</MudText>
                    <MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Visibility">Chỉ xem</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_companies.Count đơn vị</MudChip>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="4" lg="3">
            <MudPaper Class="pa-3 admin-company-selector" Elevation="0" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:800; letter-spacing:.06em;">ĐƠN VỊ ĐƯỢC GÁN</MudText>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700;">Chọn Công ty/Văn phòng</MudText>
                    </div>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@_companies.Count</MudChip>
                </MudStack>

                <MudDivider Class="mb-3" />

                <MudStack Spacing="1">
                    @foreach (var assignedCompany in _companies)
                    {
                        var selected = assignedCompany.Id == _selectedCompanyId;
                        <MudButton @key="assignedCompany.Id"
                                   FullWidth="true"
                                   Variant="@(selected ? Variant.Filled : Variant.Text)"
                                   Color="@(selected ? Color.Primary : Color.Default)"
                                   StartIcon="@Icons.Material.Filled.Apartment"
                                   EndIcon="@Icons.Material.Filled.ChevronRight"
                                   OnClick="@(() => SelectCompany(assignedCompany.Id))"
                                   Class="admin-company-select-button"
                                   Style="justify-content:flex-start; text-transform:none; border-radius:12px; padding:11px 12px;">
                            <span class="admin-company-select-copy">
                                <strong>@CompanyDisplay(assignedCompany)</strong>
                                <small>MST: @Display(assignedCompany.TaxCode)</small>
                            </span>
                        </MudButton>
                    }
                </MudStack>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    Việc thêm, xóa hoặc chỉnh sửa hồ sơ đơn vị do tài khoản Owner thực hiện.
                </MudAlert>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8" lg="9">
            @if (SelectedCompany is { } selectedCompany)
            {
                <MudPaper Class="pa-4 mb-3 admin-company-hero" Elevation="0" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled" Class="admin-company-avatar">
                            <MudIcon Icon="@Icons.Material.Filled.Business" />
                        </MudAvatar>

                        <div class="admin-company-title">
                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-1">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(selectedCompany.IsActive ? Color.Success : Color.Warning)"
                                         Variant="Variant.Filled"
                                         Icon="@(selectedCompany.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.PauseCircle)">
                                    @(selectedCompany.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock">Chỉ xem</MudChip>
                            </MudStack>

                            <MudText Typo="Typo.h5" Style="font-weight:800; line-height:1.25;">@CompanyDisplay(selectedCompany)</MudText>
                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-2">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" Class="mr-1" />MST @Display(selectedCompany.TaxCode)
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-1" />@Display(selectedCompany.Address)
                                </MudText>
                            </MudStack>
                        </div>
                    </MudStack>
                </MudPaper>

                <MudGrid Spacing="3">
                    <MudItem xs="12" lg="6">
                        <MudPaper Class="pa-4 h-100 admin-company-card" Elevation="0" Outlined="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Outlined">
                                    <MudIcon Icon="@Icons.Material.Filled.Gavel" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:750;">Thông tin pháp lý</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Dữ liệu sử dụng trên hợp đồng và hồ sơ vận tải.</MudText>
                                </div>
                            </MudStack>
                            <MudDivider Class="mb-3" />

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.Tag" Color="Color.Primary" Size="Size.Small" />
                                        <div><span>Mã số thuế</span><strong>@Display(selectedCompany.TaxCode)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Size="Size.Small" />
                                        <div><span>GPKDVT</span><strong>@Display(selectedCompany.BusinessLicenseNumber)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Size="Size.Small" />
                                        <div><span>Nơi cấp giấy phép</span><strong>@Display(selectedCompany.BusinessLicenseIssuedPlace)</strong></div>
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="6">
                        <MudPaper Class="pa-4 h-100 admin-company-card" Elevation="0" Outlined="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <MudAvatar Size="Size.Medium" Color="Color.Info" Variant="Variant.Outlined">
                                    <MudIcon Icon="@Icons.Material.Filled.ContactPhone" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:750;">Liên hệ & địa chỉ</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Kênh liên hệ chính thức của đơn vị.</MudText>
                                </div>
                            </MudStack>
                            <MudDivider Class="mb-3" />

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.Phone" Color="Color.Info" Size="Size.Small" />
                                        <div><span>Điện thoại</span><strong>@Display(selectedCompany.PhoneNumber)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Info" Size="Size.Small" />
                                        <div><span>Email</span><strong>@Display(selectedCompany.Email)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Info" Size="Size.Small" />
                                        <div><span>Địa chỉ</span><strong>@Display(selectedCompany.Address)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12">
                                    <div class="admin-company-field admin-company-field-accent">
                                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Color="Color.Info" Size="Size.Small" />
                                        <div><span>Liên hệ phản ánh</span><strong>@Display(selectedCompany.ComplaintContact)</strong></div>
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="6">
                        <MudPaper Class="pa-4 h-100 admin-company-card" Elevation="0" Outlined="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <MudAvatar Size="Size.Medium" Color="Color.Secondary" Variant="Variant.Outlined">
                                    <MudIcon Icon="@Icons.Material.Filled.Badge" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:750;">Người đại diện</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Thông tin đại diện pháp lý của Công ty/Văn phòng.</MudText>
                                </div>
                            </MudStack>
                            <MudDivider Class="mb-3" />

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Secondary" Size="Size.Small" />
                                        <div><span>Họ và tên</span><strong>@Display(selectedCompany.RepresentativeName)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.Work" Color="Color.Secondary" Size="Size.Small" />
                                        <div><span>Chức vụ</span><strong>@Display(selectedCompany.RepresentativePosition)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Color="Color.Secondary" Size="Size.Small" />
                                        <div><span>CCCD</span><strong>@Display(selectedCompany.RepresentativeCitizenId)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.Event" Color="Color.Secondary" Size="Size.Small" />
                                        <div><span>Ngày cấp</span><strong>@DateDisplay(selectedCompany.RepresentativeCitizenIdIssuedDate)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Secondary" Size="Size.Small" />
                                        <div><span>Nơi cấp CCCD</span><strong>@Display(selectedCompany.RepresentativeCitizenIdIssuedPlace)</strong></div>
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="6">
                        <MudPaper Class="pa-4 h-100 admin-company-card" Elevation="0" Outlined="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <MudAvatar Size="Size.Medium" Color="Color.Success" Variant="Variant.Outlined">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:750;">Thông tin thanh toán</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tài khoản ngân hàng được khai báo cho đơn vị.</MudText>
                                </div>
                            </MudStack>
                            <MudDivider Class="mb-3" />

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Color="Color.Success" Size="Size.Small" />
                                        <div><span>Số tài khoản</span><strong>@Display(selectedCompany.BankAccountNumber)</strong></div>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <div class="admin-company-field">
                                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Success" Size="Size.Small" />
                                        <div><span>Ngân hàng</span><strong>@Display(selectedCompany.BankName)</strong></div>
                                    </div>
                                </MudItem>
                            </MudGrid>

                            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-3">
                                Cập nhật hồ sơ gần nhất: <strong>@LastUpdatedText(selectedCompany)</strong>
                            </MudAlert>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </MudItem>
    </MudGrid>
}

<style>
    .admin-company-scope {
        border-radius: 22px;
        color: #fff;
        background: linear-gradient(125deg, #075c50 0%, #087b69 58%, #11947d 100%);
        box-shadow: 0 14px 34px rgba(7, 92, 80, .16);
    }

    .admin-company-scope-copy {
        max-width: 820px;
        color: rgba(255, 255, 255, .78) !important;
        line-height: 1.65;
    }

    .admin-company-current {
        height: 100%;
        min-height: 112px;
        border: 1px solid rgba(255, 255, 255, .18);
        border-radius: 16px;
        color: #fff;
        background: rgba(255, 255, 255, .10);
    }

    .admin-company-current-label {
        color: rgba(255, 255, 255, .62) !important;
        font-weight: 800;
        letter-spacing: .08em;
    }

    .admin-company-selector,
    .admin-company-hero,
    .admin-company-card {
        border-radius: 18px;
        border-color: rgba(15, 23, 42, .09) !important;
        background: #fff;
    }

    .admin-company-selector {
        position: sticky;
        top: 84px;
    }

    .admin-company-select-button .mud-button-label {
        width: 100%;
        min-width: 0;
        justify-content: flex-start;
        text-align: left;
    }

    .admin-company-select-copy {
        display: block;
        min-width: 0;
        flex: 1 1 auto;
        overflow: hidden;
        text-align: left;
    }

    .admin-company-select-copy strong,
    .admin-company-select-copy small {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .admin-company-select-copy strong {
        font-size: .76rem;
        font-weight: 750;
    }

    .admin-company-select-copy small {
        margin-top: 2px;
        opacity: .72;
        font-size: .64rem;
    }

    .admin-company-avatar {
        box-shadow: 0 10px 22px rgba(8, 123, 105, .17);
    }

    .admin-company-title {
        min-width: 0;
        flex: 1 1 520px;
    }

    .admin-company-card {
        min-height: 100%;
    }

    .admin-company-field {
        display: flex;
        min-height: 70px;
        align-items: flex-start;
        gap: 11px;
        padding: 11px 12px;
        border: 1px solid rgba(15, 23, 42, .07);
        border-radius: 13px;
        background: #fafcfb;
    }

    .admin-company-field > div {
        min-width: 0;
    }

    .admin-company-field span,
    .admin-company-field strong {
        display: block;
    }

    .admin-company-field span {
        margin-bottom: 3px;
        color: #7b8984;
        font-size: .68rem;
        font-weight: 650;
    }

    .admin-company-field strong {
        color: #24322e;
        font-size: .82rem;
        font-weight: 720;
        line-height: 1.45;
        word-break: break-word;
    }

    .admin-company-field-accent {
        border-color: rgba(3, 169, 244, .18);
        background: rgba(3, 169, 244, .035);
    }

    @@media (max-width: 959px) {
        .admin-company-selector {
            position: static;
        }
    }

    @@media (max-width: 599px) {
        .admin-company-scope {
            padding: 18px !important;
            border-radius: 18px;
        }

        .admin-company-selector,
        .admin-company-hero,
        .admin-company-card {
            border-radius: 15px;
        }

        .admin-company-field {
            min-height: auto;
        }
    }
</style>

@code {
    private List<CompanyProfile> _companies = [];
    private Guid? _selectedCompanyId;
    private bool _loading = true;

    private CompanyProfile? SelectedCompany
        => _selectedCompanyId is null
            ? null
            : _companies.FirstOrDefault(x => x.Id == _selectedCompanyId.Value);

    private string SelectedCompanyName
        => SelectedCompany is null ? "—" : CompanyDisplay(SelectedCompany);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

            await using var db = await Factory.CreateDbContextAsync();
            _companies = await db.AdminOffices.AsNoTracking()
                .Where(x => x.AdminUserId == userId && x.IsActive && !x.IsDeleted &&
                            x.CompanyProfile.IsActive && !x.CompanyProfile.IsDeleted)
                .OrderByDescending(x => x.IsPrimary)
                .ThenBy(x => x.CompanyProfile.CompanyName)
                .ThenBy(x => x.CompanyProfile.BranchName)
                .Select(x => x.CompanyProfile)
                .ToListAsync();

            _selectedCompanyId = _companies.FirstOrDefault()?.Id;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectCompany(Guid companyId)
    {
        if (_companies.Any(x => x.Id == companyId))
        {
            _selectedCompanyId = companyId;
        }
    }

    private static string CompanyDisplay(CompanyProfile company)
        => string.IsNullOrWhiteSpace(company.BranchName)
            ? company.CompanyName
            : $"{company.CompanyName} - {company.BranchName}";

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static string DateDisplay(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "—";

    private static string LastUpdatedText(CompanyProfile company)
    {
        var value = company.UpdatedAt ?? company.CreatedAt;
        return value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }
}
