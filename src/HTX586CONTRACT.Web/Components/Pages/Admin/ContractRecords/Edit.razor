@page "/admin/contracts/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]
@inject IContractService ContractService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Chi tiết hợp đồng</PageTitle>
<PageHeader Title="Chi tiết hợp đồng" Subtitle="Dữ liệu snapshot do tài xế nhập và ký trên từng hợp đồng." />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Warning">Không tìm thấy hợp đồng hoặc hợp đồng không thuộc công ty của bạn.</MudAlert>
    <MudButton Href="/admin/contracts" Variant="Variant.Text" Class="mt-3">Quay lại</MudButton>
}
else
{
    <ContractHistoryView Detail="_detail" BackUrl="/admin/contracts" />
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool _loading = true;
    private ContractDetailDto? _detail;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var adminId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        var detail = await ContractService.GetByIdAsync(Id);
        _detail = detail is not null && string.Equals(detail.AdminId, adminId, StringComparison.Ordinal)
            ? detail
            : null;
        _loading = false;
    }
}
