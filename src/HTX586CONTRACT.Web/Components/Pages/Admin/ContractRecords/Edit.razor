        => SelectedCompany?.RepresentativeSignedAt;

    private string? FixedOwnerSignatureUrl
        => Id.HasValue
            ? _detail?.VehicleOwnerSignatureFileUrl ?? SelectedVehicle?.OwnerSignatureFileUrl
            : SelectedVehicle?.OwnerSignatureFileUrl;

    private DateTime? FixedOwnerSignedAt
        => Id.HasValue
            ? _detail?.VehicleOwnerSignedAt ?? SelectedVehicle?.OwnerSignedAt
            : SelectedVehicle?.OwnerSignedAt;

    private string? FixedDriverSignatureUrl
        => SelectedVehicle?.AccountDriverSignatureFileUrl;

    private DateTime? FixedDriverSignedAt
