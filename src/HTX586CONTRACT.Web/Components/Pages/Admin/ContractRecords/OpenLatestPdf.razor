@namespace HTX586CONTRACT.Web.Components.Pages.Admin.ContractRecords
@page "/admin/contracts/{Id:guid}/pdf/latest"
@attribute [Authorize(Roles = "Admin")]
@inject IContractDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject NavigationManager Navigation

<PageTitle>Đang mở PDF hợp đồng</PageTitle>

<MudPaper Class="pa-6 mx-auto mt-8" Outlined="true" Style="max-width:640px">
    @if (string.IsNullOrWhiteSpace(_error))
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Đang lấy PDF đồng bộ mới nhất...</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Hệ thống sẽ ưu tiên bản PDF đồng bộ mới nhất theo layout hiện tại và không ghi đè PDF chính thức.
            </MudText>
        </MudStack>
    }
    else
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
        <MudButton Class="mt-4" Variant="Variant.Outlined" Href="/admin/contracts">Quay lại danh sách hợp đồng</MudButton>
    }
</MudPaper>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _started;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
            return;

        _started = true;
        await OpenLatestPdfAsync();
    }

    private async Task OpenLatestPdfAsync()
    {
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(currentUserId))
                throw new UnauthorizedAccessException("Không xác định được tài khoản đang đăng nhập.");

            await using var db = await Factory.CreateDbContextAsync();
            var companyProfileId = await db.Contracts.AsNoTracking()
                .Where(x => x.Id == Id && !x.IsDeleted)
                .Select(x => (Guid?)x.CompanyProfileId)
                .FirstOrDefaultAsync();

            if (!companyProfileId.HasValue)
                throw new KeyNotFoundException("Không tìm thấy hợp đồng.");

            var allowed = await db.AdminOffices.AsNoTracking()
                .AnyAsync(x => x.AdminUserId == currentUserId &&
                               x.CompanyProfileId == companyProfileId.Value &&
                               x.IsActive && !x.IsDeleted &&
                               x.CompanyProfile.IsActive && !x.CompanyProfile.IsDeleted);

            if (!allowed)
                throw new UnauthorizedAccessException("Bạn không có quyền mở PDF của hợp đồng này.");

            var url = await DocumentService.GeneratePdfAsync(Id);
            Navigation.NavigateTo(url, forceLoad: true, replace: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }
}
