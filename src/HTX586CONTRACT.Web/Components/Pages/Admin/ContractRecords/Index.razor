@namespace HTX586CONTRACT.Web.Components.Pages.Admin.ContractRecords
@page "/admin/contracts"
@attribute [Authorize(Roles = "Admin")]
@inject IContractService ContractService
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> Factory

<PageTitle>Hợp đồng</PageTitle>
<PageHeader Title="Hợp đồng" Subtitle="Tài khoản Quản lý quản lý hợp đồng thuộc Công ty/Văn phòng được phân quyền." />

@if (_managedCompanyProfileIds.Count == 0 && !_loading)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
        Tài khoản Quản lý chưa được phân quyền Công ty/Văn phòng nên chưa thể quản lý hợp đồng.
    </MudAlert>
}

<MudPaper Class="pa-4" Outlined="true">
    <MudStack Row="true" Spacing="2" Class="mb-4">
        <MudTextField @bind-Value="_search"
                      Label="Tìm số hợp đồng, khách hàng, biển số"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" />
        <MudSelect T="Guid?" @bind-Value="_selectedCompanyProfileId" Label="Công ty/Văn phòng" Variant="Variant.Outlined" Clearable="true">
            @foreach (var company in _companies)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)company.Id)">@CompanyDisplay(company)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="ContractStatus?" @bind-Value="_status" Label="Trạng thái" Variant="Variant.Outlined" Clearable="true">
            @foreach (var status in Enum.GetValues<ContractStatus>().Distinct())
            {
                <MudSelectItem T="ContractStatus?" Value="@status">@StatusText(status)</MudSelectItem>
            }
        </MudSelect>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadAsync">Lọc</MudButton>
        <MudSpacer />
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/admin/contracts/create"
                   Disabled="@(_managedCompanyProfileIds.Count == 0)">
            Tạo hợp đồng
        </MudButton>
    </MudStack>

    <MudTable Items="_items" Hover="true" Dense="true" Loading="_loading" RowsPerPage="20">
        <HeaderContent>
            <MudTh>Số hợp đồng</MudTh>
            <MudTh>Khách hàng</MudTh>
            <MudTh>Chủ xe</MudTh>
            <MudTh>Biển số</MudTh>
            <MudTh>Khởi hành</MudTh>
            <MudTh>Giá trị</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Số hợp đồng">
                <MudLink Href="@($"/admin/contracts/{context.Id}")">@context.ContractNumber</MudLink>
            </MudTd>
            <MudTd DataLabel="Khách hàng">@context.CustomerName</MudTd>
            <MudTd DataLabel="Chủ xe">@context.DriverName</MudTd>
            <MudTd DataLabel="Biển số">@context.VehiclePlate</MudTd>
            <MudTd DataLabel="Khởi hành">@context.StartTime?.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Giá trị">@context.ContractValue?.ToString("N0")</MudTd>
            <MudTd DataLabel="Trạng thái"><ContractStatusChip Status="context.Status" /></MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Href="@($"/admin/contracts/{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Color="Color.Warning" OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>Chưa có hợp đồng.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="_pageSizeOptions" /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private static readonly int[] _pageSizeOptions = [10, 20, 50, 100];
    private List<ContractListItemDto> _items = [];
    private string? _search;
    private ContractStatus? _status;
    private bool _loading = true;
    private string _currentUserId = string.Empty;
    private HashSet<Guid> _managedCompanyProfileIds = [];
    private List<CompanyProfile> _companies = [];
    private Guid? _selectedCompanyProfileId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        await using var db = await Factory.CreateDbContextAsync();
        _managedCompanyProfileIds = await db.AdminOffices.AsNoTracking()
            .Where(x => x.AdminUserId == _currentUserId && x.IsActive && !x.IsDeleted &&
                        x.CompanyProfile.IsActive && !x.CompanyProfile.IsDeleted)
            .Select(x => x.CompanyProfileId)
            .ToHashSetAsync();
        _companies = await db.CompanyProfiles.AsNoTracking()
            .Where(x => _managedCompanyProfileIds.Contains(x.Id) && x.IsActive && !x.IsDeleted)
            .OrderBy(x => x.CompanyName)
            .ThenBy(x => x.BranchName)
            .ToListAsync();
        _selectedCompanyProfileId = _companies.Count == 1 ? _companies[0].Id : null;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            if (_managedCompanyProfileIds.Count == 0)
            {
                _items = [];
                return;
            }

            IEnumerable<Guid> officeIds = _selectedCompanyProfileId.HasValue
                ? new[] { _selectedCompanyProfileId.Value }
                : _managedCompanyProfileIds;
            var rows = new List<ContractListItemDto>();
            foreach (var officeId in officeIds)
            {
                rows.AddRange(await ContractService.GetAsync(new ContractFilter
                {
                    Search = _search,
                    Status = _status,
                    CompanyProfileId = officeId
                }));
            }
            _items = rows
                .GroupBy(x => x.Id)
                .Select(x => x.First())
                .OrderByDescending(x => x.CreatedAt)
                .ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteAsync(ContractListItemDto item)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync(
            "Ẩn hợp đồng",
            $"Ẩn hợp đồng {item.ContractNumber} khỏi danh sách? Dữ liệu vẫn được giữ nguyên trong database và không bị xóa vật lý.",
            yesText: "Ẩn khỏi giao diện",
            cancelText: "Hủy");

        if (confirmed != true)
            return;

        var hidden = await ContractService.DeleteAsync(item.Id, _currentUserId);
        if (!hidden)
        {
            Snackbar.Add("Không thể ẩn hợp đồng ở trạng thái hiện tại hoặc bạn không có quyền thao tác.", Severity.Warning);
            return;
        }

        Snackbar.Add("Đã ẩn hợp đồng khỏi giao diện. Dữ liệu gốc vẫn còn trong database.", Severity.Success);
        await LoadAsync();
    }

    private static string CompanyDisplay(CompanyProfile company)
        => string.IsNullOrWhiteSpace(company.BranchName)
            ? company.CompanyName
            : $"{company.CompanyName} - {company.BranchName}";

    private static string StatusText(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "Đã tạo",
        ContractStatus.WaitingCustomerSignature => "Đã phát - chờ nhận",
        ContractStatus.CustomerSigned => "Khách đã ký",
        ContractStatus.WaitingDriverConfirmation => "Đã nhận - đang xử lý",
        ContractStatus.Completed => "Hoàn tất",
        ContractStatus.Cancelled => "Đã hủy",
        ContractStatus.Expired => "Hết hạn",
        _ => "Vô hiệu"
    };
}
