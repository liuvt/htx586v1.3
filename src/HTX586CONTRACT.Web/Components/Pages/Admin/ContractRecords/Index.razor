@page "/admin/contracts"
@attribute [Authorize(Roles = "Admin")]
@inject IContractService ContractService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Hợp đồng</PageTitle>
<PageHeader Title="Hợp đồng" Subtitle="Theo dõi các hợp đồng do tài xế thuộc công ty tạo. Admin chỉ xem, không chỉnh sửa dữ liệu hợp đồng." />

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudGrid AlignItems="AlignItems.End">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_search" Label="Tìm số hợp đồng, khách hàng, biển số" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="ContractStatus?" @bind-Value="_status" Label="Trạng thái" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var status in Enum.GetValues<ContractStatus>())
                {
                    <MudSelectItem T="ContractStatus?" Value="@status">@StatusName(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2"><MudDatePicker @bind-Date="_fromDate" Label="Từ ngày" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="6" md="2"><MudDatePicker @bind-Date="_toDate" Label="Đến ngày" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="1">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Disabled="@_loading" OnClick="LoadAsync">
                <MudIcon Icon="@Icons.Material.Filled.Search" />
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTable T="ContractListItemDto" Items="_items" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="20">
        <HeaderContent>
            <MudTh>Số HĐ</MudTh>
            <MudTh>Ngày tạo</MudTh>
            <MudTh>Tài xế</MudTh>
            <MudTh>Khách hàng</MudTh>
            <MudTh>Xe</MudTh>
            <MudTh>Giá trị</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Số HĐ"><b>@context.ContractNumber</b></MudTd>
            <MudTd DataLabel="Ngày tạo">@context.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Tài xế">@context.DriverName</MudTd>
            <MudTd DataLabel="Khách hàng">@context.CustomerName</MudTd>
            <MudTd DataLabel="Xe">@(context.VehiclePlate ?? "—")</MudTd>
            <MudTd DataLabel="Giá trị">@(context.ContractValue?.ToString("N0") ?? "—")</MudTd>
            <MudTd DataLabel="Trạng thái"><ContractStatusChip Status="context.Status" /></MudTd>
            <MudTd DataLabel="Thao tác">
                <MudIconButton Href="@($"/admin/contracts/{context.Id}")" Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4">Chưa có hợp đồng phù hợp.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="_pageSizeOptions" /></PagerContent>
    </MudTable>
}

@code {
    private static readonly int[] _pageSizeOptions = [10, 20, 50, 100];
    private string _adminId = string.Empty;
    private string? _search;
    private ContractStatus? _status;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _loading = true;
    private IReadOnlyList<ContractListItemDto> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _adminId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await ContractService.GetAsync(new ContractFilter
            {
                AdminId = _adminId,
                Search = _search,
                Status = _status,
                FromDate = _fromDate,
                ToDate = _toDate
            });
        }
        finally { _loading = false; }
    }

    private static string StatusName(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "Lưu tạm",
        ContractStatus.WaitingCustomerSignature => "Đang ký",
        ContractStatus.Completed => "Hoàn thành",
        ContractStatus.Cancelled => "Đã hủy",
        ContractStatus.Expired => "Hết hạn",
        ContractStatus.Invalidated => "Vô hiệu",
        _ => status.ToString()
    };
}
