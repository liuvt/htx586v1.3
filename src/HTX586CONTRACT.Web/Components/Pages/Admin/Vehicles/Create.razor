@page "/admin/vehicles/create"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject IOfficeAccessService OfficeAccessService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Thêm xe</PageTitle>
<PageHeader Title="Thêm xe" Subtitle="Chọn đúng một Công ty/Văn phòng. Chủ xe có thể để trống và gán sau." />

<MudStack Spacing="3">
    <MudPaper Class="ent-section-card" Elevation="0">
        <div class="ent-section-header">
            <div class="ent-section-header__left">
                <div class="ent-section-icon"><MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" /></div>
                <div>
                    <MudText Class="ent-section-title">1. Phân công Đơn vị vận hành &amp; Chủ sở hữu xe</MudText>
                    <MudText Class="ent-section-subtitle">Chọn Công ty/Văn phòng quản lý và gán tài khoản Chủ xe (hoặc để trống và gán sau).</MudText>
                </div>
            </div>
            <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Success" Label="Phương tiện đang hoạt động" />
        </div>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudSelect T="Guid?" @bind-Value="_officeId" Label="Công ty/Văn phòng hoạt động" Required="true"
                           Variant="Variant.Outlined" HelperText="Mỗi xe chỉ thuộc đúng một Công ty/Văn phòng.">
                    @foreach (var office in _offices)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)office.Id)">@OfficeDisplay(office)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="ApplicationUser"
                                 Value="@SelectedVehicleOwner"
                                 ValueChanged="SelectVehicleOwner"
                                 SearchFunc="SearchVehicleOwnersAsync"
                                 ToStringFunc="UserDisplay"
                                 Label="Tài khoản Chủ xe (không bắt buộc)"
                                 Placeholder="Gõ họ tên hoặc số điện thoại Chủ xe"
                                 HelperText="Gõ họ tên hoặc số điện thoại để tìm; có thể để trống và gán Chủ xe sau."
                                 Variant="Variant.Outlined"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 MinCharacters="1"
                                 DebounceInterval="300"
                                 MaxItems="30" />
            </MudItem>

            @if (SelectedVehicleOwner is not null)
            {
                <MudItem xs="12">
                    <MudGrid Spacing="2" Class="mt-1">
                        <MudItem xs="12" sm="6" md="4"><InfoListItem Label="Họ tên Chủ xe" Value="@SelectedVehicleOwner.FullName" Icon="@Icons.Material.Filled.Person" /></MudItem>
                        <MudItem xs="12" sm="6" md="4"><InfoListItem Label="Số điện thoại" Value="@Display(SelectedVehicleOwner.PhoneNumber)" Icon="@Icons.Material.Filled.Phone" /></MudItem>
                        <MudItem xs="12" sm="6" md="4"><InfoListItem Label="Số CCCD" Value="@Display(SelectedVehicleOwner.CitizenId)" Icon="@Icons.Material.Filled.CreditCard" /></MudItem>
                        <MudItem xs="12" sm="6" md="4"><InfoListItem Label="Ngày cấp CCCD" Value="@DateText(SelectedVehicleOwner.CitizenIdIssuedDate)" Icon="@Icons.Material.Filled.Event" /></MudItem>
                        <MudItem xs="12" sm="6" md="4"><InfoListItem Label="Nơi cấp CCCD" Value="@Display(SelectedVehicleOwner.CitizenIdIssuedPlace)" Icon="@Icons.Material.Filled.AccountBalance" /></MudItem>
                        <MudItem xs="12" sm="6" md="4"><InfoListItem Label="Địa chỉ Chủ xe" Value="@Display(SelectedVehicleOwner.Address)" Icon="@Icons.Material.Filled.LocationOn" /></MudItem>
                    </MudGrid>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Xe đang được khởi tạo chưa có Chủ xe. Bạn có thể gán tài khoản Chủ xe ở màn hình cập nhật xe sau này.
                    </MudAlert>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudPaper Class="ent-section-card" Elevation="0">
        <div class="ent-section-header">
            <div class="ent-section-header__left">
                <div class="ent-section-icon"><MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Small" /></div>
                <div>
                    <MudText Class="ent-section-title">2. Thông tin nhận diện &amp; Thông số kỹ thuật phương tiện</MudText>
                    <MudText Class="ent-section-subtitle">Biển kiểm soát, số phù hiệu vận tải (dùng làm tiền tố sinh số HĐ) và thông số đăng kiểm.</MudText>
                </div>
            </div>
        </div>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_model.PlateNumber" Label="Biển kiểm soát" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_model.PermitNumber" Label="Số phù hiệu vận tải" Required="true" Variant="Variant.Outlined" HelperText="Dùng làm tiền tố số hợp đồng khi hoàn tất." /></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_model.VehicleCode" Label="Mã phương tiện nội bộ" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.VehicleType" Label="Loại phương tiện" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.Brand" Label="Nhãn hiệu (Hãng xe)" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.Model" Label="Dòng xe (Model)" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><MudNumericField T="int?" @bind-Value="_model.SeatCount" Label="Số chỗ ngồi" Min="1" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_model.Color" Label="Màu sơn" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_model.ChassisNumber" Label="Số khung (VIN)" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6" md="4"><MudTextField @bind-Value="_model.EngineNumber" Label="Số máy" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="ent-action-bar" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/admin/vehicles"))">Quay lại danh sách</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Disabled="_saving" OnClick="SaveAsync">
                @(_saving ? "Đang lưu..." : "Lưu phương tiện")
            </MudButton>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private Vehicle _model = new() { Id = Guid.NewGuid(), IsActive = true };
    private Guid? _officeId;
    private List<CompanyProfile> _offices = [];
    private ApplicationUser? _selectedVehicleOwner;
    private string _currentUserId = string.Empty;
    private bool _isOwner;
    private bool _saving;
    private ApplicationUser? SelectedVehicleOwner => _selectedVehicleOwner;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        _isOwner = auth.User.IsInRole("Owner");
        await using var db = await Factory.CreateDbContextAsync();
        var managedIds = await OfficeAccessService.GetManagedOfficeIdsAsync(_currentUserId, _isOwner);
        _offices = await db.CompanyProfiles.AsNoTracking()
            .Where(x => managedIds.Contains(x.Id) && x.IsActive && !x.IsDeleted)
            .OrderBy(x => x.CompanyName).ThenBy(x => x.BranchName)
            .ToListAsync();
        if (_offices.Count == 1)
            _officeId = _offices[0].Id;
    }

    private async Task SaveAsync()
    {
        if (!_officeId.HasValue)
        {
            Snackbar.Add("Vui lòng chọn Công ty/Văn phòng cho xe.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.PlateNumber))
        {
            Snackbar.Add("Vui lòng nhập biển số xe.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.PermitNumber))
        {
            Snackbar.Add("Vui lòng nhập số phù hiệu xe.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            var managedIds = await OfficeAccessService.GetManagedOfficeIdsAsync(_currentUserId, _isOwner);
            if (!managedIds.Contains(_officeId.Value))
                throw new InvalidOperationException("Công ty/Văn phòng nằm ngoài phạm vi quản lý.");

            ApplicationUser? validOwner = null;
            if (!string.IsNullOrWhiteSpace(_model.AssignedDriverId))
            {
                validOwner = await FindValidVehicleOwnerAsync(db, _model.AssignedDriverId);
                if (validOwner is null)
                    throw new InvalidOperationException("Tài khoản Chủ xe không hợp lệ, đã khóa hoặc chưa được duyệt.");
            }

            _model.PlateNumber = _model.PlateNumber.Trim().ToUpperInvariant();
            _model.PermitNumber = _model.PermitNumber.Trim();
            if (await db.Vehicles.IgnoreQueryFilters().AnyAsync(x => !x.IsDeleted && x.PlateNumber == _model.PlateNumber))
                throw new InvalidOperationException("Biển số xe đã tồn tại.");
            if (await db.Vehicles.IgnoreQueryFilters().AnyAsync(x => !x.IsDeleted && x.PermitNumber == _model.PermitNumber))
                throw new InvalidOperationException("Số phù hiệu xe đã tồn tại trên một xe khác.");

            if (validOwner is not null)
                ApplyOwnerSnapshot(_model, validOwner);
            else
                ClearOwnerSnapshot(_model);

            var now = DateTime.UtcNow;
            _model.CreatedAt = now;
            _model.CreatedBy = _currentUserId;
            db.Vehicles.Add(_model);
            db.OfficeVehicles.Add(new HTX586CONTRACT.Domain.Offices.OfficeVehicle
            {
                VehicleId = _model.Id,
                CompanyProfileId = _officeId.Value,
                IsPrimary = true,
                IsActive = true,
                AssignedFrom = now,
                CreatedAt = now,
                CreatedBy = _currentUserId
            });

            if (validOwner is not null)
            {
                db.DriverNotifications.Add(new DriverNotification
                {
                    DriverId = validOwner.Id,
                    Type = "VehicleAssigned",
                    Title = "Bạn được gán phương tiện",
                    Message = $"Phương tiện {_model.PlateNumber} đã được gán cho tài khoản Chủ xe của bạn.",
                    LinkUrl = "/vehicle-owner/vehicles",
                    RelatedVehicleId = _model.Id,
                    CreatedAt = now
                });
            }

            await db.SaveChangesAsync();
            Snackbar.Add(validOwner is null
                ? "Đã tạo xe chưa gán Chủ xe và liên kết với Công ty/Văn phòng."
                : "Đã tạo xe, gán Chủ xe và Công ty/Văn phòng.", Severity.Success);
            Navigation.NavigateTo($"/admin/vehicles/{_model.Id}/edit");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task<IEnumerable<ApplicationUser>> SearchVehicleOwnersAsync(string? value, CancellationToken cancellationToken)
    {
        var search = value?.Trim();
        if (string.IsNullOrWhiteSpace(search))
            return Enumerable.Empty<ApplicationUser>();

        await using var db = await Factory.CreateDbContextAsync(cancellationToken);
        var query = from user in db.Users.AsNoTracking()
                    join userRole in db.UserRoles.AsNoTracking() on user.Id equals userRole.UserId
                    join role in db.Roles.AsNoTracking() on userRole.RoleId equals role.Id
                    where role.Name == SystemRoleDisplay.VehicleOwnerRole
                          && user.IsActive
                          && !user.IsDeleted
                          && user.RegistrationStatus == "Approved"
                          && (user.FullName.Contains(search) ||
                              (user.PhoneNumber != null && user.PhoneNumber.Contains(search)))
                    orderby user.FullName, user.PhoneNumber
                    select user;

        return await query.Take(30).ToListAsync(cancellationToken);
    }

    private Task SelectVehicleOwner(ApplicationUser? owner)
    {
        _selectedVehicleOwner = owner;
        _model.AssignedDriverId = owner?.Id;
        return Task.CompletedTask;
    }

    private static async Task<ApplicationUser?> FindValidVehicleOwnerAsync(ApplicationDbContext db, string userId)
    {
        var hasRole = await (from ur in db.UserRoles.AsNoTracking()
                             join r in db.Roles.AsNoTracking() on ur.RoleId equals r.Id
                             where ur.UserId == userId && r.Name == SystemRoleDisplay.VehicleOwnerRole
                             select ur.UserId).AnyAsync();
        if (!hasRole) return null;
        return await db.Users.FirstOrDefaultAsync(x => x.Id == userId && x.IsActive && !x.IsDeleted && x.RegistrationStatus == "Approved");
    }

    private static void ApplyOwnerSnapshot(Vehicle vehicle, ApplicationUser owner)
    {
        vehicle.AssignedDriverId = owner.Id;
        vehicle.OwnerName = owner.FullName.Trim();
        vehicle.OwnerPhoneNumber = N(owner.PhoneNumber);
        vehicle.OwnerCitizenId = N(owner.CitizenId);
        vehicle.OwnerCitizenIdIssuedDate = owner.CitizenIdIssuedDate?.Date;
        vehicle.OwnerCitizenIdIssuedPlace = N(owner.CitizenIdIssuedPlace);
        vehicle.OwnerAddress = N(owner.Address);
    }

    private static void ClearOwnerSnapshot(Vehicle vehicle)
    {
        vehicle.AssignedDriverId = null;
        vehicle.OwnerName = string.Empty;
        vehicle.OwnerPhoneNumber = null;
        vehicle.OwnerCitizenId = null;
        vehicle.OwnerCitizenIdIssuedDate = null;
        vehicle.OwnerCitizenIdIssuedPlace = null;
        vehicle.OwnerAddress = null;
    }


    private static string OfficeDisplay(CompanyProfile x) => string.IsNullOrWhiteSpace(x.BranchName) ? x.CompanyName : $"{x.CompanyName} - {x.BranchName}";
    private static string? UserDisplay(ApplicationUser? x) => x is null ? null : $"{x.FullName} - {Display(x.PhoneNumber)}";
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DateText(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "—";
    private static string? N(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
