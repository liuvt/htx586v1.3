@page "/admin/vehicles"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject IOfficeAccessService OfficeAccessService
@inject VehicleExcelImportService VehicleImportService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Xe</PageTitle>
<PageHeader Title="Quản lý xe" Subtitle="Mỗi xe thuộc đúng một Công ty/Văn phòng; tài khoản Chủ xe có thể để trống và gán sau." />

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudTextField T="string" @bind-Value="_keyword" Placeholder="Tìm biển số, số phù hiệu, Chủ xe, tài khoản, văn phòng..."
                          Immediate="true" Clearable="true" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="7">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                <MudButton Href="/templates/Template_Import_Vehicle_HTX586.xlsx" download="Template_Import_Vehicle_HTX586.xlsx"
                           Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                           Disabled="@(_readingImportFile || _importing)">Tải mẫu</MudButton>
                <MudFileUpload @ref="_fileUpload" T="IBrowserFile"
                               Accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                               FilesChanged="ReadImportFileAsync" MaximumFileCount="1"
                               Disabled="@(_readingImportFile || _importing)">
                    <CustomContent Context="upload">
                        <MudButton Color="Color.Success" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                                   Disabled="@(_readingImportFile || _importing)" OnClick="@upload.OpenFilePickerAsync">
                            @(_readingImportFile ? "Đang đọc..." : "Import Excel")
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(_readingImportFile || _importing)"
                           OnClick="@(() => Navigation.NavigateTo("/admin/vehicles/create"))">Thêm xe</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_importPreview is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <div><MudText Typo="Typo.h6">Kiểm tra import xe</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@_importPreview.FileName</MudText></div>
            <MudSpacer /><MudIconButton Icon="@Icons.Material.Filled.Close" Disabled="_importing" OnClick="CancelImport" />
        </MudStack>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Tổng @_importPreview.TotalRows</MudChip>
            <MudChip T="string" Color="Color.Success">Hợp lệ @_importPreview.ValidRows</MudChip>
            <MudChip T="string" Color="@(_importPreview.InvalidRows > 0 ? Color.Error : Color.Default)" Variant="Variant.Outlined">Lỗi @_importPreview.InvalidRows</MudChip>
        </MudStack>
        <MudAlert Severity="@(_importPreview.InvalidRows > 0 ? Severity.Warning : Severity.Success)" Variant="Variant.Outlined" Class="mb-3">
            @(_importPreview.InvalidRows > 0 ? "Chỉ các dòng hợp lệ được import. Chủ xe là tùy chọn; mỗi xe chỉ được gán một Công ty/Văn phòng." : "Toàn bộ dữ liệu hợp lệ, có thể xác nhận import.")
        </MudAlert>
        <MudTable T="VehicleImportRowPreview" Items="_importPreview.Rows" Dense="true" Hover="true" Striped="true" RowsPerPage="10" Loading="_importing">
            <HeaderContent><MudTh>Dòng</MudTh><MudTh>Biển số</MudTh><MudTh>Số phù hiệu</MudTh><MudTh>Tài khoản Chủ xe</MudTh><MudTh>Công ty/Văn phòng</MudTh><MudTh>Loại xe</MudTh><MudTh>Số chỗ</MudTh><MudTh>Trạng thái</MudTh><MudTh>Lỗi</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@context.RowNumber</MudTd><MudTd><b>@context.PlateNumber</b></MudTd><MudTd>@context.PermitNumber</MudTd>
                <MudTd>@context.VehicleOwnerUserName<br /><small>@context.VehicleOwnerName</small></MudTd>
                <MudTd>@context.OfficeTaxCode</MudTd><MudTd>@context.VehicleType</MudTd><MudTd>@context.SeatCount</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.IsValid ? Color.Success : Color.Error)">@(context.IsValid ? "Hợp lệ" : "Lỗi")</MudChip></MudTd>
                <MudTd><MudText Typo="Typo.caption" Color="Color.Error">@context.ErrorMessage</MudText></MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 10, 20, 50, 100 })" /></PagerContent>
        </MudTable>
        <MudStack Row="true" Class="mt-4"><MudButton Variant="Variant.Outlined" Disabled="_importing" OnClick="CancelImport">Hủy</MudButton><MudSpacer />
            <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Publish"
                       Disabled="@(_importing || _importPreview.ValidRows == 0)" OnClick="ConfirmImportAsync">
                @(_importing ? "Đang import..." : $"Import {_importPreview.ValidRows} xe")
            </MudButton>
        </MudStack>
    </MudPaper>
}

<MudTable T="VehicleRow" Items="FilteredItems" Loading="_loading" Hover="true" Striped="true" RowsPerPage="20" Breakpoint="Breakpoint.Sm">
    <HeaderContent><MudTh>Biển số</MudTh><MudTh>Số phù hiệu</MudTh><MudTh>Công ty/Văn phòng</MudTh><MudTh>Tài khoản Chủ xe</MudTh><MudTh>Nhãn hiệu</MudTh><MudTh>Số chỗ</MudTh><MudTh>Trạng thái</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Biển số"><b>@context.PlateNumber</b><br /><small>@(context.VehicleCode ?? "—")</small></MudTd>
        <MudTd DataLabel="Số phù hiệu">@Display(context.PermitNumber)</MudTd>
        <MudTd DataLabel="Công ty/Văn phòng">@Display(context.OfficeNames)</MudTd><MudTd DataLabel="Tài khoản Chủ xe">@Display(context.VehicleOwnerName)</MudTd>
        <MudTd DataLabel="Nhãn hiệu">@Display(context.Brand)</MudTd><MudTd DataLabel="Số chỗ">@(context.SeatCount?.ToString() ?? "—")</MudTd>
        <MudTd DataLabel="Trạng thái"><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Hoạt động" : "Ngừng")</MudChip></MudTd>
        <MudTd><MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" OnClick="@(() => Navigation.NavigateTo($"/admin/vehicles/{context.Id}"))" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo($"/admin/vehicles/{context.Id}/edit"))" />
            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
    <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 10, 20, 50, 100 })" /></PagerContent>
</MudTable>

@code {
    private List<VehicleRow> _items = [];
    private string? _keyword;
    private bool _loading;
    private bool _isOwner;
    private bool _readingImportFile;
    private bool _importing;
    private string _currentUserId = string.Empty;
    private HashSet<Guid> _managedOfficeIds = [];
    private VehicleImportPreview? _importPreview;
    private MudFileUpload<IBrowserFile>? _fileUpload;

    private IEnumerable<VehicleRow> FilteredItems => string.IsNullOrWhiteSpace(_keyword) ? _items : _items.Where(x =>
        Contains(x.PlateNumber) || Contains(x.VehicleCode) || Contains(x.PermitNumber) || Contains(x.VehicleOwnerName) || Contains(x.OwnerPhoneNumber) || Contains(x.OfficeNames));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        _isOwner = auth.User.IsInRole("Owner");
        _managedOfficeIds = await OfficeAccessService.GetManagedOfficeIdsAsync(_currentUserId, _isOwner);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            var vehicles = await db.Vehicles.AsNoTracking().Include(x => x.AssignedDriver).Include(x => x.OfficeVehicles).ThenInclude(x => x.CompanyProfile)
                .Where(x => x.OfficeVehicles.Any(ov => ov.IsActive && !ov.IsDeleted && ov.AssignedTo == null && _managedOfficeIds.Contains(ov.CompanyProfileId)))
                .OrderBy(x => x.PlateNumber).ToListAsync();
            _items = vehicles.Select(x => new VehicleRow
            {
                Id = x.Id, PlateNumber = x.PlateNumber, VehicleCode = x.VehicleCode, PermitNumber = x.PermitNumber, Brand = x.Brand, SeatCount = x.SeatCount,
                VehicleOwnerName = x.AssignedDriver?.FullName, OwnerPhoneNumber = x.AssignedDriver?.PhoneNumber,
                OfficeNames = string.Join(", ", x.OfficeVehicles.Where(ov => ov.IsActive && !ov.IsDeleted && ov.AssignedTo == null && _managedOfficeIds.Contains(ov.CompanyProfileId))
                    .OrderByDescending(ov => ov.IsPrimary).ThenBy(ov => ov.CompanyProfile.CompanyName)
                    .Select(ov => string.IsNullOrWhiteSpace(ov.CompanyProfile.BranchName) ? ov.CompanyProfile.CompanyName : $"{ov.CompanyProfile.CompanyName} - {ov.CompanyProfile.BranchName}")),
                IsActive = x.IsActive
            }).ToList();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task ReadImportFileAsync(IBrowserFile? file)
    {
        if (_readingImportFile || _importing) return;
        _readingImportFile = true; _importPreview = null;
        try
        {
            if (file is null) return;
            await using var stream = file.OpenReadStream(VehicleExcelImportService.MaximumFileSize);
            using var memory = new MemoryStream(); await stream.CopyToAsync(memory); memory.Position = 0;
            _importPreview = await VehicleImportService.PreviewAsync(memory, file.Name, _currentUserId, _isOwner);
            Snackbar.Add($"Đã kiểm tra {_importPreview.TotalRows} dòng: {_importPreview.ValidRows} hợp lệ, {_importPreview.InvalidRows} lỗi.", _importPreview.InvalidRows == 0 ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { if (_fileUpload is not null) await _fileUpload.ClearAsync(); _readingImportFile = false; }
    }

    private async Task ConfirmImportAsync()
    {
        if (_importPreview is null || _importPreview.ValidRows == 0 || _importing) return;
        _importing = true;
        try
        {
            var original = _importPreview;
            var result = await VehicleImportService.ImportAsync(original.Rows, _currentUserId, _isOwner);
            var failedRows = result.Errors.Select(x => x.RowNumber).ToHashSet();
            foreach (var error in result.Errors)
            {
                var row = original.Rows.FirstOrDefault(x => x.RowNumber == error.RowNumber);
                if (row is not null) ExcelImportUtility.AddError(row.Errors, error.Error);
            }
            original.Rows = original.Rows.Where(x => !x.IsValid || failedRows.Contains(x.RowNumber)).ToList();
            if (result.ImportedCount > 0) await LoadAsync();
            Snackbar.Add($"Đã import {result.ImportedCount} xe; {result.FailedCount} dòng lỗi khi lưu.", result.FailedCount == 0 ? Severity.Success : Severity.Warning);
            if (original.Rows.Count == 0) CancelImport();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _importing = false; }
    }

    private void CancelImport() => _importPreview = null;

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            if (!await OfficeAccessService.CanManageVehicleAsync(_currentUserId, id, _isOwner))
                throw new InvalidOperationException("Xe nằm ngoài phạm vi quản lý.");
            await using var db = await Factory.CreateDbContextAsync();
            var vehicle = await db.Vehicles.Include(x => x.Contracts).FirstOrDefaultAsync(x => x.Id == id); if (vehicle is null) return;
            var hasOpenContract = vehicle.Contracts.Any(x => x.Status is not ContractStatus.Completed and not ContractStatus.Cancelled and not ContractStatus.Expired and not ContractStatus.Invalidated);
            if (hasOpenContract) { Snackbar.Add("Xe đang có hợp đồng chưa kết thúc.", Severity.Warning); return; }
            var now = DateTime.UtcNow; vehicle.IsDeleted = true; vehicle.IsActive = false; vehicle.DeletedAt = now; vehicle.DeletedBy = _currentUserId;
            var links = await db.OfficeVehicles.Where(x => x.VehicleId == id).ToListAsync();
            foreach (var link in links) { link.IsDeleted = true; link.IsActive = false; link.AssignedTo = now; link.DeletedAt = now; link.DeletedBy = _currentUserId; }
            await db.SaveChangesAsync(); Snackbar.Add("Đã xóa mềm xe.", Severity.Success); await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private bool Contains(string? value) => !string.IsNullOrWhiteSpace(value) && value.Contains(_keyword!.Trim(), StringComparison.OrdinalIgnoreCase);
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private sealed class VehicleRow
    {
        public Guid Id { get; set; } public string PlateNumber { get; set; } = string.Empty; public string? VehicleCode { get; set; }
        public string? PermitNumber { get; set; } public string? Brand { get; set; } public int? SeatCount { get; set; }
        public string? VehicleOwnerName { get; set; } public string? OwnerPhoneNumber { get; set; }
        public string OfficeNames { get; set; } = string.Empty; public bool IsActive { get; set; }
    }
}
