@page "/admin/vehicles/{Id:guid}"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject IOfficeAccessService OfficeAccessService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Xe</PageTitle>
<PageHeader Title="Chi tiết xe" Subtitle="Giao diện phân tách rõ phần tổng quan, thông tin phương tiện, đơn vị vận hành và tài khoản Chủ xe." />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_item is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy xe hoặc xe nằm ngoài phạm vi quản lý.</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudPaper Class="ent-hero-card" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudAvatar Size="Size.Large" Color="Color.Surface" Variant="Variant.Outlined" Class="hero-avatar" Style="color:#fff; border-color:rgba(255,255,255,.28); background:rgba(255,255,255,.12);">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h5" Class="fw-700" Style="color:#fff;">@_item.PlateNumber</MudText>
                        <MudText Typo="Typo.body2" Class="ent-hero-subtitle">Số phù hiệu: @Display(_item.PermitNumber) · Mã xe: @Display(_item.VehicleCode)</MudText>
                        <MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Color="@(_item.IsActive ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                                @(_item.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @_officeNamesOrDefault
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @(_item.AssignedDriver is null ? "Chưa gán Chủ xe" : $"Chủ xe: {_item.AssignedDriver.FullName}")
                            </MudChip>
                        </MudStack>
                    </div>
                    <MudSpacer />
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudPaper Class="ent-hero-metric" Elevation="0">
                            <span class="ent-hero-metric__label">Nhãn hiệu</span>
                            <strong class="ent-hero-metric__value">@Display(_item.Brand)</strong>
                        </MudPaper>
                        <MudPaper Class="ent-hero-metric" Elevation="0">
                            <span class="ent-hero-metric__label">Dòng xe / Loại xe</span>
                            <strong class="ent-hero-metric__value">@Display(_item.Model ?? _item.VehicleType)</strong>
                        </MudPaper>
                        <MudPaper Class="ent-hero-metric" Elevation="0">
                            <span class="ent-hero-metric__label">Số chỗ</span>
                            <strong class="ent-hero-metric__value">@(_item.SeatCount?.ToString() ?? "—")</strong>
                        </MudPaper>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Class="ent-section-card fill-height" Elevation="0">
                <div class="ent-section-header">
                    <div class="ent-section-header__left">
                        <div class="ent-section-icon"><MudIcon Icon="@Icons.Material.Filled.DirectionsCarFilled" Size="Size.Small" /></div>
                        <div>
                            <MudText Class="ent-section-title">1. Hồ sơ nhận diện &amp; Thông số kỹ thuật</MudText>
                            <MudText Class="ent-section-subtitle">Biển kiểm soát, số phù hiệu, số khung, số máy và đặc điểm phương tiện.</MudText>
                        </div>
                    </div>
                </div>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6"><InfoListItem Label="Biển kiểm soát" Value="@_item.PlateNumber" Icon="@Icons.Material.Filled.ConfirmationNumber" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Số phù hiệu vận tải" Value="@Display(_item.PermitNumber)" Icon="@Icons.Material.Filled.Badge" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Mã phương tiện" Value="@Display(_item.VehicleCode)" Icon="@Icons.Material.Filled.Pin" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Loại phương tiện" Value="@Display(_item.VehicleType)" Icon="@Icons.Material.Filled.LocalShipping" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Nhãn hiệu (Hãng xe)" Value="@Display(_item.Brand)" Icon="@Icons.Material.Filled.LocalOffer" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Dòng xe (Model)" Value="@Display(_item.Model)" Icon="@Icons.Material.Filled.ViewInAr" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Số chỗ ngồi" Value="@(_item.SeatCount?.ToString() ?? "—")" Icon="@Icons.Material.Filled.EventSeat" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Màu sơn" Value="@Display(_item.Color)" Icon="@Icons.Material.Filled.Palette" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Số khung (VIN)" Value="@Display(_item.ChassisNumber)" Icon="@Icons.Material.Filled.Build" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Số máy" Value="@Display(_item.EngineNumber)" Icon="@Icons.Material.Filled.Engineering" /></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Class="ent-section-card fill-height" Elevation="0">
                <div class="ent-section-header">
                    <div class="ent-section-header__left">
                        <div class="ent-section-icon"><MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" /></div>
                        <div>
                            <MudText Class="ent-section-title">2. Đơn vị vận hành &amp; Chủ sở hữu</MudText>
                            <MudText Class="ent-section-subtitle">Công ty/Văn phòng quản lý và hồ sơ pháp lý Chủ phương tiện.</MudText>
                        </div>
                    </div>
                </div>
                <MudGrid Spacing="2">
                    <MudItem xs="12"><InfoListItem Label="Công ty / Văn phòng quản lý" Value="@_officeNamesOrDefault" Icon="@Icons.Material.Filled.Apartment" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Trạng thái khai thác" Value="@(_item.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")" Icon="@Icons.Material.Filled.ToggleOn" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Tình trạng gán Chủ xe" Value="@(_item.AssignedDriver is null ? "Chưa gán" : "Đã gán Chủ xe")" Icon="@Icons.Material.Filled.SupervisorAccount" /></MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                @if (_item.AssignedDriver is null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Xe này hiện chưa gán tài khoản Chủ xe. Hãy bấm <b>Chỉnh sửa thông tin xe</b> để gán Chủ xe trước khi phát hợp đồng.
                    </MudAlert>
                }
                else
                {
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6"><InfoListItem Label="Họ tên Chủ xe" Value="@Display(_item.AssignedDriver.FullName)" Icon="@Icons.Material.Filled.Person" /></MudItem>
                        <MudItem xs="12" sm="6"><InfoListItem Label="Số điện thoại" Value="@Display(_item.AssignedDriver.PhoneNumber)" Icon="@Icons.Material.Filled.Phone" /></MudItem>
                        <MudItem xs="12" sm="6"><InfoListItem Label="Số CCCD Chủ xe" Value="@Display(_item.AssignedDriver.CitizenId)" Icon="@Icons.Material.Filled.CreditCard" /></MudItem>
                        <MudItem xs="12" sm="6"><InfoListItem Label="Ngày cấp CCCD" Value="@DateText(_item.AssignedDriver.CitizenIdIssuedDate)" Icon="@Icons.Material.Filled.Event" /></MudItem>
                        <MudItem xs="12"><InfoListItem Label="Nơi cấp CCCD" Value="@Display(_item.AssignedDriver.CitizenIdIssuedPlace)" Icon="@Icons.Material.Filled.AccountBalance" /></MudItem>
                        <MudItem xs="12"><InfoListItem Label="Địa chỉ Chủ xe" Value="@Display(_item.AssignedDriver.Address)" Icon="@Icons.Material.Filled.LocationOn" /></MudItem>
                    </MudGrid>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="ent-action-bar" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/admin/vehicles"))">Quay lại danh sách</MudButton>
                    <MudSpacer />
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => Navigation.NavigateTo($"/admin/vehicles/{Id}/edit"))">Chỉnh sửa thông tin xe</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<style>
    .vehicle-hero {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(14,165,233,0.08), rgba(16,185,129,0.05));
    }

    .hero-avatar {
        font-size: 1.25rem;
    }

    .metric-pill {
        min-width: 140px;
        border-radius: 16px;
        background: rgba(255,255,255,0.72);
        border: 1px solid rgba(15, 23, 42, 0.08);
    }

    .detail-section {
        border-radius: 22px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        background: #fff;
    }

    .fill-height {
        height: 100%;
    }
</style>

@code {
    [Parameter] public Guid Id { get; set; }
    private Vehicle? _item;
    private string _officeNames = string.Empty;
    private bool _loading = true;
    private string _officeNamesOrDefault => string.IsNullOrWhiteSpace(_officeNames) ? "Chưa gán Công ty/Văn phòng" : _officeNames;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            var isOwner = auth.User.IsInRole("Owner");
            if (!await OfficeAccessService.CanManageVehicleAsync(userId, Id, isOwner)) return;
            await using var db = await Factory.CreateDbContextAsync();
            _item = await db.Vehicles.AsNoTracking().Include(x => x.AssignedDriver).FirstOrDefaultAsync(x => x.Id == Id);
            _officeNames = await db.OfficeVehicles.AsNoTracking()
                .Where(x => x.VehicleId == Id && x.IsActive && !x.IsDeleted && x.AssignedTo == null)
                .Select(x => x.CompanyProfile.BranchName == null || x.CompanyProfile.BranchName == ""
                    ? x.CompanyProfile.CompanyName
                    : x.CompanyProfile.CompanyName + " - " + x.CompanyProfile.BranchName)
                .SingleOrDefaultAsync() ?? string.Empty;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DateText(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "—";
}
