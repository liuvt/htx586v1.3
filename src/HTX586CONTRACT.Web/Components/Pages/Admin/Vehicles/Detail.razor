@page "/admin/vehicles/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Chi tiết xe</PageTitle>
<PageHeader Title="Chi tiết xe" Subtitle="Thông tin danh mục hiện tại; hợp đồng sử dụng dữ liệu tài xế nhập tay." />

@if (_loading) { <MudProgressLinear Indeterminate="true" /> }
else if (_vehicle is null) { <MudAlert Severity="Severity.Warning">Không tìm thấy xe thuộc công ty của bạn.</MudAlert> }
else
{
    <MudPaper Outlined="true" Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="4"><InfoListItem Label="Biển số" Value="@_vehicle.PlateNumber" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Mã xe" Value="@_vehicle.VehicleCode" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Số chỗ" Value="@_vehicle.SeatCount?.ToString()" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Hãng" Value="@_vehicle.Brand" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Dòng xe" Value="@_vehicle.Model" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Loại xe" Value="@_vehicle.VehicleType" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Màu" Value="@_vehicle.Color" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Số khung" Value="@_vehicle.ChassisNumber" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Số máy" Value="@_vehicle.EngineNumber" /></MudItem>
            <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Chủ sở hữu" Value="@_vehicle.OwnerName" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="CCCD" Value="@_vehicle.OwnerCitizenId" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Điện thoại" Value="@_vehicle.OwnerPhoneNumber" /></MudItem>
            <MudItem xs="12"><InfoListItem Label="Địa chỉ" Value="@_vehicle.OwnerAddress" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Href="/admin/vehicles" Variant="Variant.Outlined">Quay lại</MudButton>
            <MudButton Href="@($"/admin/vehicles/{Id}/edit")" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit">Cập nhật</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private bool _loading = true;
    private Vehicle? _vehicle;
    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var adminId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await using var db = await DbFactory.CreateDbContextAsync();
        _vehicle = await db.Vehicles.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Id && x.AdminId == adminId);
        _loading = false;
    }
}
