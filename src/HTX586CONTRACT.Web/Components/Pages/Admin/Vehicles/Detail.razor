@page "/admin/vehicles/{Id:guid}"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject IOfficeAccessService OfficeAccessService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Chi tiết xe</PageTitle>
<PageHeader Title="Chi tiết xe" Subtitle="Thông tin phương tiện, Chủ xe và các Công ty/Văn phòng hoạt động." />

@if (_loading) { <MudProgressCircular Indeterminate="true" /> }
else if (_item is null) { <MudAlert Severity="Severity.Error">Không tìm thấy xe hoặc xe nằm ngoài phạm vi quản lý.</MudAlert> }
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" md="4"><InfoListItem Label="Biển số" Value="@_item.PlateNumber" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Mã xe" Value="@Display(_item.VehicleCode)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Tài khoản Chủ xe" Value="@Display(_item.AssignedDriver?.FullName)" /></MudItem>
            <MudItem xs="12"><InfoListItem Label="Công ty/Văn phòng" Value="@Display(_officeNames)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Nhãn hiệu" Value="@Display(_item.Brand)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Dòng xe" Value="@Display(_item.Model)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Số chỗ" Value="@(_item.SeatCount?.ToString() ?? "—")" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Họ tên chủ xe" Value="@_item.OwnerName" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Điện thoại chủ xe" Value="@Display(_item.OwnerPhoneNumber)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="CCCD chủ xe" Value="@Display(_item.OwnerCitizenId)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Ngày cấp CCCD" Value="@DateText(_item.OwnerCitizenIdIssuedDate)" /></MudItem>
            <MudItem xs="12" md="8"><InfoListItem Label="Nơi cấp CCCD" Value="@Display(_item.OwnerCitizenIdIssuedPlace)" /></MudItem>
            <MudItem xs="12"><InfoListItem Label="Địa chỉ chủ xe" Value="@Display(_item.OwnerAddress)" /></MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1">Chân ký Chủ xe từ tài khoản</MudText>
                @if (!string.IsNullOrWhiteSpace(OwnerSignatureUrl))
                {
                    <img src="@($"{OwnerSignatureUrl}?v={OwnerSignedAt?.Ticks ?? 0}")" style="max-width:260px;max-height:120px;object-fit:contain" />
                }
                else { <MudText>Chưa có chữ ký.</MudText> }
            </MudItem>
            <MudItem xs="12" md="6"><InfoListItem Label="Trạng thái" Value="@(_item.IsActive ? "Hoạt động" : "Ngừng")" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Class="mt-4"><MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/admin/vehicles"))">Quay lại</MudButton><MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => Navigation.NavigateTo($"/admin/vehicles/{Id}/edit"))">Cập nhật</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Vehicle? _item;
    private string _officeNames = string.Empty;
    private bool _loading = true;
    private string? OwnerSignatureUrl => _item?.AssignedDriver?.VehicleOwnerSignatureFileUrl ?? _item?.OwnerSignatureFileUrl;
    private DateTime? OwnerSignedAt => _item?.AssignedDriver?.VehicleOwnerSignedAt ?? _item?.OwnerSignedAt;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            var isOwner = auth.User.IsInRole("Owner");
            if (!await OfficeAccessService.CanManageVehicleAsync(userId, Id, isOwner)) return;
            await using var db = await Factory.CreateDbContextAsync();
            _item = await db.Vehicles.AsNoTracking().Include(x => x.AssignedDriver).FirstOrDefaultAsync(x => x.Id == Id);
            _officeNames = string.Join(", ", await db.OfficeVehicles.AsNoTracking().Where(x => x.VehicleId == Id && x.IsActive)
                .OrderByDescending(x => x.IsPrimary).ThenBy(x => x.CompanyProfile.CompanyName)
                .Select(x => x.CompanyProfile.BranchName == null || x.CompanyProfile.BranchName == "" ? x.CompanyProfile.CompanyName : x.CompanyProfile.CompanyName + " - " + x.CompanyProfile.BranchName)
                .ToListAsync());
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DateText(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "—";
}
