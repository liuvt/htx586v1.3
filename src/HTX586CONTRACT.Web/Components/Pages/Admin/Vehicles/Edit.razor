@page "/admin/vehicles/{Id:guid}/edit"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject IOfficeAccessService OfficeAccessService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Cập nhật xe</PageTitle>
<PageHeader Title="Cập nhật xe" Subtitle="Chọn Chủ xe và Công ty/Văn phòng; thông tin pháp lý được đồng bộ từ tài khoản Chủ xe." />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_model is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy xe hoặc xe nằm ngoài phạm vi quản lý.</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_model.AssignedDriverId" Label="Tài khoản Chủ xe" Required="true" Variant="Variant.Outlined"
                           HelperText="Thông tin pháp lý của xe được lấy tự động từ tài khoản đã chọn.">
                    @foreach (var owner in _vehicleOwners)
                    {
                        <MudSelectItem T="string" Value="@owner.Id">@UserDisplay(owner)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="Guid" Label="Công ty/Văn phòng hoạt động" MultiSelection="true" Required="true"
                           SelectedValues="_officeIds" SelectedValuesChanged="OnOfficeSelectionChanged" Variant="Variant.Outlined">
                    @foreach (var office in _offices)
                    {
                        <MudSelectItem T="Guid" Value="@office.Id">@OfficeDisplay(office)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @if (SelectedVehicleOwner is not null)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Thông tin chủ xe lấy từ tài khoản</MudText>
                        <MudGrid>
                            <MudItem xs="12" md="4"><InfoListItem Label="Họ và tên" Value="@SelectedVehicleOwner.FullName" /></MudItem>
                            <MudItem xs="12" md="4"><InfoListItem Label="Số điện thoại" Value="@Display(SelectedVehicleOwner.PhoneNumber)" /></MudItem>
                            <MudItem xs="12" md="4"><InfoListItem Label="CCCD" Value="@Display(SelectedVehicleOwner.CitizenId)" /></MudItem>
                            <MudItem xs="12" md="4"><InfoListItem Label="Ngày cấp CCCD" Value="@DateText(SelectedVehicleOwner.CitizenIdIssuedDate)" /></MudItem>
                            <MudItem xs="12" md="4"><InfoListItem Label="Nơi cấp CCCD" Value="@Display(SelectedVehicleOwner.CitizenIdIssuedPlace)" /></MudItem>
                            <MudItem xs="12" md="4"><InfoListItem Label="Địa chỉ" Value="@Display(SelectedVehicleOwner.Address)" /></MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }

            <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.PlateNumber" Label="Biển số" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.VehicleCode" Label="Mã xe" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.VehicleType" Label="Loại xe" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.Brand" Label="Nhãn hiệu" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.Model" Label="Dòng xe" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField T="int?" @bind-Value="_model.SeatCount" Label="Số chỗ" Min="1" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.Color" Label="Màu xe" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.ChassisNumber" Label="Số khung" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.EngineNumber" Label="Số máy" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Success" Label="Xe đang hoạt động" /></MudItem>

            <MudItem xs="12">
                @if (VehicleOwnerChanged)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        Chủ xe đã thay đổi. Khi lưu xe, chân ký sẽ tự động lấy từ tài khoản Chủ xe mới; chữ ký tài xế theo xe cũ sẽ bị xóa.
                    </MudAlert>
                }
                else if (!string.IsNullOrWhiteSpace(SelectedVehicleOwner?.VehicleOwnerSignatureFileUrl))
                {
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Chân ký Chủ xe lấy từ tài khoản</MudText>
                    <SignaturePad Disabled="true"
                                  ExistingSignatureUrl="@SelectedVehicleOwner?.VehicleOwnerSignatureFileUrl"
                                  SignerName="@SelectedVehicleOwner?.FullName"
                                  SignedAt="@SelectedVehicleOwner?.VehicleOwnerSignedAt" />
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        Tài khoản Chủ xe chưa có chân ký. Hợp đồng mới sẽ không thể lập cho đến khi bổ sung chân ký tại hồ sơ tài khoản.
                    </MudAlert>
                }
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Class="mt-4">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo($"/admin/vehicles/{Id}"))">Quay lại</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">Lưu thay đổi</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Vehicle? _model;
    private HashSet<Guid> _officeIds = [];
    private List<CompanyProfile> _offices = [];
    private List<ApplicationUser> _vehicleOwners = [];
    private string _currentUserId = string.Empty;
    private string? _originalVehicleOwnerId;
    private bool _isOwner;
    private bool _loading = true;
    private bool _saving;
    private ApplicationUser? SelectedVehicleOwner => _vehicleOwners.FirstOrDefault(x => x.Id == _model?.AssignedDriverId);
    private bool VehicleOwnerChanged => !string.Equals(_originalVehicleOwnerId, _model?.AssignedDriverId, StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            _isOwner = auth.User.IsInRole("Owner");
            if (!await OfficeAccessService.CanManageVehicleAsync(_currentUserId, Id, _isOwner))
            {
                _model = null;
                return;
            }

            await using var db = await Factory.CreateDbContextAsync();
            var managedIds = await OfficeAccessService.GetManagedOfficeIdsAsync(_currentUserId, _isOwner);
            _offices = await db.CompanyProfiles.AsNoTracking()
                .Where(x => managedIds.Contains(x.Id) && x.IsActive && !x.IsDeleted)
                .OrderBy(x => x.CompanyName).ThenBy(x => x.BranchName)
                .ToListAsync();
            _vehicleOwners = await LoadVehicleOwnersAsync(db);
            _model = await db.Vehicles.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Id);
            if (_model is null) return;

            _officeIds = (await db.OfficeVehicles.AsNoTracking()
                .Where(x => x.VehicleId == Id && x.IsActive && !x.IsDeleted && x.AssignedTo == null && managedIds.Contains(x.CompanyProfileId))
                .Select(x => x.CompanyProfileId)
                .ToListAsync()).ToHashSet();
            _originalVehicleOwnerId = _model.AssignedDriverId;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _model = null;
        }
        finally { _loading = false; }
    }

    private void OnOfficeSelectionChanged(IEnumerable<Guid> values) => _officeIds = values.ToHashSet();

    private async Task SaveAsync()
    {
        if (_model is null) return;
        if (_officeIds.Count == 0)
        {
            Snackbar.Add("Vui lòng chọn ít nhất một Công ty/Văn phòng.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.PlateNumber))
        {
            Snackbar.Add("Vui lòng nhập biển số xe.", Severity.Warning);
            return;
        }

        var selectedOwner = SelectedVehicleOwner;
        if (selectedOwner is null)
        {
            Snackbar.Add("Vui lòng chọn tài khoản Chủ xe.", Severity.Warning);
            return;
        }
        if (!HasCompleteLegalProfile(selectedOwner))
        {
            Snackbar.Add("Hồ sơ Chủ xe chưa đủ CCCD, ngày cấp, nơi cấp hoặc địa chỉ. Hãy cập nhật tài khoản trước khi lưu xe.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var managedIds = await OfficeAccessService.GetManagedOfficeIdsAsync(_currentUserId, _isOwner);
            if (_officeIds.Any(x => !managedIds.Contains(x)))
                throw new InvalidOperationException("Có Công ty/Văn phòng nằm ngoài phạm vi quản lý.");

            await using var db = await Factory.CreateDbContextAsync();
            var validOwner = await FindValidVehicleOwnerAsync(db, selectedOwner.Id);
            if (validOwner is null)
                throw new InvalidOperationException("Tài khoản Chủ xe không hợp lệ, đã khóa hoặc chưa được duyệt.");

            var entity = await db.Vehicles.FirstOrDefaultAsync(x => x.Id == Id);
            if (entity is null)
                throw new InvalidOperationException("Không tìm thấy xe.");

            var plate = _model.PlateNumber.Trim().ToUpperInvariant();
            if (await db.Vehicles.IgnoreQueryFilters().AnyAsync(x => !x.IsDeleted && x.Id != Id && x.PlateNumber == plate))
                throw new InvalidOperationException("Biển số xe đã tồn tại.");

            var ownerChanged = !string.Equals(_originalVehicleOwnerId, validOwner.Id, StringComparison.Ordinal);
            entity.PlateNumber = plate;
            entity.VehicleCode = N(_model.VehicleCode);
            entity.Brand = N(_model.Brand);
            entity.Model = N(_model.Model);
            entity.VehicleType = N(_model.VehicleType);
            entity.SeatCount = _model.SeatCount;
            entity.Color = N(_model.Color);
            entity.ChassisNumber = N(_model.ChassisNumber);
            entity.EngineNumber = N(_model.EngineNumber);
            ApplyOwnerSnapshot(entity, validOwner);

            var primaryOfficeId = _offices.First(x => _officeIds.Contains(x.Id)).Id;
            entity.IsActive = _model.IsActive;
            entity.UpdatedAt = DateTime.UtcNow;
            entity.UpdatedBy = _currentUserId;

            if (ownerChanged)
            {
                // Chân ký chủ xe được lấy từ tài khoản mới qua ApplyOwnerSnapshot.
                // Chỉ xóa chữ ký tài xế theo xe vì người nhận xe đã thay đổi.
                entity.AccountDriverSignatureFileUrl = null;
                entity.AccountDriverSignatureHash = null;
                entity.AccountDriverSignedAt = null;
                entity.AccountDriverSignedByUserId = null;
            }

            await ReplaceOfficeAssignmentsAsync(
                db,
                entity.Id,
                _officeIds,
                primaryOfficeId,
                managedIds,
                _isOwner);

            if (ownerChanged)
            {
                db.DriverNotifications.Add(new DriverNotification
                {
                    DriverId = validOwner.Id,
                    Type = "VehicleAssigned",
                    Title = "Bạn được gán phương tiện",
                    Message = $"Phương tiện {entity.PlateNumber} đã được gán cho tài khoản Chủ xe của bạn.",
                    LinkUrl = "/vehicle-owner/vehicles",
                    RelatedVehicleId = entity.Id,
                    CreatedAt = DateTime.UtcNow
                });
            }

            await db.SaveChangesAsync();
            Snackbar.Add("Đã cập nhật xe, Chủ xe và Công ty/Văn phòng.", Severity.Success);
            Navigation.NavigateTo($"/admin/vehicles/{Id}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task ReplaceOfficeAssignmentsAsync(
        ApplicationDbContext db,
        Guid vehicleId,
        HashSet<Guid> selectedOfficeIds,
        Guid requestedPrimaryOfficeId,
        HashSet<Guid> managedOfficeIds,
        bool isOwner)
    {
        var now = DateTime.UtcNow;
        var rows = await db.OfficeVehicles
            .IgnoreQueryFilters()
            .Where(x => x.VehicleId == vehicleId)
            .ToListAsync();

        foreach (var row in rows)
        {
            // Tài khoản Quản lý chỉ thay đổi liên kết thuộc các văn phòng được phân quyền.
            if (!isOwner && !managedOfficeIds.Contains(row.CompanyProfileId))
                continue;

            if (selectedOfficeIds.Contains(row.CompanyProfileId))
            {
                row.IsDeleted = false;
                row.DeletedAt = null;
                row.DeletedBy = null;
                row.IsActive = true;
                row.AssignedTo = null;
                row.UpdatedAt = now;
                row.UpdatedBy = _currentUserId;
            }
            else
            {
                row.IsPrimary = false;
                row.IsDeleted = true;
                row.IsActive = false;
                row.AssignedTo = now;
                row.DeletedAt = now;
                row.DeletedBy = _currentUserId;
                row.UpdatedAt = now;
                row.UpdatedBy = _currentUserId;
            }
        }

        var existingIds = rows.Select(x => x.CompanyProfileId).ToHashSet();
        foreach (var officeId in selectedOfficeIds.Where(x => !existingIds.Contains(x)))
        {
            var newRow = new HTX586CONTRACT.Domain.Offices.OfficeVehicle
            {
                VehicleId = vehicleId,
                CompanyProfileId = officeId,
                IsPrimary = false,
                IsActive = true,
                AssignedFrom = now,
                CreatedAt = now,
                CreatedBy = _currentUserId
            };
            rows.Add(newRow);
            db.OfficeVehicles.Add(newRow);
        }

        var activeRows = rows
            .Where(x => x.IsActive && !x.IsDeleted && x.AssignedTo == null)
            .OrderBy(x => x.AssignedFrom)
            .ThenBy(x => x.CompanyProfileId)
            .ToList();

        // Nếu xe đã có văn phòng chính nằm ngoài phạm vi của tài khoản Quản lý thì giữ nguyên.
        var primary = !isOwner
            ? activeRows.FirstOrDefault(x => !managedOfficeIds.Contains(x.CompanyProfileId) && x.IsPrimary)
            : null;
        primary ??= activeRows.FirstOrDefault(x => x.IsPrimary);
        primary ??= activeRows.FirstOrDefault(x => x.CompanyProfileId == requestedPrimaryOfficeId);
        primary ??= activeRows.FirstOrDefault();

        foreach (var row in activeRows)
            row.IsPrimary = ReferenceEquals(row, primary);
    }

    private static async Task<List<ApplicationUser>> LoadVehicleOwnersAsync(ApplicationDbContext db)
    {
        var ids = await (from ur in db.UserRoles.AsNoTracking()
                         join r in db.Roles.AsNoTracking() on ur.RoleId equals r.Id
                         where r.Name == SystemRoleDisplay.VehicleOwnerRole
                         select ur.UserId).ToListAsync();
        return await db.Users.AsNoTracking()
            .Where(x => ids.Contains(x.Id) && x.IsActive && !x.IsDeleted && x.RegistrationStatus == "Approved")
            .OrderBy(x => x.FullName)
            .ToListAsync();
    }

    private static async Task<ApplicationUser?> FindValidVehicleOwnerAsync(ApplicationDbContext db, string userId)
    {
        var hasRole = await (from ur in db.UserRoles.AsNoTracking()
                             join r in db.Roles.AsNoTracking() on ur.RoleId equals r.Id
                             where ur.UserId == userId && r.Name == SystemRoleDisplay.VehicleOwnerRole
                             select ur.UserId).AnyAsync();
        if (!hasRole) return null;
        return await db.Users.FirstOrDefaultAsync(x => x.Id == userId && x.IsActive && !x.IsDeleted && x.RegistrationStatus == "Approved");
    }

    private static void ApplyOwnerSnapshot(Vehicle vehicle, ApplicationUser owner)
    {
        vehicle.AssignedDriverId = owner.Id;
        vehicle.OwnerName = owner.FullName.Trim();
        vehicle.OwnerPhoneNumber = N(owner.PhoneNumber);
        vehicle.OwnerCitizenId = N(owner.CitizenId);
        vehicle.OwnerCitizenIdIssuedDate = owner.CitizenIdIssuedDate?.Date;
        vehicle.OwnerCitizenIdIssuedPlace = N(owner.CitizenIdIssuedPlace);
        vehicle.OwnerAddress = N(owner.Address);
        vehicle.OwnerSignatureFileUrl = owner.VehicleOwnerSignatureFileUrl;
        vehicle.OwnerSignatureHash = owner.VehicleOwnerSignatureHash;
        vehicle.OwnerSignedAt = owner.VehicleOwnerSignedAt;
    }

    private static bool HasCompleteLegalProfile(ApplicationUser owner) =>
        !string.IsNullOrWhiteSpace(owner.FullName) &&
        !string.IsNullOrWhiteSpace(owner.PhoneNumber) &&
        !string.IsNullOrWhiteSpace(owner.CitizenId) &&
        owner.CitizenIdIssuedDate.HasValue &&
        !string.IsNullOrWhiteSpace(owner.CitizenIdIssuedPlace) &&
        !string.IsNullOrWhiteSpace(owner.Address);

    private static string OfficeDisplay(CompanyProfile x) => string.IsNullOrWhiteSpace(x.BranchName) ? x.CompanyName : $"{x.CompanyName} - {x.BranchName}";
    private static string UserDisplay(ApplicationUser x) => string.IsNullOrWhiteSpace(x.EmployeeCode) ? $"{x.FullName} - {x.PhoneNumber}" : $"{x.FullName} ({x.EmployeeCode}) - {x.PhoneNumber}";
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DateText(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "—";
    private static string? N(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
