@page "/admin/customers"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CustomerExcelImportService CustomerImportService
@inject ISnackbar Snackbar

<PageTitle>Quản lý khách hàng</PageTitle>
<PageHeader Title="Quản lý khách hàng" Subtitle="Quản lý danh mục khách hàng cá nhân/doanh nghiệp, tìm kiếm nhanh theo họ tên, tên đơn vị hoặc số điện thoại." />

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid AlignItems="AlignItems.Center">
        <MudItem xs="12" md="5">
            <MudTextField T="string"
                          @bind-Value="_keyword"
                          Placeholder="Tìm theo họ tên đại diện, tên đơn vị/tổ chức hoặc số điện thoại"
                          Label="Tìm kiếm khách hàng"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="7">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                <MudButton Href="/templates/Template_Import_Customer_HTX586.xlsx" download="Template_Import_Customer_HTX586.xlsx"
                           Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                           Disabled="@(_readingImportFile || _importing)">Tải mẫu</MudButton>
                <MudFileUpload @ref="_fileUpload" T="IBrowserFile"
                               Accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                               FilesChanged="ReadImportFileAsync" MaximumFileCount="1"
                               Disabled="@(_readingImportFile || _importing)">
                    <CustomContent Context="upload">
                        <MudButton Color="Color.Success" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                                   Disabled="@(_readingImportFile || _importing)" OnClick="@upload.OpenFilePickerAsync">
                            @(_readingImportFile ? "Đang đọc..." : "Import Excel")
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(_readingImportFile || _importing)" OnClick="NewCustomer">Thêm khách hàng</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_importPreview is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <div>
                <MudText Typo="Typo.h6">Kiểm tra import khách hàng</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_importPreview.FileName</MudText>
            </div>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Disabled="_importing" OnClick="CancelImport" />
        </MudStack>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Tổng @_importPreview.TotalRows</MudChip>
            <MudChip T="string" Color="Color.Success">Hợp lệ @_importPreview.ValidRows</MudChip>
            <MudChip T="string" Color="@(_importPreview.InvalidRows > 0 ? Color.Error : Color.Default)" Variant="Variant.Outlined">Lỗi @_importPreview.InvalidRows</MudChip>
        </MudStack>
        <MudAlert Severity="@(_importPreview.InvalidRows > 0 ? Severity.Warning : Severity.Success)" Variant="Variant.Outlined" Class="mb-3">
            @(_importPreview.InvalidRows > 0 ? "Chỉ các dòng hợp lệ được import. Dữ liệu được ghi nhận theo tài khoản đang thao tác." : "Toàn bộ dữ liệu hợp lệ, có thể xác nhận import.")
        </MudAlert>
        <MudTable T="CustomerImportRowPreview" Items="_importPreview.Rows" Dense="true" Hover="true" Striped="true" RowsPerPage="10" Loading="_importing">
            <HeaderContent>
                <MudTh>Dòng</MudTh>
                <MudTh>Loại</MudTh>
                <MudTh>Khách hàng</MudTh>
                <MudTh>Điện thoại</MudTh>
                <MudTh>CCCD/MST</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh>Lỗi</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.RowNumber</MudTd>
                <MudTd>@context.TypeDisplay</MudTd>
                <MudTd><b>@context.DisplayName</b><br /><small>@context.FullName</small></MudTd>
                <MudTd>@context.PhoneNumber</MudTd>
                <MudTd>@(context.Type == CustomerType.Organization ? context.TaxCode : context.CitizenId)</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.IsValid ? Color.Success : Color.Error)">@(context.IsValid ? "Hợp lệ" : "Lỗi")</MudChip></MudTd>
                <MudTd><MudText Typo="Typo.caption" Color="Color.Error">@context.ErrorMessage</MudText></MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 10, 20, 50, 100 })" /></PagerContent>
        </MudTable>
        <MudStack Row="true" Class="mt-4">
            <MudButton Variant="Variant.Outlined" Disabled="_importing" OnClick="CancelImport">Hủy</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Publish"
                       Disabled="@(_importing || _importPreview.ValidRows == 0)" OnClick="ConfirmImportAsync">
                @(_importing ? "Đang import..." : $"Import {_importPreview.ValidRows} khách hàng")
            </MudButton>
        </MudStack>
    </MudPaper>
}

@if (_editing)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Class="mb-4" Spacing="2">
            <div>
                <MudText Typo="Typo.h6">@(_model.Id == Guid.Empty ? "Thêm khách hàng" : "Cập nhật khách hàng")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Thiết lập theo 2 nhóm: thông tin pháp lý/chính và thông tin liên hệ/phụ.</MudText>
            </div>
            <MudSpacer />
            <MudPaper Class="pa-3" Outlined="true" Elevation="0" Style="min-width:260px;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Người tạo</MudText>
                <MudText Typo="Typo.subtitle1">@_creatorName</MudText>
            </MudPaper>
        </MudStack>

        <MudPaper Class="pa-3 mb-4" Outlined="true" Elevation="0">
            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2">
                <MudCheckBox T="bool" @bind-Value="IsOrganization" Label="Khách hàng là công ty/đơn vị/tổ chức" Color="Color.Primary" />
                <MudChip T="string" Size="Size.Small" Color="@(IsOrganization ? Color.Info : Color.Default)" Variant="Variant.Outlined">
                    @(IsOrganization ? "Đơn vị/Tổ chức" : "Cá nhân")
                </MudChip>
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                Khi bật chế độ công ty, hệ thống hiển thị thêm Tên đơn vị/Tổ chức và Mã số thuế. Các thông tin còn lại được hiểu là của người đại diện.
            </MudText>
        </MudPaper>

        @if (IsOrganization)
        {
            <MudPaper Class="pa-4 mb-4" Outlined="true" Elevation="0">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Thông tin đơn vị/tổ chức</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">Chỉ hiển thị khi khách hàng là công ty/đơn vị.</MudText>
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_model.OrganizationName" Label="Tên đơn vị/Tổ chức" Required="true" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_model.TaxCode" Label="Mã số thuế" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <MudGrid>
            <MudItem xs="12" lg="7">
                <MudPaper Class="pa-4 h-100" Outlined="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">Nhóm chính</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">Thông tin người đại diện/khách hàng phục vụ đối chiếu trên hợp đồng.</MudText>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.FullName" Label="@RepresentativeNameLabel" Required="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.CitizenId" Label="@RepresentativeCitizenLabel" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudDatePicker @bind-Date="_model.CitizenIdIssuedDate" Label="Ngày cấp CCCD" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Placeholder="dd/MM/yyyy" Culture="@AppCulture.Vietnamese" AutoClose="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_model.CitizenIdIssuedPlace" Label="Nơi cấp CCCD" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudDatePicker @bind-Date="_model.DateOfBirth" Label="Ngày sinh" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Placeholder="dd/MM/yyyy" Culture="@AppCulture.Vietnamese" AutoClose="true" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" lg="5">
                <MudPaper Class="pa-4 h-100" Outlined="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">Nhóm phụ</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">Thông tin liên hệ và địa chỉ. Nếu là công ty thì địa chỉ có thể là địa chỉ công ty.</MudText>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.PhoneNumber" Label="Số điện thoại" Required="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.Address" Label="Địa chỉ" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Class="mt-4">
            <MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Hủy</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">Lưu khách hàng</MudButton>
        </MudStack>
    </MudPaper>
}

<MudPaper Class="pa-4" Elevation="1">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-3">
        <div>
            <MudText Typo="Typo.h6">Danh mục khách hàng</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Hiển thị toàn bộ các cột quan trọng. Có thể tìm theo họ tên đại diện, tên đơn vị hoặc số điện thoại.</MudText>
        </div>
        <MudSpacer />
        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Tổng: @_items.Count</MudChip>
    </MudStack>

    <div style="overflow-x:auto;">
        <MudTable T="CustomerRow" Items="FilteredItems" Loading="_loading" Hover="true" Striped="true" Dense="true" RowsPerPage="20" Breakpoint="Breakpoint.None">
            <HeaderContent>
                <MudTh>Loại</MudTh>
                <MudTh>Tên đơn vị/Tổ chức</MudTh>
                <MudTh>Họ tên đại diện</MudTh>
                <MudTh>Số điện thoại</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>CCCD người đại diện</MudTh>
                <MudTh>Ngày cấp CCCD</MudTh>
                <MudTh>Nơi cấp</MudTh>
                <MudTh>Ngày sinh</MudTh>
                <MudTh>Mã số thuế</MudTh>
                <MudTh>Địa chỉ</MudTh>
                <MudTh>Người tạo</MudTh>
                <MudTh>Số HĐ</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Loại">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Type == CustomerType.Organization ? Color.Info : Color.Default)" Variant="Variant.Outlined">
                        @(context.Type == CustomerType.Organization ? "Đơn vị/Tổ chức" : "Cá nhân")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Tên đơn vị/Tổ chức">@(string.IsNullOrWhiteSpace(context.OrganizationName) ? "-" : context.OrganizationName)</MudTd>
                <MudTd DataLabel="Họ tên đại diện"><b>@context.FullName</b></MudTd>
                <MudTd DataLabel="Số điện thoại">@context.PhoneNumber</MudTd>
                <MudTd DataLabel="Email">@(string.IsNullOrWhiteSpace(context.Email) ? "-" : context.Email)</MudTd>
                <MudTd DataLabel="CCCD người đại diện">@(string.IsNullOrWhiteSpace(context.CitizenId) ? "-" : context.CitizenId)</MudTd>
                <MudTd DataLabel="Ngày cấp CCCD">@FormatDate(context.CitizenIdIssuedDate)</MudTd>
                <MudTd DataLabel="Nơi cấp">@(string.IsNullOrWhiteSpace(context.CitizenIdIssuedPlace) ? "-" : context.CitizenIdIssuedPlace)</MudTd>
                <MudTd DataLabel="Ngày sinh">@FormatDate(context.DateOfBirth)</MudTd>
                <MudTd DataLabel="Mã số thuế">@(string.IsNullOrWhiteSpace(context.TaxCode) ? "-" : context.TaxCode)</MudTd>
                <MudTd DataLabel="Địa chỉ">@(string.IsNullOrWhiteSpace(context.Address) ? "-" : context.Address)</MudTd>
                <MudTd DataLabel="Người tạo">@context.CreatorName</MudTd>
                <MudTd DataLabel="Số HĐ">@context.ContractCount</MudTd>
                <MudTd DataLabel="Tác vụ">
                    <MudStack Row="true" Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => EditAsync(context.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Id))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-4">Chưa có khách hàng.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="_pageSizeOptions" /></PagerContent>
        </MudTable>
    </div>
</MudPaper>

@code {
    private static readonly int[] _pageSizeOptions = [10, 20, 50, 100];
    private bool _loading;
    private bool _saving;
    private bool _editing;
    private bool _readingImportFile;
    private bool _importing;
    private string? _keyword;
    private string _currentUserId = string.Empty;
    private string _currentUserName = string.Empty;
    private bool _isOwner;
    private HashSet<Guid> _managedCompanyProfileIds = [];
    private string _creatorName = string.Empty;
    private List<CustomerRow> _items = [];
    private Customer _model = NewModel();
    private CustomerImportPreview? _importPreview;
    private MudFileUpload<IBrowserFile>? _fileUpload;

    private bool IsOrganization
    {
        get => _model.Type == CustomerType.Organization;
        set
        {
            _model.Type = value ? CustomerType.Organization : CustomerType.Individual;
            if (!value)
            {
                _model.OrganizationName = null;
                _model.TaxCode = null;
            }
        }
    }

    private string RepresentativeNameLabel => IsOrganization ? "Họ tên người đại diện" : "Họ tên khách hàng";
    private string RepresentativeCitizenLabel => IsOrganization ? "CCCD người đại diện" : "CCCD khách hàng";

    private IEnumerable<CustomerRow> FilteredItems => string.IsNullOrWhiteSpace(_keyword)
        ? _items
        : _items.Where(x => Contains(x.FullName) || Contains(x.OrganizationName) || Contains(x.PhoneNumber));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        _isOwner = auth.User.IsInRole("Owner");

        await using (var db = await Factory.CreateDbContextAsync())
        {
            var currentUser = await db.Users.AsNoTracking()
                .Where(x => x.Id == _currentUserId && !x.IsDeleted && x.IsActive)
                .Select(x => new { x.FullName })
                .FirstOrDefaultAsync();

            _currentUserName = currentUser?.FullName ?? auth.User.Identity?.Name ?? "Tài khoản hiện tại";
            if (!_isOwner)
            {
                _managedCompanyProfileIds = await db.AdminOffices.AsNoTracking()
                    .Where(x => x.AdminUserId == _currentUserId && x.IsActive && !x.IsDeleted &&
                                x.CompanyProfile.IsActive && !x.CompanyProfile.IsDeleted)
                    .Select(x => x.CompanyProfileId)
                    .ToHashSetAsync();
            }
        }

        if (!_isOwner && _managedCompanyProfileIds.Count == 0)
            Snackbar.Add("Tài khoản Quản lý chưa được phân quyền Công ty/Văn phòng.", Severity.Warning);

        await LoadAsync();
    }

    private async Task ReadImportFileAsync(IBrowserFile? file)
    {
        if (_readingImportFile || _importing) return;
        _readingImportFile = true; _importPreview = null; _editing = false;
        try
        {
            if (file is null) return;
            if (string.IsNullOrWhiteSpace(_currentUserId)) throw new InvalidOperationException("Không xác định được tài khoản đang đăng nhập.");
            await using var stream = file.OpenReadStream(CustomerExcelImportService.MaximumFileSize);
            using var memory = new MemoryStream(); await stream.CopyToAsync(memory); memory.Position = 0;
            _importPreview = await CustomerImportService.PreviewAsync(memory, file.Name, _currentUserId);
            Snackbar.Add($"Đã kiểm tra {_importPreview.TotalRows} dòng: {_importPreview.ValidRows} hợp lệ, {_importPreview.InvalidRows} lỗi.", _importPreview.InvalidRows == 0 ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { if (_fileUpload is not null) await _fileUpload.ClearAsync(); _readingImportFile = false; }
    }

    private async Task ConfirmImportAsync()
    {
        if (_importPreview is null || _importPreview.ValidRows == 0 || _importing) return;
        _importing = true;
        try
        {
            var original = _importPreview;
            var result = await CustomerImportService.ImportAsync(original.Rows, _currentUserId);
            var failedRows = result.Errors.Select(x => x.RowNumber).ToHashSet();
            foreach (var error in result.Errors)
            {
                var row = original.Rows.FirstOrDefault(x => x.RowNumber == error.RowNumber);
                if (row is not null) ExcelImportUtility.AddError(row.Errors, error.Error);
            }
            original.Rows = original.Rows.Where(x => !x.IsValid || failedRows.Contains(x.RowNumber)).ToList();
            if (result.ImportedCount > 0) await LoadAsync();
            Snackbar.Add($"Đã import {result.ImportedCount} khách hàng; {result.FailedCount} dòng lỗi khi lưu.", result.FailedCount == 0 ? Severity.Success : Severity.Warning);
            if (original.Rows.Count == 0) CancelImport();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _importing = false; }
    }

    private void CancelImport() => _importPreview = null;

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            var query = db.Customers.AsNoTracking().Where(x => !x.IsDeleted && !x.PhoneNumber.StartsWith("PEND"));
            query = ApplyScope(query, db);

            _items = await query.OrderByDescending(x => x.LastUsedAt ?? x.CreatedAt)
                .Select(x => new CustomerRow
                {
                    Id = x.Id,
                    Type = x.Type,
                    FullName = x.FullName,
                    OrganizationName = x.OrganizationName,
                    PhoneNumber = x.PhoneNumber,
                    Email = x.Email,
                    CitizenId = x.CitizenId,
                    CitizenIdIssuedDate = x.CitizenIdIssuedDate,
                    CitizenIdIssuedPlace = x.CitizenIdIssuedPlace,
                    DateOfBirth = x.DateOfBirth,
                    TaxCode = x.TaxCode,
                    Address = x.Address,
                    CreatorName = x.CreatedByDriver.FullName,
                    ContractCount = x.Contracts.Count
                }).ToListAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void NewCustomer()
    {
        _model = NewModel();
        _model.CreatedByDriverId = _currentUserId;
        _creatorName = _currentUserName;
        _editing = true;
    }

    private async Task EditAsync(Guid id)
    {
        await using var db = await Factory.CreateDbContextAsync();
        var query = ApplyScope(db.Customers.AsNoTracking().Where(x => !x.IsDeleted && !x.PhoneNumber.StartsWith("PEND")), db);
        var entity = await query.FirstOrDefaultAsync(x => x.Id == id);
        if (entity is null)
        {
            Snackbar.Add("Không tìm thấy khách hàng hoặc khách hàng nằm ngoài phạm vi quản lý.", Severity.Warning);
            return;
        }

        _model = entity;
        _creatorName = await db.Users.AsNoTracking()
            .Where(x => x.Id == entity.CreatedByDriverId)
            .Select(x => x.FullName)
            .FirstOrDefaultAsync() ?? "Không xác định";
        _editing = true;
    }

    private void CancelEdit() { _editing = false; _model = NewModel(); _creatorName = string.Empty; }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.FullName) || string.IsNullOrWhiteSpace(_model.PhoneNumber))
        {
            Snackbar.Add("Vui lòng nhập họ tên và số điện thoại.", Severity.Warning);
            return;
        }

        if (IsOrganization && string.IsNullOrWhiteSpace(_model.OrganizationName))
        {
            Snackbar.Add("Khách hàng là công ty/đơn vị thì bắt buộc nhập Tên đơn vị/Tổ chức.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            Snackbar.Add("Không xác định được tài khoản đang đăng nhập.", Severity.Error);
            return;
        }

        _saving = true;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            Customer? entity = null;
            if (_model.Id != Guid.Empty)
            {
                var scopedQuery = ApplyScope(db.Customers.Where(x => !x.IsDeleted), db);
                entity = await scopedQuery.FirstOrDefaultAsync(x => x.Id == _model.Id);
                if (entity is null)
                    throw new InvalidOperationException("Khách hàng nằm ngoài phạm vi quản lý hoặc đã bị xóa.");
            }

            if (entity is null)
            {
                entity = new Customer
                {
                    Id = Guid.NewGuid(),
                    CreatedByDriverId = _currentUserId,
                    CreatedBy = _currentUserId,
                    CreatedAt = DateTime.UtcNow
                };
                db.Customers.Add(entity);
            }

            Map(entity, _model);
            entity.UpdatedAt = DateTime.UtcNow;
            entity.UpdatedBy = _currentUserId;
            await db.SaveChangesAsync();
            Snackbar.Add("Đã lưu khách hàng.", Severity.Success);
            _editing = false;
            _creatorName = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            var query = ApplyScope(db.Customers.Where(x => !x.IsDeleted), db);
            var entity = await query.FirstOrDefaultAsync(x => x.Id == id);
            if (entity is null)
            {
                Snackbar.Add("Không tìm thấy khách hàng hoặc khách hàng nằm ngoài phạm vi quản lý.", Severity.Warning);
                return;
            }
            entity.IsDeleted = true;
            entity.DeletedAt = DateTime.UtcNow;
            entity.DeletedBy = _currentUserId;
            entity.UpdatedAt = DateTime.UtcNow;
            entity.UpdatedBy = _currentUserId;
            await db.SaveChangesAsync();
            Snackbar.Add("Đã ẩn khách hàng. Các hợp đồng cũ không bị thay đổi.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private IQueryable<Customer> ApplyScope(IQueryable<Customer> query, ApplicationDbContext db)
    {
        if (_isOwner)
            return query;

        if (_managedCompanyProfileIds.Count == 0)
            return query.Where(_ => false);

        return query.Where(x =>
            x.CreatedByDriverId == _currentUserId ||
            x.Contracts.Any(c => _managedCompanyProfileIds.Contains(c.CompanyProfileId)) ||
            db.Vehicles.Any(v => !v.IsDeleted && v.AssignedDriverId == x.CreatedByDriverId &&
                v.OfficeVehicles.Any(ov => ov.IsActive && !ov.IsDeleted && ov.AssignedTo == null &&
                                           _managedCompanyProfileIds.Contains(ov.CompanyProfileId))));
    }

    private bool Contains(string? value) => !string.IsNullOrWhiteSpace(value) && value.Contains(_keyword!.Trim(), StringComparison.OrdinalIgnoreCase);
    private static Customer NewModel() => new() { Type = CustomerType.Individual };
    private static void Map(Customer target, Customer source)
    {
        target.Type = source.Type;
        target.FullName = source.FullName.Trim();
        target.OrganizationName = source.Type == CustomerType.Organization ? N(source.OrganizationName) : null;
        target.TaxCode = source.Type == CustomerType.Organization ? N(source.TaxCode) : null;
        target.PhoneNumber = source.PhoneNumber.Trim();
        target.CitizenId = N(source.CitizenId);
        target.CitizenIdIssuedDate = source.CitizenIdIssuedDate?.Date;
        target.CitizenIdIssuedPlace = N(source.CitizenIdIssuedPlace);
        target.DateOfBirth = source.DateOfBirth?.Date;
        target.Address = N(source.Address);
        target.Email = N(source.Email);
    }
    private static string? N(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string FormatDate(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "-";

    private sealed class CustomerRow
    {
        public Guid Id { get; set; }
        public CustomerType Type { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string? OrganizationName { get; set; }
        public string PhoneNumber { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? CitizenId { get; set; }
        public DateTime? CitizenIdIssuedDate { get; set; }
        public string? CitizenIdIssuedPlace { get; set; }
        public DateTime? DateOfBirth { get; set; }
        public string? TaxCode { get; set; }
        public string? Address { get; set; }
        public string CreatorName { get; set; } = string.Empty;
        public int ContractCount { get; set; }
    }
}
