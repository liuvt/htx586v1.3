@page "/admin/pdf-layout-designer"
@attribute [Authorize(Roles = "Owner,Admin")]
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text.Json.Serialization
@inject PdfLayoutDesignerService LayoutDesignerService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>PDF Layout Designer</PageTitle>
<PageHeader Title="PDF Layout Designer" Subtitle="Một JSON dùng chung cho HĐ hành khách + HĐ hàng hóa. Hỗ trợ kéo/thả, resize 4 góc, dữ liệu mẫu và tinh chỉnh tọa độ theo point." />

@if (_loading)
{
    <MudPaper Class="pa-6">
        <MudProgressCircular Indeterminate="true" />
        <MudText Class="mt-3">Đang tải template PDF và layout...</MudText>
    </MudPaper>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
}
else if (_document is not null)
{
    <MudGrid Spacing="3">
        <MudItem xs="12" lg="3">
            <MudPaper Class="pa-3 designer-panel" Elevation="1">
                <MudText Typo="Typo.h6">Công cụ</MudText>

                <MudSelect T="PdfLayoutDesignerContractType"
                           Label="Loại hợp đồng"
                           Dense="true"
                           Class="mt-2"
                           Value="@_contractType"
                           ValueChanged="ChangeContractTypeAsync"
                           Disabled="@_saving">
                    <MudSelectItem T="PdfLayoutDesignerContractType" Value="@PdfLayoutDesignerContractType.Passenger">HĐ vận chuyển hành khách</MudSelectItem>
                    <MudSelectItem T="PdfLayoutDesignerContractType" Value="@PdfLayoutDesignerContractType.Cargo">HĐ vận chuyển hàng hóa</MudSelectItem>
                </MudSelect>

                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Đang chỉnh: <b>@_document.ContractTypeName</b>
                </MudAlert>
                <MudText Typo="Typo.caption" Class="d-block mt-2">PDF: @_document.TemplateFileName</MudText>
                <MudText Typo="Typo.caption" Class="d-block">JSON dùng chung: @_document.LayoutFileName</MudText>
                <MudText Typo="Typo.caption" Class="d-block">Layout: @_document.LayoutPath</MudText>

                <MudDivider Class="my-3" />

                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@_saving" OnClick="SaveAsync">
                        Lưu JSON
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_saving" OnClick="ReloadAsync">
                        Tải lại
                    </MudButton>
                </MudStack>

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2">Hiển thị & tinh chỉnh</MudText>
                <MudStack Spacing="0" Class="mt-1">
                    <MudCheckBox T="bool" Label="Hiển thị dữ liệu mẫu" Value="@_showSampleText" ValueChanged="SetShowSampleTextAsync" />
                    <MudCheckBox T="bool" Label="Hiển thị khung field" Value="@_showFieldBoxes" ValueChanged="SetShowFieldBoxesAsync" />
                    <MudCheckBox T="bool" Label="Hiển thị tất cả field" Value="@_showAllFields" ValueChanged="SetShowAllFieldsAsync" />
                    <MudCheckBox T="bool" Label="Tâm/crosshair field đang chọn" Value="@_showCrosshair" ValueChanged="SetShowCrosshairAsync" />
                    <MudCheckBox T="bool" Label="Snap theo lưới khi kéo" Value="@_snapToGrid" ValueChanged="SetSnapToGridAsync" />
                </MudStack>

                <MudGrid Spacing="2" Class="mt-1">
                    <MudItem xs="6">
                        <MudNumericField T="double" Label="Lưới (pt)" Margin="Margin.Dense" Value="@_gridSize" ValueChanged="SetGridSizeAsync" Step="0.05" Min="0.01" Immediate="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="double" Label="Bước phím (pt)" Margin="Margin.Dense" Value="@_nudgeStep" ValueChanged="SetNudgeStepAsync" Step="0.05" Min="0.01" Immediate="true" />
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mt-2">Zoom</MudText>
                <MudStack Row="true" Spacing="1" Class="mt-1">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ZoomOutAsync">-</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ResetZoomAsync">@($"{_zoom:0.00}x")</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ZoomInAsync">+</MudButton>
                </MudStack>

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2">Field</MudText>
                <MudSelect T="string" Label="Chọn field" Dense="true" Value="@_selectedFieldId" ValueChanged="SelectFieldFromListAsync" Class="mt-2">
                    @foreach (var group in _fields.GroupBy(x => x.Page).OrderBy(x => x.Key))
                    {
                        <MudSelectItem T="string" Disabled="true" Value="@($"PAGE-{group.Key}")">--- Trang @group.Key ---</MudSelectItem>
                        @foreach (var field in group.OrderBy(x => x.Kind).ThenBy(x => x.Y).ThenBy(x => x.X))
                        {
                            <MudSelectItem T="string" Value="@field.Id">@field.DisplayName</MudSelectItem>
                        }
                    }
                </MudSelect>

                @if (_selectedField is not null)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2">Vị trí chính xác (PDF point)</MudText>

                    <MudGrid Spacing="2" Class="mt-1">
                        <MudItem xs="6">
                            <MudNumericField T="double" Label="X" Margin="Margin.Dense" Value="@_selectedField.X" ValueChanged="SetXAsync" Step="0.1" Immediate="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="double" Label="Y" Margin="Margin.Dense" Value="@_selectedField.Y" ValueChanged="SetYAsync" Step="0.1" Immediate="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="double" Label="Rộng" Margin="Margin.Dense" Value="@_selectedField.Width" ValueChanged="SetWidthAsync" Step="0.1" Immediate="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="double" Label="Cao" Margin="Margin.Dense" Value="@_selectedField.Height" ValueChanged="SetHeightAsync" Step="0.1" Immediate="true" />
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.caption" Class="d-block mt-2">Di chuyển @($"{_nudgeStep:0.##}")pt/lần</MudText>
                    <div class="pdf-designer-nudge-grid">
                        <span></span>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MoveUpAsync">↑</MudButton>
                        <span></span>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MoveLeftAsync">←</MudButton>
                        <div class="center-info">X/Y</div>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MoveRightAsync">→</MudButton>
                        <span></span>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MoveDownAsync">↓</MudButton>
                        <span></span>
                    </div>

                    <MudStack Row="true" Spacing="1" Class="mt-2">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="WidthMinusAsync">W−</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="WidthPlusAsync">W+</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="HeightMinusAsync">H−</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="HeightPlusAsync">H+</MudButton>
                    </MudStack>

                    @if (_selectedField.Kind == DesignerFieldKind.Text)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2">Text</MudText>

                        <MudGrid Spacing="2" Class="mt-1">
                            <MudItem xs="6">
                                <MudNumericField T="float" Label="Cỡ chữ" Margin="Margin.Dense" Value="@_selectedField.FontSize" ValueChanged="SetFontSizeAsync" Step="0.1f" Immediate="true" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField T="float" Label="Cỡ chữ nhỏ nhất" Margin="Margin.Dense" Value="@_selectedField.MinFontSize" ValueChanged="SetMinFontSizeAsync" Step="0.1f" Immediate="true" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField T="int" Label="Số dòng" Margin="Margin.Dense" Value="@_selectedField.MaxLines" ValueChanged="SetMaxLinesAsync" Min="1" Max="20" Immediate="true" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudSelect T="string" Label="Canh ngang" Dense="true" Value="@_selectedField.Alignment" ValueChanged="SetAlignmentAsync">
                                    <MudSelectItem T="string" Value="@("Left")">Left</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Center")">Center</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Right")">Right</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudSelect T="string" Label="Canh dọc" Dense="true" Value="@_selectedField.VerticalAlignment" ValueChanged="SetVerticalAlignmentAsync">
                                    <MudSelectItem T="string" Value="@("Top")">Top</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Center")">Center</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Bottom")">Bottom</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>

                        <MudStack Row="true" Spacing="1" Class="mt-2" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.caption">Cỡ nhanh:</MudText>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="FontSizeMinusAsync">A−</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SetFontSize10Async">10</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SetFontSize11Async">11</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SetFontSize1125Async">11.25</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="FontSizePlusAsync">A+</MudButton>
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="d-block mt-1">Rộng/Cao ở phía trên chỉnh kích thước vùng text hoặc vùng chữ ký; Cỡ chữ chỉ áp dụng cho field text.</MudText>

                        <MudStack Spacing="0" Class="mt-2">
                            <MudCheckBox T="bool" Label="In đậm" Value="@_selectedField.Bold" ValueChanged="SetBoldAsync" />
                            <MudCheckBox T="bool" Label="In nghiêng" Value="@_selectedField.Italic" ValueChanged="SetItalicAsync" />
                            <MudCheckBox T="bool" Label="Viết hoa" Value="@_selectedField.Uppercase" ValueChanged="SetUppercaseAsync" />
                            <MudCheckBox T="bool" Label="Che nền trắng trước khi vẽ" Value="@_selectedField.ClearBackground" ValueChanged="SetClearBackgroundAsync" />
                        </MudStack>
                    }
                    else
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2">Ảnh / chữ ký</MudText>
                        <MudSelect T="string" Label="Fit" Dense="true" Value="@_selectedField.Fit" ValueChanged="SetFitAsync" Class="mt-2">
                            <MudSelectItem T="string" Value="@("Contain")">Contain</MudSelectItem>
                        </MudSelect>
                    }

                    <MudDivider Class="my-3" />
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Kéo field để đổi X/Y, kéo 4 góc để resize. Khi field đang focus: phím mũi tên = di chuyển; Shift = x5; Ctrl = tinh chỉnh 1/5 bước; Alt + mũi tên = resize.
                    </MudAlert>
                }

                <MudDivider Class="my-3" />
                <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="ToggleAdvancedJsonAsync">
                    @(_showAdvancedJson ? "Ẩn JSON nâng cao" : "Chỉnh JSON nâng cao")
                </MudButton>

                @if (_showAdvancedJson)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        JSON bên dưới là layout của loại HĐ đang chọn. Khi bấm Áp dụng, hệ thống kiểm tra JSON rồi cập nhật preview; khi Lưu JSON, layout này được ghi vào file dùng chung.
                    </MudAlert>
                    <MudTextField T="string"
                                  Label="Layout JSON"
                                  Class="mt-2 pdf-designer-json-editor"
                                  Variant="Variant.Outlined"
                                  Lines="18"
                                  Immediate="true"
                                  Value="@_rawLayoutJson"
                                  ValueChanged="SetRawLayoutJson" />
                    <MudStack Row="true" Spacing="1" Class="mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ApplyRawJsonAsync">Áp dụng JSON</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="RefreshRawJsonAsync">Làm mới</MudButton>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="9">
            <MudPaper Class="pa-3 designer-workspace" Elevation="1">
                <div class="pdf-layout-designer-toolbar">
                    <MudText Typo="Typo.subtitle2">Preview: @_document.ContractTypeName</MudText>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@_fields.Count field</MudChip>
                </div>

                <div @ref="_designerHost" class="pdf-layout-designer-host"></div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly JsonSerializerOptions RawJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        WriteIndented = true,
        ReadCommentHandling = JsonCommentHandling.Skip,
        AllowTrailingCommas = true
    };

    private PdfLayoutDesignerDocument? _document;
    private DotNetObjectReference<PdfLayoutDesigner>? _dotNetReference;
    private ElementReference _designerHost;
    private readonly List<DesignerFieldView> _fields = [];
    private DesignerFieldView? _selectedField;
    private string? _selectedFieldId;
    private bool _loading = true;
    private bool _saving;
    private bool _designerInitialized;
    private string? _errorMessage;
    private double _zoom = 1.25d;
    private PdfLayoutDesignerContractType _contractType = PdfLayoutDesignerContractType.Passenger;

    private bool _showSampleText = true;
    private bool _showFieldBoxes = true;
    private bool _showAllFields = true;
    private bool _showCrosshair = true;
    private bool _snapToGrid = true;
    private double _gridSize = 0.25d;
    private double _nudgeStep = 0.25d;
    private bool _showAdvancedJson;
    private string _rawLayoutJson = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocumentAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_designerInitialized && _document is not null && !_loading)
        {
            _dotNetReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "htxPdfLayoutDesigner.init",
                _designerHost,
                _document.TemplateBase64,
                _fields,
                _dotNetReference,
                _zoom,
                BuildDesignerOptions());
            _designerInitialized = true;
        }
    }

    private async Task LoadDocumentAsync()
    {
        try
        {
            _loading = true;
            _errorMessage = null;
            _document = await LayoutDesignerService.LoadAsync(_contractType);
            RebuildFields();
            _selectedField = _fields.FirstOrDefault();
            _selectedFieldId = _selectedField?.Id;
            RefreshRawLayoutJson();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        await JS.InvokeVoidAsync("htxPdfLayoutDesigner.destroy", _designerHost);
        _designerInitialized = false;
        _dotNetReference?.Dispose();
        _dotNetReference = null;
        await LoadDocumentAsync();
    }

    private async Task ReinitializeDesignerAsync()
    {
        if (_document is null)
            return;

        await JS.InvokeVoidAsync("htxPdfLayoutDesigner.destroy", _designerHost);
        _dotNetReference ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync(
            "htxPdfLayoutDesigner.init",
            _designerHost,
            _document.TemplateBase64,
            _fields,
            _dotNetReference,
            _zoom,
            BuildDesignerOptions());
        _designerInitialized = true;
    }

    private async Task ChangeContractTypeAsync(PdfLayoutDesignerContractType contractType)
    {
        if (_saving || contractType == _contractType)
            return;

        _contractType = contractType;
        _selectedField = null;
        _selectedFieldId = null;
        await ReloadAsync();
    }

    private void RebuildFields()
    {
        _fields.Clear();
        if (_document is null)
            return;

        _fields.AddRange(_document.Layout.TextFields.Select(x => DesignerFieldView.FromText(x)));
        _fields.AddRange(_document.Layout.ImageFields.Select(x => DesignerFieldView.FromImage(x)));
    }

    private void ApplyFieldsToLayout()
    {
        if (_document is null)
            return;

        foreach (var field in _fields)
        {
            if (field.Kind == DesignerFieldKind.Text)
            {
                var target = _document.Layout.TextFields.FirstOrDefault(x => MakeId(DesignerFieldKind.Text, x.Page, x.Key) == field.Id);
                if (target is null)
                    continue;

                target.Page = field.Page;
                target.X = Round(field.X);
                target.Y = Round(field.Y);
                target.Width = Round(field.Width);
                target.Height = Round(field.Height);
                target.FontSize = field.FontSize;
                target.MinFontSize = field.MinFontSize;
                target.MaxLines = field.MaxLines;
                target.Alignment = field.Alignment;
                target.VerticalAlignment = NormalizeVerticalAlignment(field.VerticalAlignment);
                target.Bold = field.Bold;
                target.Italic = field.Italic;
                target.Uppercase = field.Uppercase;
                target.ClearBackground = field.ClearBackground;
            }
            else
            {
                var target = _document.Layout.ImageFields.FirstOrDefault(x => MakeId(DesignerFieldKind.Image, x.Page, x.Key) == field.Id);
                if (target is null)
                    continue;

                target.Page = field.Page;
                target.X = Round(field.X);
                target.Y = Round(field.Y);
                target.Width = Round(field.Width);
                target.Height = Round(field.Height);
                target.Fit = field.Fit;
            }
        }
    }

    private async Task SaveAsync()
    {
        if (_document is null)
            return;

        try
        {
            _saving = true;
            ApplyFieldsToLayout();
            await LayoutDesignerService.SaveLayoutAsync(_contractType, _document.Layout);
            RefreshRawLayoutJson();
            Snackbar.Add($"Đã lưu {_document.ContractTypeName} vào JSON dùng chung và tự tạo file backup.", Severity.Success);
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add($"Không có quyền ghi file JSON: {ex.Message}. Hãy cấp quyền ghi thư mục Templates/Contracts cho user chạy service.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lưu layout thất bại: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SelectFieldFromListAsync(string? fieldId)
    {
        if (string.IsNullOrWhiteSpace(fieldId) || fieldId.StartsWith("PAGE-", StringComparison.OrdinalIgnoreCase))
            return;

        _selectedFieldId = fieldId;
        _selectedField = _fields.FirstOrDefault(x => x.Id == fieldId);
        await JS.InvokeVoidAsync("htxPdfLayoutDesigner.selectField", _designerHost, fieldId);
    }

    [JSInvokable]
    public Task OnDesignerFieldSelected(string fieldId)
    {
        _selectedFieldId = fieldId;
        _selectedField = _fields.FirstOrDefault(x => x.Id == fieldId);
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnDesignerFieldChanged(PdfLayoutDesignerFieldUpdate update)
    {
        var field = _fields.FirstOrDefault(x => x.Id == update.Id);
        if (field is null)
            return Task.CompletedTask;

        field.X = Round(update.X);
        field.Y = Round(update.Y);
        field.Width = Math.Max(2, Round(update.Width));
        field.Height = Math.Max(2, Round(update.Height));

        _selectedField = field;
        _selectedFieldId = field.Id;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task PushSelectedFieldAsync()
    {
        if (_selectedField is null)
            return;

        _selectedField.X = Math.Max(0, Round(_selectedField.X));
        _selectedField.Y = Math.Max(0, Round(_selectedField.Y));
        _selectedField.Width = Math.Max(2, Round(_selectedField.Width));
        _selectedField.Height = Math.Max(2, Round(_selectedField.Height));

        await JS.InvokeVoidAsync("htxPdfLayoutDesigner.updateField", _designerHost, _selectedField);
    }

    private async Task SetXAsync(double value)
    {
        if (_selectedField is null) return;
        _selectedField.X = Math.Max(0, value);
        await PushSelectedFieldAsync();
    }

    private async Task SetYAsync(double value)
    {
        if (_selectedField is null) return;
        _selectedField.Y = Math.Max(0, value);
        await PushSelectedFieldAsync();
    }

    private async Task SetWidthAsync(double value)
    {
        if (_selectedField is null) return;
        _selectedField.Width = Math.Max(2, value);
        await PushSelectedFieldAsync();
    }

    private async Task SetHeightAsync(double value)
    {
        if (_selectedField is null) return;
        _selectedField.Height = Math.Max(2, value);
        await PushSelectedFieldAsync();
    }

    private async Task SetFontSizeAsync(float value)
    {
        if (_selectedField is null) return;
        _selectedField.FontSize = Math.Max(1, value);
        if (_selectedField.MinFontSize > _selectedField.FontSize)
            _selectedField.MinFontSize = _selectedField.FontSize;
        await PushSelectedFieldAsync();
    }

    private async Task SetMinFontSizeAsync(float value)
    {
        if (_selectedField is null) return;
        _selectedField.MinFontSize = Math.Clamp(value, 1, _selectedField.FontSize);
        await PushSelectedFieldAsync();
    }

    private Task FontSizeMinusAsync()
        => _selectedField is null
            ? Task.CompletedTask
            : SetFontSizeAsync(Math.Max(1f, _selectedField.FontSize - 0.25f));

    private Task FontSizePlusAsync()
        => _selectedField is null
            ? Task.CompletedTask
            : SetFontSizeAsync(_selectedField.FontSize + 0.25f);

    private Task SetFontSize10Async()
        => _selectedField is null ? Task.CompletedTask : SetFontSizeAsync(10f);

    private Task SetFontSize11Async()
        => _selectedField is null ? Task.CompletedTask : SetFontSizeAsync(11f);

    private Task SetFontSize1125Async()
        => _selectedField is null ? Task.CompletedTask : SetFontSizeAsync(11.25f);

    private async Task SetMaxLinesAsync(int value)
    {
        if (_selectedField is null) return;
        _selectedField.MaxLines = Math.Max(1, value);
        await PushSelectedFieldAsync();
    }

    private async Task SetAlignmentAsync(string value)
    {
        if (_selectedField is null) return;
        _selectedField.Alignment = value;
        await PushSelectedFieldAsync();
    }

    private async Task SetVerticalAlignmentAsync(string value)
    {
        if (_selectedField is null) return;
        _selectedField.VerticalAlignment = NormalizeVerticalAlignment(value);
        await PushSelectedFieldAsync();
    }

    private async Task SetBoldAsync(bool value)
    {
        if (_selectedField is null) return;
        _selectedField.Bold = value;
        await PushSelectedFieldAsync();
    }

    private async Task SetItalicAsync(bool value)
    {
        if (_selectedField is null) return;
        _selectedField.Italic = value;
        await PushSelectedFieldAsync();
    }

    private async Task SetUppercaseAsync(bool value)
    {
        if (_selectedField is null) return;
        _selectedField.Uppercase = value;
        await PushSelectedFieldAsync();
    }

    private async Task SetClearBackgroundAsync(bool value)
    {
        if (_selectedField is null) return;
        _selectedField.ClearBackground = value;
        await PushSelectedFieldAsync();
    }

    private async Task SetFitAsync(string value)
    {
        if (_selectedField is null) return;
        _selectedField.Fit = string.IsNullOrWhiteSpace(value) ? "Contain" : value;
        await PushSelectedFieldAsync();
    }

    private async Task MoveLeftAsync() => await NudgeAsync(-_nudgeStep, 0);
    private async Task MoveRightAsync() => await NudgeAsync(_nudgeStep, 0);
    private async Task MoveUpAsync() => await NudgeAsync(0, -_nudgeStep);
    private async Task MoveDownAsync() => await NudgeAsync(0, _nudgeStep);

    private async Task NudgeAsync(double dx, double dy)
    {
        if (_selectedField is null) return;
        _selectedField.X = Math.Max(0, _selectedField.X + dx);
        _selectedField.Y = Math.Max(0, _selectedField.Y + dy);
        await PushSelectedFieldAsync();
    }

    private async Task WidthMinusAsync() => await ResizeSelectedAsync(-_nudgeStep, 0);
    private async Task WidthPlusAsync() => await ResizeSelectedAsync(_nudgeStep, 0);
    private async Task HeightMinusAsync() => await ResizeSelectedAsync(0, -_nudgeStep);
    private async Task HeightPlusAsync() => await ResizeSelectedAsync(0, _nudgeStep);

    private async Task ResizeSelectedAsync(double widthDelta, double heightDelta)
    {
        if (_selectedField is null) return;
        _selectedField.Width = Math.Max(2, _selectedField.Width + widthDelta);
        _selectedField.Height = Math.Max(2, _selectedField.Height + heightDelta);
        await PushSelectedFieldAsync();
    }

    private async Task ZoomInAsync()
    {
        _zoom = Math.Min(3d, _zoom + 0.1d);
        await JS.InvokeVoidAsync("htxPdfLayoutDesigner.setZoom", _designerHost, _zoom);
    }

    private async Task ZoomOutAsync()
    {
        _zoom = Math.Max(0.5d, _zoom - 0.1d);
        await JS.InvokeVoidAsync("htxPdfLayoutDesigner.setZoom", _designerHost, _zoom);
    }

    private async Task ResetZoomAsync()
    {
        _zoom = 1.25d;
        await JS.InvokeVoidAsync("htxPdfLayoutDesigner.setZoom", _designerHost, _zoom);
    }

