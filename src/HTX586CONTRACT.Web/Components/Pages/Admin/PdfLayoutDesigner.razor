    private Task ToggleAdvancedJsonAsync()
    {
        _showAdvancedJson = !_showAdvancedJson;
        if (_showAdvancedJson)
            RefreshRawLayoutJson();
        return Task.CompletedTask;
    }

    private Task SetRawLayoutJson(string value)
    {
        _rawLayoutJson = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task RefreshRawJsonAsync()
    {
        ApplyFieldsToLayout();
        RefreshRawLayoutJson();
        return Task.CompletedTask;
    }

    private void RefreshRawLayoutJson()
    {
        if (_document is null)
        {
            _rawLayoutJson = string.Empty;
            return;
        }

        _rawLayoutJson = JsonSerializer.Serialize(_document.Layout, RawJsonOptions);
    }

    private async Task ApplyRawJsonAsync()
    {
        if (_document is null)
            return;

        try
        {
            var layout = JsonSerializer.Deserialize<PdfTemplateLayoutDto>(_rawLayoutJson, RawJsonOptions)
                ?? throw new InvalidOperationException("JSON rỗng hoặc không đúng cấu trúc layout.");

            ValidateLayout(layout);
            NormalizeLayout(layout);
            _document.Layout = layout;
            RebuildFields();
            _selectedField = _fields.FirstOrDefault();
            _selectedFieldId = _selectedField?.Id;
            RefreshRawLayoutJson();
            await ReinitializeDesignerAsync();
            Snackbar.Add("Đã áp dụng JSON vào preview. Bấm Lưu JSON để ghi vào file dùng chung.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"JSON không hợp lệ: {ex.Message}", Severity.Error);
        }
    }

    private static void ValidateLayout(PdfTemplateLayoutDto layout)
    {
        if (layout.TextFields.Any(x => string.IsNullOrWhiteSpace(x.Key) || x.Page < 1 || x.Width <= 0 || x.Height <= 0))
            throw new InvalidOperationException("Có text field thiếu key/page hoặc kích thước không hợp lệ.");

        if (layout.ImageFields.Any(x => string.IsNullOrWhiteSpace(x.Key) || x.Page < 1 || x.Width <= 0 || x.Height <= 0))
            throw new InvalidOperationException("Có image field thiếu key/page hoặc kích thước không hợp lệ.");

        var duplicateText = layout.TextFields
            .GroupBy(x => $"{x.Page}:{x.Key}", StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault(x => x.Count() > 1);
        if (duplicateText is not null)
            throw new InvalidOperationException($"Text field bị trùng: {duplicateText.Key}.");

        var duplicateImage = layout.ImageFields
            .GroupBy(x => $"{x.Page}:{x.Key}", StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault(x => x.Count() > 1);
        if (duplicateImage is not null)
            throw new InvalidOperationException($"Image field bị trùng: {duplicateImage.Key}.");
    }

    private static void NormalizeLayout(PdfTemplateLayoutDto layout)
    {
        layout.FontFamily = string.IsNullOrWhiteSpace(layout.FontFamily) ? "Times New Roman" : layout.FontFamily.Trim();
        foreach (var field in layout.TextFields)
        {
            field.X = Math.Max(0, Round(field.X));
            field.Y = Math.Max(0, Round(field.Y));
            field.Width = Math.Max(2, Round(field.Width));
            field.Height = Math.Max(2, Round(field.Height));
            field.FontSize = Math.Max(1, field.FontSize);
            field.MinFontSize = Math.Clamp(field.MinFontSize, 1, field.FontSize);
            field.MaxLines = Math.Max(1, field.MaxLines);
            field.Alignment = NormalizeHorizontalAlignment(field.Alignment);
            field.VerticalAlignment = NormalizeVerticalAlignment(field.VerticalAlignment);
        }

        foreach (var field in layout.ImageFields)
        {
            field.X = Math.Max(0, Round(field.X));
            field.Y = Math.Max(0, Round(field.Y));
            field.Width = Math.Max(2, Round(field.Width));
            field.Height = Math.Max(2, Round(field.Height));
            field.Fit = string.IsNullOrWhiteSpace(field.Fit) ? "Contain" : field.Fit;
        }
    }

    private static string NormalizeHorizontalAlignment(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "center" => "Center",
            "right" => "Right",
            _ => "Left"
        };

    private static string NormalizeVerticalAlignment(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "top" => "Top",
            "bottom" => "Bottom",
            "middle" => "Center",
            "center" => "Center",
            _ => "Center"
        };

    private static string MakeId(DesignerFieldKind kind, int page, string key)
        => $"{kind.ToString().ToLowerInvariant()}:{page}:{key}";

    private static double Round(double value)
        => Math.Round(value, 2, MidpointRounding.AwayFromZero);

