@page "/admin/accounts/{UserId}"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IAdminAccountService AccountService
@inject MasterSignatureService MasterSignatureService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Chi tiết tài khoản</PageTitle>
<PageHeader Title="Chi tiết tài khoản" Subtitle="Bố cục lại theo từng vùng rõ ràng: tổng quan, thông tin cá nhân, phạm vi quản lý/sở hữu và chân ký." />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy tài khoản.</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudPaper Class="ent-hero-card" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudAvatar Size="Size.Large" Color="Color.Surface" Variant="Variant.Outlined" Class="hero-avatar" Style="color:#fff; border-color:rgba(255,255,255,.28); background:rgba(255,255,255,.12);">
                        @Initials(_detail.FullName)
                    </MudAvatar>

                    <div>
                        <MudText Typo="Typo.h5" Class="fw-700" Style="color:#fff;">@Display(_detail.FullName)</MudText>
                        <MudText Typo="Typo.body2" Class="ent-hero-subtitle">ID đăng nhập: @_detail.UserName</MudText>
                        <MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@SystemRoleDisplay.Name(_detail.Role)</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@(_detail.IsActive ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                                @(_detail.IsActive ? "Hoạt động" : "Đã khóa")
                            </MudChip>
                            @if (_detail.Role == SystemRoleDisplay.VehicleOwnerRole)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                    Sở hữu @_detail.VehicleCount xe
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                    Quản lý @Tokenize(_detail.OfficeNames).Count khu vực
                                </MudChip>
                            }
                        </MudStack>
                    </div>

                    <MudSpacer />

                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudPaper Class="ent-hero-metric" Elevation="0">
                            <span class="ent-hero-metric__label">Số điện thoại</span>
                            <strong class="ent-hero-metric__value">@Display(_detail.PhoneNumber)</strong>
                        </MudPaper>
                        <MudPaper Class="ent-hero-metric" Elevation="0">
                            <span class="ent-hero-metric__label">Mã nhân viên</span>
                            <strong class="ent-hero-metric__value">@Display(_detail.EmployeeCode)</strong>
                        </MudPaper>
                        <MudPaper Class="ent-hero-metric" Elevation="0">
                            <span class="ent-hero-metric__label">Mã khu vực</span>
                            <strong class="ent-hero-metric__value">@Display(_detail.AreaCode)</strong>
                        </MudPaper>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="ent-section-card fill-height" Elevation="0">
                <div class="ent-section-header">
                    <div class="ent-section-header__left">
                        <div class="ent-section-icon"><MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" /></div>
                        <div>
                            <MudText Class="ent-section-title">1. Thông tin định danh &amp; Liên hệ</MudText>
                            <MudText Class="ent-section-subtitle">Hồ sơ đăng nhập và thông tin liên lạc của tài khoản.</MudText>
                        </div>
                    </div>
                </div>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6"><InfoListItem Label="Tên đăng nhập" Value="@_detail.UserName" Icon="@Icons.Material.Filled.Person" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Vai trò hệ thống" Value="@SystemRoleDisplay.Name(_detail.Role)" Icon="@Icons.Material.Filled.AdminPanelSettings" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Họ và tên" Value="@Display(_detail.FullName)" Icon="@Icons.Material.Filled.Badge" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Số điện thoại" Value="@Display(_detail.PhoneNumber)" Icon="@Icons.Material.Filled.Phone" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Email" Value="@Display(_detail.Email)" Icon="@Icons.Material.Filled.Email" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Ngày sinh" Value="@DateText(_detail.DateOfBirth)" Icon="@Icons.Material.Filled.Cake" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Địa chỉ thường trú" Value="@Display(_detail.Address)" Icon="@Icons.Material.Filled.LocationOn" /></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="ent-section-card fill-height" Elevation="0">
                <div class="ent-section-header">
                    <div class="ent-section-header__left">
                        <div class="ent-section-icon"><MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" /></div>
                        <div>
                            <MudText Class="ent-section-title">2. Hồ sơ pháp lý &amp; Khu vực</MudText>
                            <MudText Class="ent-section-subtitle">Các trường giấy tờ định danh phục vụ in ấn hợp đồng vận tải.</MudText>
                        </div>
                    </div>
                </div>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6"><InfoListItem Label="Mã nhân viên" Value="@Display(_detail.EmployeeCode)" Icon="@Icons.Material.Filled.Pin" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Trạng thái tài khoản" Value="@(_detail.IsActive ? "Đang hoạt động" : "Đã khóa")" Icon="@Icons.Material.Filled.ToggleOn" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Số CCCD" Value="@Display(_detail.CitizenId)" Icon="@Icons.Material.Filled.CreditCard" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Ngày cấp CCCD" Value="@DateText(_detail.CitizenIdIssuedDate)" Icon="@Icons.Material.Filled.Event" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Nơi cấp CCCD" Value="@Display(_detail.CitizenIdIssuedPlace)" Icon="@Icons.Material.Filled.AccountBalance" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Mã khu vực" Value="@Display(_detail.AreaCode)" Icon="@Icons.Material.Filled.Place" /></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Class="ent-section-card fill-height" Elevation="0">
                <div class="ent-section-header">
                    <div class="ent-section-header__left">
                        <div class="ent-section-icon"><MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" /></div>
                        <div>
                            <MudText Class="ent-section-title">3. Phạm vi Công ty/Văn phòng &amp; Phương tiện</MudText>
                            <MudText Class="ent-section-subtitle">Danh sách đơn vị được phân quyền hoặc các phương tiện đang sở hữu.</MudText>
                        </div>
                    </div>
                </div>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Công ty / Văn phòng liên kết</MudText>
                @if (Tokenize(_detail.OfficeNames).Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">Chưa gán Công ty/Văn phòng.</MudAlert>
                }
                else
                {
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mb-4">
                        @foreach (var office in Tokenize(_detail.OfficeNames))
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Apartment">@office</MudChip>
                        }
                    </MudStack>
                }

                <MudText Typo="Typo.subtitle2" Class="mb-2">Danh sách biển số xe đang sở hữu</MudText>
                @if (Tokenize(_detail.VehiclePlates).Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">Chưa có xe được gán cho tài khoản này.</MudAlert>
                }
                else
                {
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var plate in Tokenize(_detail.VehiclePlates))
                        {
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.DirectionsCar">@plate</MudChip>
                        }
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Class="ent-section-card fill-height" Elevation="0">
                <div class="ent-section-header">
                    <div class="ent-section-header__left">
                        <div class="ent-section-icon"><MudIcon Icon="@Icons.Material.Filled.Draw" Size="Size.Small" /></div>
                        <div>
                            <MudText Class="ent-section-title">4. Chân ký Chủ xe cố định</MudText>
                            <MudText Class="ent-section-subtitle">Nguồn chân ký tự động đính kèm vào các hợp đồng mới.</MudText>
                        </div>
                    </div>
                </div>

                @if (_detail.Role == SystemRoleDisplay.VehicleOwnerRole)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                        Chữ ký mới sẽ cập nhật chân ký hiện hành trên tài khoản; các hợp đồng cũ đã khóa snapshot vẫn giữ nguyên chữ ký lịch sử.
                    </MudAlert>
                    <SignaturePad ExistingSignatureUrl="@SignatureUrl"
                                  SignerName="@_detail.FullName"
                                  SignedAt="@_detail.VehicleOwnerSignedAt"
                                  OnSignatureSaved="SaveVehicleOwnerSignatureAsync"
                                  ConfirmationButtonText="Lưu chân ký Chủ xe"
                                  SavedStatusText="Chân ký hiện tại" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Tài khoản Quản lý không sử dụng chân ký Chủ xe. Hợp đồng lấy chân ký từ tài khoản Chủ xe gắn với từng xe.
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="ent-action-bar" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/admin/accounts"))">Quay lại danh sách</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="@(_detail.IsActive ? Color.Warning : Color.Success)" Disabled="_working" OnClick="ToggleActiveAsync">
                        @(_detail.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline" Disabled="_working" OnClick="DeleteAsync">Xóa tài khoản</MudButton>
                    <MudSpacer />
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="@(() => Navigation.NavigateTo($"/admin/accounts/{UserId}/edit"))">Chỉnh sửa tài khoản</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<style>
    .detail-hero {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(15,118,110,0.08), rgba(59,130,246,0.05));
    }

    .hero-avatar {
        font-size: 1.1rem;
        font-weight: 700;
    }

    .metric-pill {
        min-width: 150px;
        border-radius: 16px;
        background: rgba(255,255,255,0.72);
        border: 1px solid rgba(15, 23, 42, 0.08);
    }

    .detail-section {
        border-radius: 22px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        background: #fff;
    }

    .fill-height {
        height: 100%;
    }
</style>

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
    private AdminAccountDetail? _detail;
    private bool _loading = true;
    private bool _working;
    private bool _isOwner;
    private string? _actorUserId;
    private string? SignatureUrl => string.IsNullOrWhiteSpace(_detail?.VehicleOwnerSignatureFileUrl)
        ? null
        : $"{_detail.VehicleOwnerSignatureFileUrl}?v={_detail.VehicleOwnerSignedAt?.Ticks ?? 0}";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _isOwner = auth.User.IsInRole("Owner");
            _actorUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
            _detail = await AccountService.GetDetailAsync(UserId);

            if (_detail is not null && !_isOwner && _detail.Role != SystemRoleDisplay.VehicleOwnerRole)
            {
                Snackbar.Add("Quản lý chỉ được thao tác tài khoản Chủ xe.", Severity.Warning);
                _detail = null;
                Navigation.NavigateTo("/admin/accounts");
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task SaveVehicleOwnerSignatureAsync(string dataUrl)
    {
        if (_detail is null || _detail.Role != SystemRoleDisplay.VehicleOwnerRole)
            return;

        try
        {
            await MasterSignatureService.SaveVehicleOwnerAccountSignatureAsync(UserId, dataUrl);
            Snackbar.Add("Đã cập nhật chân ký Chủ xe. Chân ký mới đã ghi đè trên tài khoản và sẽ được dùng cho các hợp đồng tạo sau.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            throw;
        }
    }

    private async Task ToggleActiveAsync()
    {
        if (_detail is null) return;
        _working = true;
        try
        {
            var result = await AccountService.SetActiveAsync(UserId, !_detail.IsActive, _actorUserId);
            var message = result.Message ?? (result.Succeeded
                ? "Đã cập nhật trạng thái tài khoản."
                : "Không thể cập nhật trạng thái tài khoản.");
            Snackbar.Add(message, result.Succeeded ? Severity.Success : Severity.Error);
            if (result.Succeeded) await LoadAsync();
        }
        finally { _working = false; }
    }

    private async Task DeleteAsync()
    {
        _working = true;
        try
        {
            var result = await AccountService.DeleteAsync(UserId, _actorUserId);
            var message = result.Message ?? (result.Succeeded
                ? "Đã xóa tài khoản."
                : "Không thể xóa tài khoản.");
            Snackbar.Add(message, result.Succeeded ? Severity.Success : Severity.Error);
            if (result.Succeeded) Navigation.NavigateTo("/admin/accounts");
        }
        finally { _working = false; }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DateText(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "—";

    private static string Initials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "TK";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();

        return string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }

    private static List<string> Tokenize(string? value) => string.IsNullOrWhiteSpace(value)
        ? new List<string>()
        : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
}
