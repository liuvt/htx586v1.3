@page "/admin/accounts/{UserId}"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IAdminAccountService AccountService
@inject MasterSignatureService MasterSignatureService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Chi tiết tài khoản</PageTitle>
<PageHeader Title="Chi tiết tài khoản" Subtitle="Thông tin chung, vai trò, văn phòng quản lý và xe sở hữu." />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy tài khoản.</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" md="4"><InfoListItem Label="Tên đăng nhập" Value="@_detail.UserName" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Vai trò" Value="@SystemRoleDisplay.Name(_detail.Role)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Trạng thái" Value="@(_detail.IsActive ? "Hoạt động" : "Đã khóa")" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Họ và tên" Value="@_detail.FullName" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Mã nhân viên" Value="@Display(_detail.EmployeeCode)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Số điện thoại" Value="@Display(_detail.PhoneNumber)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Email" Value="@Display(_detail.Email)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Ngày sinh" Value="@DateText(_detail.DateOfBirth)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Mã khu vực" Value="@Display(_detail.AreaCode)" /></MudItem>
            <MudItem xs="12"><InfoListItem Label="Công ty/Văn phòng" Value="@Display(_detail.OfficeNames)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="CCCD" Value="@Display(_detail.CitizenId)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Ngày cấp CCCD" Value="@DateText(_detail.CitizenIdIssuedDate)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Nơi cấp CCCD" Value="@Display(_detail.CitizenIdIssuedPlace)" /></MudItem>
            <MudItem xs="12"><InfoListItem Label="Địa chỉ" Value="@Display(_detail.Address)" /></MudItem>
            <MudItem xs="12" md="4"><InfoListItem Label="Số xe sở hữu" Value="@_detail.VehicleCount.ToString()" /></MudItem>
            <MudItem xs="12" md="8"><InfoListItem Label="Danh sách biển số" Value="@Display(_detail.VehiclePlates)" /></MudItem>

            @if (_detail.Role == SystemRoleDisplay.VehicleOwnerRole)
            {
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1">Chân ký Chủ xe</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Hợp đồng mới sẽ tự động lấy chân ký này. Có thể ký trực tiếp hoặc upload file PNG.
                    </MudText>
                    <SignaturePad ExistingSignatureUrl="@SignatureUrl"
                                  SignerName="@_detail.FullName"
                                  SignedAt="@_detail.VehicleOwnerSignedAt"
                                  OnSignatureSaved="SaveVehicleOwnerSignatureAsync"
                                  ConfirmationButtonText="Lưu chân ký Chủ xe" />
                </MudItem>
            }
        </MudGrid>

        <MudStack Row="true" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/admin/accounts"))">Quay lại</MudButton>
            <MudButton Variant="Variant.Outlined" Color="@(_detail.IsActive ? Color.Warning : Color.Success)" Disabled="_working" OnClick="ToggleActiveAsync">
                @(_detail.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_working" OnClick="DeleteAsync">Xóa tài khoản</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/admin/accounts/{UserId}/edit"))">Cập nhật</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
    private AdminAccountDetail? _detail;
    private bool _loading = true;
    private bool _working;
    private bool _isOwner;
    private string? _actorUserId;
    private string? SignatureUrl => string.IsNullOrWhiteSpace(_detail?.VehicleOwnerSignatureFileUrl)
        ? null
        : $"{_detail.VehicleOwnerSignatureFileUrl}?v={_detail.VehicleOwnerSignedAt?.Ticks ?? 0}";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _isOwner = auth.User.IsInRole("Owner");
            _actorUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
            _detail = await AccountService.GetDetailAsync(UserId);

            if (_detail is not null && !_isOwner && _detail.Role != SystemRoleDisplay.VehicleOwnerRole)
            {
                Snackbar.Add("Quản lý chỉ được thao tác tài khoản Chủ xe.", Severity.Warning);
                _detail = null;
                Navigation.NavigateTo("/admin/accounts");
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task SaveVehicleOwnerSignatureAsync(string dataUrl)
    {
        if (_detail is null || _detail.Role != SystemRoleDisplay.VehicleOwnerRole)
            return;

        try
        {
            await MasterSignatureService.SaveVehicleOwnerAccountSignatureAsync(UserId, dataUrl);
            Snackbar.Add("Đã lưu chân ký Chủ xe trên tài khoản. Các xe và hợp đồng mới sẽ lấy trực tiếp chân ký này.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            throw;
        }
    }

    private async Task ToggleActiveAsync()
    {
        if (_detail is null) return;
        _working = true;
        try
        {
            var result = await AccountService.SetActiveAsync(UserId, !_detail.IsActive, _actorUserId);
            var message = result.Message ?? (result.Succeeded
                ? "Đã cập nhật trạng thái tài khoản."
                : "Không thể cập nhật trạng thái tài khoản.");
            Snackbar.Add(message, result.Succeeded ? Severity.Success : Severity.Error);
            if (result.Succeeded) await LoadAsync();
        }
        finally { _working = false; }
    }

    private async Task DeleteAsync()
    {
        _working = true;
        try
        {
            var result = await AccountService.DeleteAsync(UserId, _actorUserId);
            var message = result.Message ?? (result.Succeeded
                ? "Đã xóa tài khoản."
                : "Không thể xóa tài khoản.");
            Snackbar.Add(message, result.Succeeded ? Severity.Success : Severity.Error);
            if (result.Succeeded) Navigation.NavigateTo("/admin/accounts");
        }
        finally { _working = false; }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DateText(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "—";
}
