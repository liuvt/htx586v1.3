@page "/admin/accounts/{UserId}/edit"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IAdminAccountService AccountService
@inject ICompanyProfileService CompanyProfileService
@inject MasterSignatureService MasterSignatureService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Cập nhật tài khoản</PageTitle>
<PageHeader Title="Cập nhật tài khoản" Subtitle="Cập nhật vai trò, hồ sơ và phạm vi Công ty/Văn phòng trong cùng một màn hình." />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_model is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy tài khoản.</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" md="4"><MudTextField T="string" Value="@_userName" Label="Tên đăng nhập" Disabled="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                @if (_isOwner)
                {
                    <MudSelect T="string" @bind-Value="_model.Role" Label="Vai trò" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@SystemRoleDisplay.AdminRole">Quản lý</MudSelectItem>
                        <MudSelectItem T="string" Value="@SystemRoleDisplay.VehicleOwnerRole">Chủ xe</MudSelectItem>
                    </MudSelect>
                }
                else
                {
                    <MudTextField T="string" Value="@VehicleOwnerRoleLabel" Label="Vai trò" Disabled="true" Variant="Variant.Outlined" />
                }
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Success" Label="Tài khoản hoạt động" /></MudItem>

            @if (_model.Role == SystemRoleDisplay.AdminRole)
            {
                <MudItem xs="12">
                    <MudSelect T="Guid" Label="Công ty/Văn phòng quản lý" MultiSelection="true" Required="true"
                               SelectedValues="_model.OfficeIds" SelectedValuesChanged="OnOfficeSelectionChanged"
                               Variant="Variant.Outlined" HelperText="Tài khoản Quản lý có thể quản lý nhiều Công ty/Văn phòng.">
                        @foreach (var office in _offices)
                        {
                            <MudSelectItem T="Guid" Value="@office.Id">@OfficeDisplay(office)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Chủ xe không gán trực tiếp văn phòng. Văn phòng được suy ra từ các xe sở hữu.
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.FullName" Label="Họ và tên" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.EmployeeCode" Label="Mã nhân viên" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.PhoneNumber" Label="Số điện thoại" Required="true" HelperText="@VietnamPhoneNumber.ValidationMessage" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.DateOfBirth" Label="Ngày sinh" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CitizenId" Label="CCCD" Required="@IsVehicleOwner" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.CitizenIdIssuedDate" Label="Ngày cấp CCCD" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Required="@IsVehicleOwner" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CitizenIdIssuedPlace" Label="Nơi cấp CCCD" Required="@IsVehicleOwner" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.AreaCode" Label="Mã khu vực" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_model.MustChangePassword" Color="Color.Warning" Label="Bắt buộc đổi mật khẩu" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Address" Label="Địa chỉ" Required="@IsVehicleOwner" Variant="Variant.Outlined" /></MudItem>

            @if (IsVehicleOwner)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                        Các xe đang chọn tài khoản này làm Chủ xe sẽ được đồng bộ hồ sơ pháp lý sau khi lưu. Chân ký luôn được lấy trực tiếp từ tài khoản Chủ xe.
                    </MudAlert>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1">Chân ký Chủ xe</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Hợp đồng mới sẽ tự động lấy chân ký này theo tài khoản Chủ xe.
                    </MudText>
                    @if (_originalRole == SystemRoleDisplay.VehicleOwnerRole)
                    {
                        <SignaturePad ExistingSignatureUrl="@SignatureUrl"
                                      SignerName="@_model.FullName"
                                      StrokeColor="#0066CC"
                                      StrokeWidth="1.5"
                                      SignedAt="@_detail?.VehicleOwnerSignedAt"
                                      OnSignatureSaved="SaveVehicleOwnerSignatureAsync"
                                      ConfirmationButtonText="Lưu chân ký Chủ xe" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">
                            Hãy lưu thay đổi vai trò thành Chủ xe trước, sau đó mở lại tài khoản để tạo chân ký.
                        </MudAlert>
                    }
                </MudItem>
            }
        </MudGrid>

        <MudStack Row="true" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo($"/admin/accounts/{UserId}"))">Quay lại</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_saving" OnClick="ResetPasswordAsync">Reset mật khẩu</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">Lưu thay đổi</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    private string VehicleOwnerRoleLabel => SystemRoleDisplay.Name(SystemRoleDisplay.VehicleOwnerRole);

    [Parameter] public string UserId { get; set; } = string.Empty;
    private UpdateAdminAccountRequest? _model;
    private AdminAccountDetail? _detail;
    private IReadOnlyList<CompanyProfileOptionDto> _offices = [];
    private string _userName = string.Empty;
    private string _originalRole = string.Empty;
    private bool _loading = true;
    private bool _saving;
    private bool _isOwner;
    private string? _actorUserId;
    private bool IsVehicleOwner => _model?.Role == SystemRoleDisplay.VehicleOwnerRole;
    private string? SignatureUrl => string.IsNullOrWhiteSpace(_detail?.VehicleOwnerSignatureFileUrl)
        ? null
        : $"{_detail.VehicleOwnerSignatureFileUrl}?v={_detail.VehicleOwnerSignedAt?.Ticks ?? 0}";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _isOwner = auth.User.IsInRole("Owner");
            _actorUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (_isOwner)
                _offices = await CompanyProfileService.GetActiveOptionsAsync();

            _detail = await AccountService.GetDetailAsync(UserId);
            if (_detail is null) { _model = null; return; }
            if (!_isOwner && _detail.Role != SystemRoleDisplay.VehicleOwnerRole)
            {
                Snackbar.Add("Quản lý chỉ được cập nhật tài khoản Chủ xe.", Severity.Warning);
                _model = null;
                Navigation.NavigateTo("/admin/accounts");
                return;
            }
            _userName = _detail.UserName;
            _originalRole = _detail.Role;
            _model = new UpdateAdminAccountRequest
            {
                UserId = _detail.Id,
                Role = _detail.Role,
                OfficeIds = _detail.OfficeIds.ToHashSet(),
                FullName = _detail.FullName,
                EmployeeCode = _detail.EmployeeCode,
                PhoneNumber = _detail.PhoneNumber,
                Email = _detail.Email,
                CitizenId = _detail.CitizenId,
                CitizenIdIssuedDate = _detail.CitizenIdIssuedDate,
                CitizenIdIssuedPlace = _detail.CitizenIdIssuedPlace,
                DateOfBirth = _detail.DateOfBirth,
                Address = _detail.Address,
                AreaCode = _detail.AreaCode,
                IsActive = _detail.IsActive,
                MustChangePassword = _detail.MustChangePassword
            };
            _model.UpdatedByUserId = _actorUserId;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); _model = null; }
        finally { _loading = false; }
    }

    private void OnOfficeSelectionChanged(IEnumerable<Guid> values)
    {
        if (_model is not null) _model.OfficeIds = values.ToHashSet();
    }

    private async Task SaveVehicleOwnerSignatureAsync(string dataUrl)
    {
        if (_model is null || _originalRole != SystemRoleDisplay.VehicleOwnerRole)
            return;

        try
        {
            await MasterSignatureService.SaveVehicleOwnerAccountSignatureAsync(UserId, dataUrl);
            Snackbar.Add("Đã lưu chân ký Chủ xe trên tài khoản. Các xe và hợp đồng mới sẽ lấy trực tiếp chân ký này.", Severity.Success);
            _detail = await AccountService.GetDetailAsync(UserId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            throw;
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;
        _saving = true;
        try
        {
            if (!_isOwner)
                _model.Role = SystemRoleDisplay.VehicleOwnerRole;
            var result = await AccountService.UpdateAccountAsync(_model);
            var message = result.Message ?? (result.Succeeded
                ? "Đã cập nhật tài khoản."
                : "Không thể cập nhật tài khoản.");
            Snackbar.Add(message, result.Succeeded ? Severity.Success : Severity.Error);
            if (result.Succeeded) Navigation.NavigateTo($"/admin/accounts/{UserId}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task ResetPasswordAsync()
    {
        _saving = true;
        try
        {
            var result = await AccountService.ResetPasswordToDefaultAsync(UserId, _actorUserId);
            var message = result.Message ?? (result.Succeeded
                ? "Đã đặt lại mật khẩu mặc định."
                : "Không thể đặt lại mật khẩu.");
            Snackbar.Add(message, result.Succeeded ? Severity.Success : Severity.Error);
        }
        finally { _saving = false; }
    }

    private static string OfficeDisplay(CompanyProfileOptionDto x) =>
        string.IsNullOrWhiteSpace(x.BranchName) ? $"{x.CompanyName} ({x.TaxCode})" : $"{x.CompanyName} - {x.BranchName} ({x.TaxCode})";
}
