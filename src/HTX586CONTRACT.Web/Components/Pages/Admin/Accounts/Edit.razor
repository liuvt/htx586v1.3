@page "/admin/accounts/{UserId}/edit"
@attribute [Authorize(Roles = "Owner")]
@inject IAdminAccountService AccountService
@inject ICompanyProfileService CompanyProfileService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Cập nhật tài khoản</PageTitle>
<PageHeader Title="Cập nhật tài khoản" Subtitle="Đổi vai trò, thông tin hồ sơ và phạm vi Công ty/Văn phòng trong cùng một màn hình." />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_model is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy tài khoản.</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" md="4"><MudTextField T="string" Value="@_userName" Label="Tên đăng nhập" Disabled="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_model.Role" Label="Vai trò" Required="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("Admin")">Admin</MudSelectItem>
                    <MudSelectItem T="string" Value="@("VehicleOwner")">VehicleOwner</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Success" Label="Tài khoản hoạt động" /></MudItem>

            @if (_model.Role == "Admin")
            {
                <MudItem xs="12">
                    <MudSelect T="Guid" Label="Công ty/Văn phòng quản lý" MultiSelection="true" Required="true"
                               SelectedValues="_model.OfficeIds" SelectedValuesChanged="OnOfficeSelectionChanged"
                               Variant="Variant.Outlined">
                        @foreach (var office in _offices)
                        {
                            <MudSelectItem T="Guid" Value="@office.Id">@OfficeDisplay(office)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        VehicleOwner không gán trực tiếp văn phòng. Văn phòng được suy ra từ các xe sở hữu.
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.FullName" Label="Họ và tên" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.EmployeeCode" Label="Mã nhân viên" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.PhoneNumber" Label="Số điện thoại" Required="true" HelperText="@VietnamPhoneNumber.ValidationMessage" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.DateOfBirth" Label="Ngày sinh" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CitizenId" Label="CCCD" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.CitizenIdIssuedDate" Label="Ngày cấp CCCD" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CitizenIdIssuedPlace" Label="Nơi cấp CCCD" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.AreaCode" Label="Mã khu vực" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Address" Label="Địa chỉ" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.DriverLicenseNumber" Label="Số GPLX" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.DriverLicenseClass" Label="Hạng GPLX" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.DriverLicenseIssuedDate" Label="Ngày cấp GPLX" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.DriverLicenseExpiryDate" Label="Ngày hết hạn GPLX" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_model.MustChangePassword" Color="Color.Warning" Label="Bắt buộc đổi mật khẩu" /></MudItem>
        </MudGrid>

        <MudStack Row="true" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo($"/admin/accounts/{UserId}"))">Quay lại</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_saving" OnClick="ResetPasswordAsync">Reset mật khẩu</MudButton>
            <MudSpacer />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">Lưu thay đổi</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
    private UpdateAdminAccountRequest? _model;
    private IReadOnlyList<CompanyProfileOptionDto> _offices = [];
    private string _userName = string.Empty;
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _offices = await CompanyProfileService.GetActiveOptionsAsync();
            var detail = await AccountService.GetDetailAsync(UserId);
            if (detail is null) { _model = null; return; }
            _userName = detail.UserName;
            _model = new UpdateAdminAccountRequest
            {
                UserId = detail.Id,
                Role = detail.Role,
                OfficeIds = detail.OfficeIds.ToHashSet(),
                FullName = detail.FullName,
                EmployeeCode = detail.EmployeeCode,
                PhoneNumber = detail.PhoneNumber,
                Email = detail.Email,
                CitizenId = detail.CitizenId,
                CitizenIdIssuedDate = detail.CitizenIdIssuedDate,
                CitizenIdIssuedPlace = detail.CitizenIdIssuedPlace,
                DateOfBirth = detail.DateOfBirth,
                Address = detail.Address,
                AreaCode = detail.AreaCode,
                DriverLicenseNumber = detail.DriverLicenseNumber,
                DriverLicenseClass = detail.DriverLicenseClass,
                DriverLicenseIssuedDate = detail.DriverLicenseIssuedDate,
                DriverLicenseExpiryDate = detail.DriverLicenseExpiryDate,
                IsActive = detail.IsActive,
                MustChangePassword = detail.MustChangePassword
            };
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _model.UpdatedByUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); _model = null; }
        finally { _loading = false; }
    }

    private void OnOfficeSelectionChanged(IEnumerable<Guid> values)
    {
        if (_model is not null) _model.OfficeIds = values.ToHashSet();
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;
        _saving = true;
        try
        {
            var result = await AccountService.UpdateAccountAsync(_model);
            var message = result.Message ?? (result.Succeeded
                ? "Đã cập nhật tài khoản."
                : "Không thể cập nhật tài khoản.");
            Snackbar.Add(message, result.Succeeded ? Severity.Success : Severity.Error);
            if (result.Succeeded) Navigation.NavigateTo($"/admin/accounts/{UserId}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task ResetPasswordAsync()
    {
        _saving = true;
        try
        {
            var result = await AccountService.ResetPasswordToDefaultAsync(UserId);
            var message = result.Message ?? (result.Succeeded
                ? "Đã đặt lại mật khẩu mặc định."
                : "Không thể đặt lại mật khẩu.");
            Snackbar.Add(message, result.Succeeded ? Severity.Success : Severity.Error);
        }
        finally { _saving = false; }
    }

    private static string OfficeDisplay(CompanyProfileOptionDto x) =>
        string.IsNullOrWhiteSpace(x.BranchName) ? $"{x.CompanyName} ({x.TaxCode})" : $"{x.CompanyName} - {x.BranchName} ({x.TaxCode})";
}
