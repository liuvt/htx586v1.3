@page "/admin/accounts/create"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IAdminAccountService AccountService
@inject ICompanyProfileService CompanyProfileService
@inject MasterSignatureService MasterSignatureService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Tạo tài khoản</PageTitle>
<PageHeader Title="Tạo tài khoản" Subtitle="@HeaderSubtitle" />

<MudPaper Class="pa-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="4">
            @if (_isOwner)
            {
                <MudSelect T="string" Value="@_model.Role" ValueChanged="OnRoleChanged" Label="Vai trò" Required="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@SystemRoleDisplay.AdminRole">Quản lý</MudSelectItem>
                    <MudSelectItem T="string" Value="@SystemRoleDisplay.VehicleOwnerRole">Chủ xe</MudSelectItem>
                </MudSelect>
            }
            else
            {
                <MudTextField T="string" Value="@VehicleOwnerRoleLabel" Label="Vai trò" Disabled="true" Variant="Variant.Outlined" />
            }
        </MudItem>

        @if (_model.Role == SystemRoleDisplay.AdminRole)
        {
            <MudItem xs="12" md="8">
                <MudSelect T="Guid" Label="Công ty/Văn phòng quản lý" MultiSelection="true" Required="true"
                           SelectedValues="_model.OfficeIds" SelectedValuesChanged="OnOfficeSelectionChanged"
                           Variant="Variant.Outlined" HelperText="Tài khoản Quản lý có thể quản lý nhiều Công ty/Văn phòng.">
                    @foreach (var office in _offices)
                    {
                        <MudSelectItem T="Guid" Value="@office.Id">@OfficeDisplay(office)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
        else
        {
            <MudItem xs="12" md="8">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Chủ xe không gán trực tiếp văn phòng. Văn phòng được xác định theo xe được gán sau này.
                </MudAlert>
            </MudItem>
        }

        <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.UserName" Label="Tên đăng nhập" Required="true" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.Password" Label="Mật khẩu" Required="true" InputType="InputType.Password" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.EmployeeCode" Label="Mã nhân viên" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.FullName" Label="Họ và tên" Required="true" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.PhoneNumber" Label="Số điện thoại" Required="true" HelperText="@VietnamPhoneNumber.ValidationMessage" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.DateOfBirth" Label="Ngày sinh" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CitizenId" Label="CCCD" Required="@IsVehicleOwner" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.CitizenIdIssuedDate" Label="Ngày cấp CCCD" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Required="@IsVehicleOwner" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CitizenIdIssuedPlace" Label="Nơi cấp CCCD" Required="@IsVehicleOwner" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.AreaCode" Label="Mã khu vực" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_model.MustChangePassword" Color="Color.Warning" Label="Bắt buộc đổi mật khẩu lần đầu" /></MudItem>
        <MudItem xs="12"><MudTextField @bind-Value="_model.Address" Label="Địa chỉ" Required="@IsVehicleOwner" Variant="Variant.Outlined" /></MudItem>

        @if (IsVehicleOwner)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                    Họ tên, số điện thoại, CCCD, ngày cấp, nơi cấp và địa chỉ là hồ sơ pháp lý của Chủ xe và sẽ được dùng khi gán tài khoản này cho xe.
                </MudAlert>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudText Typo="Typo.subtitle1">Chân ký Chủ xe</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Có thể khai báo chân ký ngay khi tạo tài khoản. Nếu để trống, Chủ xe sẽ được yêu cầu tạo chân ký ở lần đăng nhập đầu tiên.
                </MudText>
                <SignaturePad ExistingSignatureUrl="@_vehicleOwnerSignatureDataUrl"
                              SignerName="@_model.FullName"
                              StrokeColor="#0066CC"
                              StrokeWidth="1.5"
                              OnSignatureSaved="CaptureVehicleOwnerSignatureAsync"
                              OnSavedSignatureRemoved="ClearCapturedVehicleOwnerSignatureAsync"
                              AllowRemoveSavedSignature="true"
                              SavedStatusText="Đã nhận chân ký"
                              ConfirmationButtonText="Xác nhận chân ký Chủ xe" />
            </MudItem>
        }
    </MudGrid>

    <MudStack Row="true" Class="mt-4">
        <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/admin/accounts"))">Quay lại</MudButton>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_saving || !_initialized)" OnClick="CreateAsync">
            @(_saving ? "Đang tạo..." : "Tạo tài khoản")
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private string VehicleOwnerRoleLabel => SystemRoleDisplay.Name(SystemRoleDisplay.VehicleOwnerRole);

    private CreateAdminAccountRequest _model = new();
    private IReadOnlyList<CompanyProfileOptionDto> _offices = [];
    private bool _saving;
    private bool _initialized;
    private bool _isOwner;
    private string? _vehicleOwnerSignatureDataUrl;
    private bool IsVehicleOwner => _model.Role == SystemRoleDisplay.VehicleOwnerRole;
    private string HeaderSubtitle => _isOwner
        ? "Tạo tài khoản Quản lý hoặc Chủ xe."
        : "Tạo tài khoản Chủ xe thuộc phạm vi vận hành của Quản lý.";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isOwner = auth.User.IsInRole("Owner");
        var isAdmin = auth.User.IsInRole("Admin");
        _model.CreatedByUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!_isOwner && !isAdmin)
        {
            Navigation.NavigateTo("/account/access-denied", true);
            return;
        }

        // Quản lý chỉ được tạo tài khoản Chủ xe. Owner mới được tạo thêm Quản lý.
        _model.Role = _isOwner ? SystemRoleDisplay.AdminRole : SystemRoleDisplay.VehicleOwnerRole;
        if (_isOwner)
            _offices = await CompanyProfileService.GetActiveOptionsAsync();

        _initialized = true;
    }

    private Task OnRoleChanged(string role)
    {
        if (!_isOwner)
            role = SystemRoleDisplay.VehicleOwnerRole;

        _model.Role = role;
        if (role != SystemRoleDisplay.AdminRole)
            _model.OfficeIds.Clear();
        if (role != SystemRoleDisplay.VehicleOwnerRole)
            _vehicleOwnerSignatureDataUrl = null;
        return Task.CompletedTask;
    }

    private void OnOfficeSelectionChanged(IEnumerable<Guid> values) => _model.OfficeIds = values.ToHashSet();

    private Task CaptureVehicleOwnerSignatureAsync(string dataUrl)
    {
        _vehicleOwnerSignatureDataUrl = dataUrl;
        Snackbar.Add("Đã nhận chân ký Chủ xe. Chân ký sẽ được lưu sau khi tài khoản được tạo thành công.", Severity.Success);
        return Task.CompletedTask;
    }

    private Task ClearCapturedVehicleOwnerSignatureAsync()
    {
        _vehicleOwnerSignatureDataUrl = null;
        return Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        if (_saving || !_initialized)
            return;

        // Hồ sơ định danh tối thiểu của Chủ xe phải có trước khi tạo tài khoản.
        // Required trên MudBlazor chủ yếu phục vụ UI; kiểm tra thủ công ở đây để
        // người dùng nhận lỗi ngay, đồng thời backend vẫn kiểm tra lại lần nữa.
        if (IsVehicleOwner)
        {
            if (string.IsNullOrWhiteSpace(_model.FullName))
            {
                Snackbar.Add("Tài khoản Chủ xe bắt buộc nhập Họ và tên.", Severity.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(_model.CitizenId))
            {
                Snackbar.Add("Tài khoản Chủ xe bắt buộc nhập số CCCD.", Severity.Warning);
                return;
            }

            if (!_model.CitizenIdIssuedDate.HasValue)
            {
                Snackbar.Add("Tài khoản Chủ xe bắt buộc nhập Ngày cấp CCCD.", Severity.Warning);
                return;
            }
        }

        _saving = true;
        try
        {
            // Không tin dữ liệu Role từ client: Admin luôn chỉ tạo VehicleOwner.
            if (!_isOwner)
                _model.Role = SystemRoleDisplay.VehicleOwnerRole;

            var result = await AccountService.CreateAccountAsync(_model);
            var signatureDataUrl = _vehicleOwnerSignatureDataUrl;
            var signatureSaved = false;

            if (result.Role == SystemRoleDisplay.VehicleOwnerRole && !string.IsNullOrWhiteSpace(signatureDataUrl))
            {
                try
                {
                    await MasterSignatureService.SaveVehicleOwnerAccountSignatureAsync(result.UserId, signatureDataUrl);
                    signatureSaved = true;
                }
                catch (Exception ex)
                {
                    // Tài khoản đã tạo hợp lệ. Không xóa tài khoản chỉ vì file chữ ký tạm thời lỗi;
                    // Chủ xe vẫn có thể khai báo lại ở lần đăng nhập đầu hoặc người quản lý bổ sung ở trang chi tiết.
                    Snackbar.Add($"Tài khoản đã được tạo nhưng chưa lưu được chân ký: {ex.Message}", Severity.Warning);
                }
            }

            if (result.Role == SystemRoleDisplay.VehicleOwnerRole)
            {
                Snackbar.Add(
                    signatureSaved
                        ? "Đã tạo tài khoản Chủ xe và lưu chân ký thành công."
                        : "Đã tạo tài khoản Chủ xe. Tài khoản chưa có chân ký sẽ được yêu cầu ký ở lần đăng nhập đầu tiên.",
                    signatureSaved ? Severity.Success : Severity.Warning);
            }
            else
            {
                Snackbar.Add("Đã tạo tài khoản Quản lý.", Severity.Success);
            }

            Navigation.NavigateTo($"/admin/accounts/{result.UserId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string OfficeDisplay(CompanyProfileOptionDto x) =>
        string.IsNullOrWhiteSpace(x.BranchName) ? $"{x.CompanyName} ({x.TaxCode})" : $"{x.CompanyName} - {x.BranchName} ({x.TaxCode})";
}
