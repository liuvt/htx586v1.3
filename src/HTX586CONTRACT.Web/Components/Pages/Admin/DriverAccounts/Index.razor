@page "/admin/vehicle-owner-accounts"
@page "/admin/driver-accounts"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDriverAccountService Service
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Tài khoản VehicleOwner</PageTitle>
<PageHeader Title="Tài khoản VehicleOwner" Subtitle="Một tài khoản có thể được cấp nhiều xe thuộc nhiều công ty/văn phòng khác nhau." />

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField T="string" Value="@_filter.Keyword"
                  Placeholder="Tìm ID, họ tên, điện thoại, biển số..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  DebounceInterval="350"
                  ValueChanged="@((string value) => OnKeywordChanged(value))"
                  Style="min-width:300px" />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => Navigation.NavigateTo("/admin/vehicle-owner-accounts/create"))">
        Thêm tài khoản
    </MudButton>
</MudStack>

<MudPaper Class="pa-2" Elevation="1">
    <MudTable Items="_items" Loading="_loading" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="20">
        <HeaderContent>
            <MudTh>Tài khoản</MudTh>
            <MudTh>Liên hệ</MudTh>
            <MudTh>Xe được cấp</MudTh>
            <MudTh>Công ty/văn phòng theo xe</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tài khoản">
                <b>@context.FullName</b><br />
                <MudText Typo="Typo.caption">@context.UserName</MudText>
            </MudTd>
            <MudTd DataLabel="Liên hệ">@context.PhoneNumber</MudTd>
            <MudTd DataLabel="Xe được cấp">
                <MudChip T="string" Size="Size.Small" Color="@(context.VehicleCount > 0 ? Color.Primary : Color.Default)">
                    @context.VehicleCount xe
                </MudChip>
                <div class="text-secondary mt-1">@Display(context.VehiclePlates)</div>
            </MudTd>
            <MudTd DataLabel="Công ty/văn phòng">@Display(context.CompanyNames)</MudTd>
            <MudTd DataLabel="Trạng thái">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Error)">
                    @(context.IsActive ? "Đang hoạt động" : "Đã khóa")
                </MudChip>
                <div class="text-secondary mt-1">@context.DriverSignatureStatusText</div>
            </MudTd>
            <MudTd DataLabel="Thao tác">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary"
                               OnClick="@(() => Navigation.NavigateTo($"/admin/vehicle-owner-accounts/{context.Id}"))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default"
                               OnClick="@(() => Navigation.NavigateTo($"/admin/vehicle-owner-accounts/{context.Id}/edit"))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">Không có tài khoản phù hợp.</MudText>
        </NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private bool _loading;
    private DriverAccountFilter _filter = new() { Page = 1, PageSize = 500 };
    private IReadOnlyList<DriverAccountDto> _items = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task OnKeywordChanged(string value)
    {
        _filter.Keyword = value;
        _filter.Page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _items = await Service.GetListAsync(_filter);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
