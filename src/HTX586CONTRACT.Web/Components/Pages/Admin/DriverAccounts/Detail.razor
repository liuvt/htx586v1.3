@page "/admin/vehicle-owner-accounts/{UserId}"
@page "/admin/driver-accounts/{UserId}"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDriverAccountService DriverAccountService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Chi tiết VehicleOwner</PageTitle>
<PageHeader Title="Chi tiết tài khoản VehicleOwner" Subtitle="Theo dõi tài khoản, số xe được cấp và trạng thái chữ ký theo từng xe." />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy tài khoản VehicleOwner.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 h-100" Elevation="1">
                <MudGrid>
                    <MudItem xs="12" sm="6"><InfoListItem Label="ID đăng nhập" Value="@_detail.UserName" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Họ và tên" Value="@_detail.FullName" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Số điện thoại" Value="@_detail.PhoneNumber" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Email" Value="@_detail.Email" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Địa chỉ" Value="@_detail.Address" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Ngày tạo" Value="@_detail.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")" /></MudItem>
                    <MudItem xs="12" sm="6"><InfoListItem Label="Trạng thái" Value="@(_detail.IsActive ? "Đang hoạt động" : "Đã khóa")" /></MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 h-100" Elevation="1">
                <MudText Typo="Typo.h6">Xe được cấp</MudText>
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="my-2">@_detail.VehicleCount</MudText>
                <MudText>@Display(_detail.VehiclePlates)</MudText>
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2">Công ty/văn phòng theo xe</MudText>
                <MudText>@Display(_detail.CompanyNames)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">
                    Đã ký theo xe: @_detail.SignedVehicleCount/@_detail.VehicleCount
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Thao tác tài khoản</MudText>
        <MudStack Row="true" Spacing="2" Class="flex-wrap">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => Navigation.NavigateTo($"/admin/vehicle-owner-accounts/{UserId}/edit"))">Cập nhật</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.LockReset"
                       Disabled="_working" OnClick="ResetPasswordAsync">Reset mật khẩu về Htx@586</MudButton>
            <MudButton Variant="Variant.Outlined" Color="@(_detail.IsActive ? Color.Error : Color.Success)"
                       Disabled="_working" OnClick="ToggleActiveAsync">
                @(_detail.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline"
                       Disabled="_working" OnClick="DeleteAsync">Xóa mềm</MudButton>
        </MudStack>
    </MudPaper>

    <MudButton Variant="Variant.Text" Class="mt-3" OnClick="@(() => Navigation.NavigateTo("/admin/vehicle-owner-accounts"))">Quay lại danh sách</MudButton>
}

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
    private DriverAccountDetailDto? _detail;
    private bool _loading = true;
    private bool _working;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _detail = await DriverAccountService.GetDetailAsync(UserId);
        _loading = false;
    }

    private async Task ResetPasswordAsync()
    {
        try
        {
            _working = true;
            await DriverAccountService.ResetPasswordAsync(UserId, "Htx@586");
            Snackbar.Add("Đã reset mật khẩu về Htx@586. Người dùng phải đổi mật khẩu khi đăng nhập.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _working = false; }
    }

    private async Task ToggleActiveAsync()
    {
        if (_detail is null) return;
        try
        {
            _working = true;
            await DriverAccountService.SetActiveAsync(UserId, !_detail.IsActive);
            Snackbar.Add(_detail.IsActive ? "Đã khóa tài khoản và giải phóng các xe đang cấp." : "Đã mở khóa tài khoản.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _working = false; }
    }

    private async Task DeleteAsync()
    {
        try
        {
            _working = true;
            await DriverAccountService.DeleteAsync(UserId);
            Snackbar.Add("Đã xóa mềm tài khoản và giải phóng các xe đang cấp.", Severity.Success);
            Navigation.NavigateTo("/admin/vehicle-owner-accounts");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _working = false; }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
