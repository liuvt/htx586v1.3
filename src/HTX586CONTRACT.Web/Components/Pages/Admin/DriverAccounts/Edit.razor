@page "/admin/vehicle-owner-accounts/{UserId}/edit"
@page "/admin/driver-accounts/{UserId}/edit"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDriverAccountService DriverAccountService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Cập nhật VehicleOwner</PageTitle>
<PageHeader Title="Cập nhật tài khoản VehicleOwner" Subtitle="Thông tin công ty không nằm trên tài khoản; hãy gán hoặc chuyển xe tại Quản lý xe và chủ sở hữu." />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy tài khoản VehicleOwner.</MudAlert>
}
else
{
    <MudForm @ref="_form" @bind-IsValid="_valid">
        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid>
                <MudItem xs="12" md="6"><MudTextField Value="@_detail.UserName" Label="ID đăng nhập" Disabled="true" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.FullName" Label="Họ và tên" Required="true" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.PhoneNumber" Label="Số điện thoại" Required="true" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.EmployeeCode" Label="Mã tài khoản" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_model.Address" Label="Địa chỉ" Lines="2" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6"><MudSwitch @bind-Value="_model.IsActive" Color="Color.Success">Tài khoản hoạt động</MudSwitch></MudItem>
                <MudItem xs="12" md="6"><MudSwitch @bind-Value="_model.MustChangePassword" Color="Color.Warning">Yêu cầu đổi mật khẩu</MudSwitch></MudItem>
            </MudGrid>
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mt-3">
                Xe đang cấp: <b>@(_detail.VehicleCount)</b> — @Display(_detail.VehiclePlates). Khóa tài khoản sẽ tự trả các xe về trạng thái chưa cấp.
            </MudAlert>
        </MudPaper>
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo($"/admin/vehicle-owner-accounts/{UserId}"))">Hủy</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">Lưu thay đổi</MudButton>
        </MudStack>
    </MudForm>
}

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
    private MudForm? _form;
    private bool _valid;
    private bool _loading = true;
    private bool _saving;
    private DriverAccountDetailDto? _detail;
    private UpdateDriverAccountRequest _model = new();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _detail = await DriverAccountService.GetDetailAsync(UserId);
        if (_detail is not null)
        {
            _model = new UpdateDriverAccountRequest
            {
                FullName = _detail.FullName,
                EmployeeCode = _detail.EmployeeCode,
                PhoneNumber = _detail.PhoneNumber,
                Email = _detail.Email,
                Address = _detail.Address,
                IsActive = _detail.IsActive,
                MustChangePassword = _detail.MustChangePassword
            };
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_form is not null)
            await _form.ValidateAsync();
        if (!_valid) return;
        try
        {
            _saving = true;
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _model.UpdatedByUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
            await DriverAccountService.UpdateAsync(UserId, _model);
            Snackbar.Add("Đã cập nhật tài khoản VehicleOwner.", Severity.Success);
            Navigation.NavigateTo($"/admin/vehicle-owner-accounts/{UserId}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
