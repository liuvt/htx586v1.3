@page "/admin/driver-accounts/{UserId}/edit"
@attribute [Authorize(Roles = "Admin")]
@inject IDriverAccountService DriverAccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Cập nhật tài xế</PageTitle>
<PageHeader Title="Cập nhật tài xế" Subtitle="Không thay đổi chữ ký cố định từ yêu cầu đăng ký." />

@if (_loading) { <MudProgressLinear Indeterminate="true" /> }
else if (_notFound) { <MudAlert Severity="Severity.Warning">Không tìm thấy tài xế thuộc công ty của bạn.</MudAlert> }
else
{
    <MudPaper Outlined="true" Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.FullName" Label="Họ tên" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.PhoneNumber" Label="Số điện thoại" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.EmployeeCode" Label="Mã nhân viên" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_model.DateOfBirth" Label="Ngày sinh" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.AreaCode" Label="Khu vực" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Address" Label="Địa chỉ" Lines="2" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.CitizenId" Label="CCCD" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_model.CitizenIdIssuedDate" Label="Ngày cấp CCCD" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.CitizenIdIssuedPlace" Label="Nơi cấp CCCD" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.DriverLicenseNumber" Label="Số GPLX" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.DriverLicenseClass" Label="Hạng GPLX" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_model.DriverLicenseIssuedDate" Label="Ngày cấp GPLX" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_model.DriverLicenseExpiryDate" Label="Ngày hết hạn GPLX" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudSwitch T="bool" @bind-Value="_model.IsActive" Label="Tài khoản hoạt động" Color="Color.Primary" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Href="/admin/driver-accounts" Variant="Variant.Outlined">Hủy</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_saving" OnClick="SaveAsync" StartIcon="@Icons.Material.Filled.Save">Lưu tài xế</MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">Đặt lại mật khẩu</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Dùng khi tài xế quên mật khẩu.</MudText>
        <MudGrid AlignItems="AlignItems.End">
            <MudItem xs="12" md="5"><MudTextField @bind-Value="_newPassword" Label="Mật khẩu mới" InputType="InputType.Password" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="5"><MudTextField @bind-Value="_confirmPassword" Label="Nhập lại mật khẩu" InputType="InputType.Password" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="2"><MudButton FullWidth="true" Color="Color.Warning" Variant="Variant.Filled" OnClick="ResetPasswordAsync">Đặt lại</MudButton></MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
    private string _adminId = string.Empty;
    private bool _loading = true;
    private bool _saving;
    private bool _notFound;
    private UpdateDriverAccountRequest _model = new();
    private string? _newPassword;
    private string? _confirmPassword;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _adminId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        var item = await DriverAccountService.GetDetailAsync(UserId);
        if (item is null || item.AdminId != _adminId) { _notFound = true; _loading = false; return; }
        _model = new UpdateDriverAccountRequest
        {
            AdminId = _adminId,
            FullName = item.FullName,
            EmployeeCode = item.EmployeeCode,
            PhoneNumber = item.PhoneNumber,
            Email = item.Email,
            CitizenId = item.CitizenId,
            CitizenIdIssuedDate = item.CitizenIdIssuedDate,
            CitizenIdIssuedPlace = item.CitizenIdIssuedPlace,
            DateOfBirth = item.DateOfBirth,
            Address = item.Address,
            AreaCode = item.AreaCode,
            DriverLicenseNumber = item.DriverLicenseNumber,
            DriverLicenseClass = item.DriverLicenseClass,
            DriverLicenseIssuedDate = item.DriverLicenseIssuedDate,
            DriverLicenseExpiryDate = item.DriverLicenseExpiryDate,
            IsActive = item.IsActive,
            MustChangePassword = item.MustChangePassword
        };
        _loading = false;
    }

    private async Task SaveAsync()
    {
        try
        {
            _saving = true;
            _model.AdminId = _adminId;
            await DriverAccountService.UpdateAsync(UserId, _model);
            Snackbar.Add("Đã cập nhật tài xế.", Severity.Success);
            Navigation.NavigateTo($"/admin/driver-accounts/{UserId}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task ResetPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 6 || _newPassword != _confirmPassword)
        {
            Snackbar.Add("Mật khẩu tối thiểu 6 ký tự và hai lần nhập phải giống nhau.", Severity.Warning);
            return;
        }
        try
        {
            await DriverAccountService.ResetPasswordAsync(UserId, _newPassword, _adminId);
            _newPassword = _confirmPassword = null;
            Snackbar.Add("Đã đặt lại mật khẩu tài xế.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
