@page "/driver/contracts"
@attribute [Authorize(Roles = "Driver")]
@inject IContractService ContractService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar

<PageTitle>Hợp đồng của tôi</PageTitle>
<PageHeader Title="Hợp đồng của tôi" Subtitle="Mỗi tài xế có dãy số hợp đồng riêng: tổng số hợp đồng lịch sử + 1.">
    <MudButton Href="/driver/contracts/create" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">Tạo hợp đồng</MudButton>
</PageHeader>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudGrid AlignItems="AlignItems.End">
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_search" Label="Tìm số HĐ, khách hàng, biển số" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="3"><MudDatePicker @bind-Date="_month" Label="Tháng" DateFormat="MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="ContractStatus?" @bind-Value="_status" Label="Trạng thái" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var status in Enum.GetValues<ContractStatus>())
                {
                    <MudSelectItem T="ContractStatus?" Value="@status">@StatusName(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2"><MudButton FullWidth="true" Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadAsync">Lọc</MudButton></MudItem>
    </MudGrid>
</MudPaper>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4"><MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.caption">Tổng hợp đồng</MudText><MudText Typo="Typo.h4">@_items.Count</MudText></MudPaper></MudItem>
    <MudItem xs="12" sm="4"><MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.caption">Đã hoàn thành</MudText><MudText Typo="Typo.h4">@_items.Count(x => x.Status == ContractStatus.Completed)</MudText></MudPaper></MudItem>
    <MudItem xs="12" sm="4"><MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.caption">Doanh thu hoàn thành</MudText><MudText Typo="Typo.h4">@_items.Where(x => x.Status == ContractStatus.Completed).Sum(x => x.ContractValue ?? 0).ToString("N0")</MudText></MudPaper></MudItem>
</MudGrid>

<MudTable T="ContractListItemDto" Items="_items" Loading="_loading" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="20">
    <HeaderContent><MudTh>Số HĐ</MudTh><MudTh>Ngày tạo</MudTh><MudTh>Khách hàng</MudTh><MudTh>Xe</MudTh><MudTh>Giá trị</MudTh><MudTh>Trạng thái</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Số HĐ"><b>@context.ContractNumber</b></MudTd>
        <MudTd DataLabel="Ngày tạo">@context.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
        <MudTd DataLabel="Khách hàng">@context.CustomerName</MudTd>
        <MudTd DataLabel="Xe">@(context.VehiclePlate ?? "—")</MudTd>
        <MudTd DataLabel="Giá trị">@(context.ContractValue?.ToString("N0") ?? "—")</MudTd>
        <MudTd DataLabel="Trạng thái"><ContractStatusChip Status="context.Status" /></MudTd>
        <MudTd DataLabel="Thao tác">
            @if (IsLocked(context.Status))
            {
                <MudIconButton Href="@($"/driver/contracts/detail/{context.Id}")" Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" />
            }
            else
            {
                <MudIconButton Href="@($"/driver/contracts/{context.Id}")" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4">Không có hợp đồng phù hợp.</MudText></NoRecordsContent>
    <PagerContent><MudTablePager PageSizeOptions="_pageSizeOptions" /></PagerContent>
</MudTable>

@code {
    private static readonly int[] _pageSizeOptions = [10, 20, 50, 100];
    private string _driverId = string.Empty;
    private string? _search;
    private DateTime? _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private ContractStatus? _status;
    private bool _loading;
    private List<ContractListItemDto> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _driverId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var month = _month ?? DateTime.Today;
            var start = new DateTime(month.Year, month.Month, 1);
            _items = (await ContractService.GetAsync(new ContractFilter
            {
                DriverId = _driverId,
                Search = _search,
                Status = _status,
                FromDate = start,
                ToDate = start.AddMonths(1).AddDays(-1)
            })).ToList();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private static bool IsLocked(ContractStatus status) => status is ContractStatus.Completed or ContractStatus.Cancelled or ContractStatus.Expired or ContractStatus.Invalidated;
    private static string StatusName(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "Lưu tạm",
        ContractStatus.WaitingCustomerSignature => "Đang ký",
        ContractStatus.Completed => "Hoàn thành",
        ContractStatus.Cancelled => "Đã hủy",
        ContractStatus.Expired => "Hết hạn",
        ContractStatus.Invalidated => "Vô hiệu",
        _ => status.ToString()
    };
}
