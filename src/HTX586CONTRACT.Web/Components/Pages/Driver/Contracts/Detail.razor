@page "/vehicle-owner/contracts/detail/{Id:guid}"
@attribute [Authorize(Roles = "VehicleOwner")]
@inject IContractService ContractService
@inject IContractDocumentService DocumentService
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Chi tiết hợp đồng</PageTitle>
<PageHeader Title="Chi tiết hợp đồng"
            Subtitle="Xem lại thông tin và lịch sử hợp đồng đã được giao hoặc đã hoàn thành.">
    <MudButton Href="/vehicle-owner/contracts"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.ArrowBack">
        Quay lại
    </MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy hợp đồng hoặc bạn không có quyền xem.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h5">@_detail.ContractNumber</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @_detail.CompanyName · @BusinessName(_detail.BusinessType)
                    </MudText>
                </div>
                <MudSpacer />
                <ContractStatusChip Status="_detail.Status" ChipSize="Size.Medium" />
            </MudStack>
        </MudPaper>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            <b>Người tạo:</b> @_detail.CreatedByName
            lúc @VietnamTime(_detail.CreatedAt).ToString("dd/MM/yyyy HH:mm").
            @if (!string.IsNullOrWhiteSpace(_detail.AssignedByName))
            {
                <span>
                    <b> Người phát xuống:</b> @_detail.AssignedByName
                    @if (_detail.AssignedAt.HasValue)
                    {
                        <span> lúc @VietnamTime(_detail.AssignedAt.Value).ToString("dd/MM/yyyy HH:mm")</span>
                    }.
                </span>
            }
            else
            {
                <span> Hợp đồng do tài xế tự tạo.</span>
            }
        </MudAlert>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">1. Thông tin hợp đồng</MudText>
            <MudGrid>
                <MudItem xs="12" md="4"><InfoListItem Label="Số hợp đồng" Value="@_detail.ContractNumber" /></MudItem>
                <MudItem xs="12" md="4"><InfoListItem Label="Loại hợp đồng" Value="@BusinessName(_detail.BusinessType)" /></MudItem>
                <MudItem xs="12" md="4"><InfoListItem Label="Trạng thái" Value="@StatusName(_detail.Status)" /></MudItem>
                <MudItem xs="12" md="4"><InfoListItem Label="Công ty/Văn phòng" Value="@_detail.CompanyName" /></MudItem>
                <MudItem xs="12" md="4"><InfoListItem Label="Tài xế" Value="@_detail.DriverName" /></MudItem>
                <MudItem xs="12" md="4"><InfoListItem Label="Khu vực" Value="@_detail.AreaCode" /></MudItem>
                <MudItem xs="12" md="4"><InfoListItem Label="Ngày tạo HĐ" Value="@FormatDateTime(_detail.CreatedAt)" /></MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">@(_detail.BusinessType == ContractBusinessType.Cargo ? "2. Văn phòng/Công ty và Chủ phương tiện" : "2. Phương tiện")</MudText>
            @if (_detail.BusinessType == ContractBusinessType.Cargo)
            {
                <MudGrid>
                    <MudItem xs="12" md="6"><InfoListItem Label="Tên Văn phòng/Công ty" Value="@(_detail.CompanyOfficeName ?? _detail.CompanyName)" /></MudItem>
                    <MudItem xs="12" md="3"><InfoListItem Label="Mã số thuế" Value="@(_detail.CompanyTaxCode ?? "-")" /></MudItem>
                    <MudItem xs="12" md="3"><InfoListItem Label="GPKDVT" Value="@(_detail.CompanyBusinessLicenseNumber ?? "-")" /></MudItem>
                    <MudItem xs="12" md="3"><InfoListItem Label="Nơi cấp Phép" Value="@(_detail.CompanyBusinessLicenseIssuedPlace ?? "-")" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Địa chỉ" Value="@(_detail.CompanyAddress ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Số điện thoại" Value="@(_detail.CompanyPhoneNumber ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Tên người đại diện" Value="@(_detail.CompanyRepresentativeName ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="CCCD người đại diện" Value="@(_detail.CompanyRepresentativeCitizenId ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Ngày cấp CCCD đại diện" Value="@FormatDate(_detail.CompanyRepresentativeCitizenIdIssuedDate)" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Tên chủ phương tiện" Value="@(_detail.OwnerName ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="CCCD chủ phương tiện" Value="@(_detail.OwnerCitizenId ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Ngày cấp CCCD chủ phương tiện" Value="@FormatDate(_detail.OwnerCitizenIdIssuedDate)" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Biển kiểm soát" Value="@(_detail.VehiclePlate ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Tài xế 1" Value="@(_detail.OperatingDriverName ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Số GPLX TX1" Value="@(_detail.OperatingDriverLicenseNumber ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Hạng GPLX TX1" Value="@(_detail.OperatingDriverLicenseClass ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Tài xế 2" Value="@(string.IsNullOrWhiteSpace(_detail.SecondDriverName) ? "Không có" : _detail.SecondDriverName)" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Số GPLX TX2" Value="@(string.IsNullOrWhiteSpace(_detail.SecondDriverName) ? "N/A" : _detail.SecondDriverLicenseNumber ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Hạng GPLX TX2" Value="@(string.IsNullOrWhiteSpace(_detail.SecondDriverName) ? "N/A" : _detail.SecondDriverLicenseClass ?? "-")" /></MudItem>
                </MudGrid>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="4"><InfoListItem Label="Biển kiểm soát" Value="@(_detail.VehiclePlate ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Hãng/Loại xe" Value="@(_detail.VehicleBrand ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Số chỗ" Value="@FormatNumber(_detail.SeatCount)" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Chủ sở hữu" Value="@(_detail.OwnerName ?? "-")" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="CCCD chủ sở hữu" Value="@(_detail.OwnerCitizenId ?? "-")" /></MudItem>
                </MudGrid>
            }
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">@(_detail.BusinessType == ContractBusinessType.Cargo ? "3. Khách hàng / Bên A" : "3. Khách hàng/người thuê")</MudText>
            @if (_detail.BusinessType == ContractBusinessType.Cargo)
            {
                <MudGrid>
                    <MudItem xs="12" md="6"><InfoListItem Label="@(_detail.CustomerIsCompany ? "Tên công ty" : "Khách hàng")" Value="@(_detail.CustomerIsCompany ? _detail.CustomerName : "Khách hàng cá nhân")" /></MudItem>
                    <MudItem xs="12" md="3"><InfoListItem Label="Mã số thuế" Value="@(_detail.CustomerIsCompany ? _detail.CustomerTaxCode ?? "N/A" : "N/A")" /></MudItem>
                    <MudItem xs="12" md="3"><InfoListItem Label="Số điện thoại" Value="@_detail.CustomerPhone" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Người đại diện/Khách hàng" Value="@(_detail.CustomerIsCompany ? _detail.CustomerRepresentativeName ?? "-" : _detail.CustomerName)" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="CCCD" Value="@(_detail.CustomerCitizenId ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Ngày cấp CCCD" Value="@FormatDate(_detail.CustomerCitizenIdIssuedDate)" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Địa chỉ" Value="@(_detail.CustomerAddress ?? "-")" /></MudItem>
                </MudGrid>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="4"><InfoListItem Label="Khách hàng/người thuê" Value="@_detail.CustomerName" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Số điện thoại" Value="@_detail.CustomerPhone" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="CCCD/MST" Value="@(_detail.CustomerCitizenId ?? "-")" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Địa chỉ" Value="@(_detail.CustomerAddress ?? "-")" /></MudItem>
                </MudGrid>
            }
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">4. Nội dung hợp đồng</MudText>
            <MudGrid>
                <MudItem xs="12" md="3"><InfoListItem Label="Bắt đầu" Value="@FormatDateTime(_detail.StartTime)" /></MudItem>
                <MudItem xs="12" md="3"><InfoListItem Label="Kết thúc" Value="@FormatDateTime(_detail.EndTime)" /></MudItem>
                <MudItem xs="12" md="3"><InfoListItem Label="Tổng km" Value="@FormatDecimal(_detail.TotalKilometers)" /></MudItem>
                <MudItem xs="12" md="3"><InfoListItem Label="@(_detail.BusinessType == ContractBusinessType.Cargo ? "Cước vận chuyển" : "Giá trị hợp đồng")" Value="@FormatMoney(_detail.ContractValue)" /></MudItem>
                <MudItem xs="12" md="6"><InfoListItem Label="@(_detail.BusinessType == ContractBusinessType.Cargo ? "Nơi nhận hàng" : "Điểm đi")" Value="@(_detail.PickupLocation ?? "-")" /></MudItem>
                <MudItem xs="12" md="6"><InfoListItem Label="@(_detail.BusinessType == ContractBusinessType.Cargo ? "Nơi trả hàng" : "Điểm đến")" Value="@(_detail.DropoffLocation ?? "-")" /></MudItem>
                <MudItem xs="12"><InfoListItem Label="@(_detail.BusinessType == ContractBusinessType.Cargo ? "Hành trình xe chạy" : "Lộ trình chi tiết")" Value="@(_detail.RouteDescription ?? "-")" /></MudItem>
                @if (_detail.BusinessType == ContractBusinessType.Cargo)
                {
                    <MudItem xs="12"><InfoListItem Label="Thanh toán" Value="@(_detail.PaymentMethod ?? "-")" /></MudItem>
                }
                else
                {
                    <MudItem xs="12" md="6"><InfoListItem Label="Hình thức thanh toán" Value="@(_detail.PaymentMethod ?? "-")" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Thời gian thanh toán" Value="@(_detail.PaymentTime ?? "-")" /></MudItem>
                }
                <MudItem xs="12"><InfoListItem Label="Ghi chú" Value="@(_detail.Note ?? "-")" /></MudItem>
            </MudGrid>
        </MudPaper>

        @if (_detail.BusinessType == ContractBusinessType.Cargo)
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">5. Thông tin hàng hóa</MudText>
                <MudGrid>
                    <MudItem xs="12" md="6"><InfoListItem Label="Loại hàng" Value="@(_detail.CargoName ?? "-")" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Quy cách" Value="@(_detail.CargoSpecification ?? "-")" /></MudItem>
                    <MudItem xs="12" md="4"><InfoListItem Label="Số lượng" Value="@(_detail.CargoQuantity ?? "-")" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Khối lượng" Value="@FormatDecimal(_detail.CargoWeight)" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Tên hàng hóa (Giấy vận tải)" Value="@(_detail.CargoTransportGoodsName ?? "N/A")" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Tuyến vận chuyển" Value="@(_detail.CargoTransportRoute ?? "N/A")" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Điểm xếp hàng" Value="@(_detail.CargoLoadingPoint ?? "N/A")" /></MudItem>
                    <MudItem xs="12" md="6"><InfoListItem Label="Điểm giao hàng" Value="@(_detail.CargoDeliveryPoint ?? "N/A")" /></MudItem>
                    <MudItem xs="12"><InfoListItem Label="Thông tin khác" Value="@(_detail.CargoOtherInformation ?? "N/A")" /></MudItem>
                </MudGrid>
                @if (_detail.CargoHandlingEvents.Count > 0)
                {
                    <MudTable T="ContractCargoHandlingEventDto" Items="@_detail.CargoHandlingEvents.OrderBy(x => x.Type).ThenBy(x => x.SortOrder)" Dense="true" Hover="true" Class="mt-3">
                        <HeaderContent>
                            <MudTh>Loại</MudTh><MudTh>Lần</MudTh><MudTh>Địa điểm</MudTh><MudTh>Khối lượng</MudTh><MudTh>Thời gian</MudTh><MudTh>Xác nhận</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@(context.Type == CargoHandlingType.Loading ? "Xếp" : "Dỡ")</MudTd>
                            <MudTd>@context.SortOrder</MudTd>
                            <MudTd>@(context.Location ?? "N/A")</MudTd>
                            <MudTd>@(context.CargoWeight ?? "N/A")</MudTd>
                            <MudTd>@(context.EventTime.HasValue ? FormatDateTime(context.EventTime) : "N/A")</MudTd>
                            <MudTd>@(context.Confirmation ?? "N/A")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        }

        @if (_detail.BusinessType == ContractBusinessType.Passenger)
        {
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">5. Danh sách hành khách</MudText>
                <MudSpacer />
                <MudChip T="string" Variant="Variant.Outlined">Số lượng: @FormatNumber(_detail.ActualPassengerCount)</MudChip>
            </MudStack>
            <MudTable T="ContractPassengerDto" Items="PassengerRows" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>STT</MudTh>
                    <MudTh>Họ tên</MudTh>
                    <MudTh>Năm sinh</MudTh>
                    <MudTh>Ghi chú</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @if (IsCustomerTravelRow(context))
                    {
                        <MudTd DataLabel="STT">1</MudTd>
                        <MudTd DataLabel="Họ tên">@TravelCompanionDisplayName</MudTd>
                        <MudTd DataLabel="Năm sinh">@(_detail.CustomerTravelBirthYear?.ToString() ?? "-")</MudTd>
                        <MudTd DataLabel="Ghi chú">@(string.IsNullOrWhiteSpace(_detail.CustomerTravelNote) ? "-" : _detail.CustomerTravelNote)</MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="STT">@(context.SortOrder + (_detail.CustomerTravelsWithGroup ? 1 : 0))</MudTd>
                        <MudTd DataLabel="Họ tên">@context.FullName</MudTd>
                        <MudTd DataLabel="Năm sinh">@(context.BirthYear?.ToString() ?? "-")</MudTd>
                        <MudTd DataLabel="Ghi chú">@(string.IsNullOrWhiteSpace(context.Note) ? "-" : context.Note)</MudTd>
                    }
                </RowTemplate>
                <NoRecordsContent><MudText>Không có hành khách.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
        }

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">Lịch sử chữ ký</MudText>
            <MudTable T="ContractSignatureDto" Items="_detail.Signatures" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Bên ký</MudTh>
                    <MudTh>Người ký</MudTh>
                    <MudTh>Thời gian</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Bên ký">@SignaturePartyName(context.Party, _detail.BusinessType)</MudTd>
                    <MudTd DataLabel="Người ký">@context.SignerName</MudTd>
                    <MudTd DataLabel="Thời gian">@VietnamTime(context.ServerSignedAt).ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>Chưa có chữ ký.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd">
            @if (!IsHistoryStatus(_detail.Status) && _canEditCurrentContract)
            {
                <MudButton Href="@($"/vehicle-owner/contracts/{Id}")"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Edit">
                    Tiếp tục xử lý
                </MudButton>
            }
            @if (_detail.Status == ContractStatus.Completed)
            {
                <MudButton Color="Color.Success"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="OpenPdfAsync">
                    Mở PDF
                </MudButton>
            }
        </MudStack>
    </MudStack>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _canEditCurrentContract;
    private string _userId = string.Empty;
    private ContractDetailDto? _detail;
    private readonly ContractPassengerDto _customerTravelRow = new() { SortOrder = 0 };
    private IEnumerable<ContractPassengerDto> PassengerRows =>
        _detail is not null && _detail.CustomerTravelsWithGroup && !string.IsNullOrWhiteSpace(TravelCompanionDisplayName)
            ? new[] { _customerTravelRow }.Concat(_detail.Passengers)
            : _detail?.Passengers ?? [];
    private bool IsCustomerTravelRow(ContractPassengerDto row) => object.ReferenceEquals(row, _customerTravelRow);
    private string TravelCompanionDisplayName => _detail is null
        ? string.Empty
        : _detail.CustomerIsCompany
            ? (string.IsNullOrWhiteSpace(_detail.CustomerRepresentativeName) ? _detail.CustomerName : _detail.CustomerRepresentativeName)
            : _detail.CustomerName;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

            var detail = await ContractService.GetByIdAsync(Id);
            if (detail is null || detail.DriverId != _userId)
            {
                _detail = null;
                return;
            }

            await using var db = await Factory.CreateDbContextAsync();
            _canEditCurrentContract = detail.VehicleId.HasValue &&
                await db.Vehicles.AsNoTracking().AnyAsync(x =>
                    x.Id == detail.VehicleId.Value &&
                    x.IsActive &&
                    x.AssignedDriverId == _userId);

            // Hợp đồng đang xử lý chỉ được xem khi xe hiện còn gán cho tài xế.
            // Hợp đồng đã kết thúc luôn được phép xem lại như lịch sử.
            if (!IsHistoryStatus(detail.Status) && !_canEditCurrentContract)
            {
                Snackbar.Add("Hợp đồng đang xử lý chỉ hiển thị khi xe của hợp đồng còn được gán cho tài xế.", Severity.Warning);
                _detail = null;
                return;
            }

            _detail = detail;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _detail = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenPdfAsync()
    {
        try
        {
            var url = await DocumentService.GeneratePdfAsync(Id);
            Navigation.NavigateTo(url, true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static bool IsHistoryStatus(ContractStatus status)
        => status is ContractStatus.Completed
            or ContractStatus.Cancelled
            or ContractStatus.Expired
            or ContractStatus.Invalidated;

    private static DateTime VietnamTime(DateTime value)
        => value.Kind == DateTimeKind.Utc ? value.AddHours(7) : value;

    private static string FormatDateTime(DateTime? value)
        => value.HasValue ? VietnamTime(value.Value).ToString("dd/MM/yyyy HH:mm") : "-";

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";

    private static string FormatMoney(decimal? value)
        => value.HasValue ? $"{value.Value:N0} VNĐ" : "-";

    private static string FormatDecimal(decimal? value)
        => value.HasValue ? value.Value.ToString("N0") : "-";

    private static string FormatNumber(int? value)
        => value.HasValue ? value.Value.ToString("N0") : "-";

    private static string BusinessName(ContractBusinessType type) => type switch
    {
        ContractBusinessType.Passenger => "HỢP ĐỒNG VẬN CHUYỂN HÀNH KHÁCH",
        ContractBusinessType.Cargo => "HỢP ĐỒNG VẬN CHUYỂN HÀNG HÓA BẰNG XE Ô TÔ",
        _ => "Loại hợp đồng cũ"
    };

    private static string SignaturePartyName(SignatureParty party, ContractBusinessType businessType) => party switch
    {
        SignatureParty.RepresentativeOffice => "Công ty/Văn phòng",
        SignatureParty.VehicleOwner => "Chủ xe",
        SignatureParty.Driver => "Tài xế",
        SignatureParty.Customer => businessType == ContractBusinessType.Cargo ? "Đại diện Bên A" : "Khách hàng",
        _ => party.ToString()
    };


    private static string StatusName(ContractStatus status) => status switch
    {
        ContractStatus.Completed => "Hoàn tất",
        ContractStatus.Cancelled => "Đã hủy",
        ContractStatus.Expired => "Hết hạn",
        ContractStatus.Invalidated => "Vô hiệu",
        ContractStatus.Draft => "Đã tạo",
        ContractStatus.WaitingCustomerSignature => "Đã phát - chờ nhận",
        ContractStatus.CustomerSigned => "Khách đã ký",
        ContractStatus.WaitingDriverConfirmation => "Đã nhận - đang xử lý",
        _ => "Đang xử lý"
    };
}
