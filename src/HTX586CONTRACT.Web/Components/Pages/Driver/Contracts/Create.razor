@page "/driver/contracts/create"
@page "/driver/contracts/{Id:guid}"
@attribute [Authorize(Roles = "Driver")]
@inject IContractService ContractService
@inject IContractDocumentService DocumentService
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>@(Id.HasValue ? $"Hợp đồng {_model.ContractNumber}" : "Tạo hợp đồng")</PageTitle>
<PageHeader Title="@(Id.HasValue ? "Hợp đồng vận chuyển" : "Tạo hợp đồng mới")"
            Subtitle="Công ty và tài xế lấy tự động; xe, chủ xe, khách hàng và nội dung hợp đồng nhập trực tiếp." />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_driver is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy tài khoản tài xế.</MudAlert>
}
else if (_admin is null)
{
    <MudAlert Severity="Severity.Warning">Tài xế chưa được gán tài khoản Admin/công ty.</MudAlert>
}
else
{
    @if (Id.HasValue)
    {
        <MudPaper Class="pa-3 mb-4" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">Hợp đồng số @_model.ContractNumber</MudText>
                <MudSpacer />
                <ContractStatusChip Status="_model.Status" ChipSize="Size.Medium" />
            </MudStack>
        </MudPaper>
    }

    @if (IsLocked)
    {
        <MudAlert Severity="@(_model.Status == ContractStatus.Completed ? Severity.Success : Severity.Error)" Class="mb-4">
            @(_model.Status == ContractStatus.Completed
                ? "Hợp đồng đã hoàn thành và khóa toàn bộ dữ liệu."
                : "Hợp đồng đã hủy hoặc không còn hiệu lực.")
        </MudAlert>
    }

    <MudForm @ref="_form" @bind-IsValid="_valid">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">1. Thông tin cố định</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption">Công ty</MudText>
                    <MudText Typo="Typo.subtitle1"><b>@CompanyDisplay</b></MudText>
                    <MudText Typo="Typo.body2">MST: @Display(FixedCompanyTaxCode)</MudText>
                    <MudText Typo="Typo.body2">Địa chỉ: @Display(FixedCompanyAddress)</MudText>
                    <MudText Typo="Typo.body2">Đại diện: @Display(FixedCompanyRepresentativeName)</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption">Tài xế</MudText>
                    <MudText Typo="Typo.subtitle1"><b>@FixedDriverName</b></MudText>
                    <MudText Typo="Typo.body2">Điện thoại: @Display(FixedDriverPhone)</MudText>
                    <MudText Typo="Typo.body2">GPLX: @Display(FixedDriverLicenseNumber) - Hạng @Display(FixedDriverLicenseClass)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">2. Xe và chủ sở hữu</MudText>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                Dữ liệu này được nhập trực tiếp và lưu snapshot trong hợp đồng, không lấy từ xe đang gán cho tài xế.
            </MudAlert>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.VehiclePlate" Label="Biển số xe" Required="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.VehicleCode" Label="Mã xe" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.VehicleBrand" Label="Nhãn hiệu" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.VehicleModel" Label="Model" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.VehicleType" Label="Loại xe" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudNumericField T="int?" @bind-Value="_model.SeatCount" Label="Số chỗ" Min="1" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.VehicleColor" Label="Màu xe" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.ChassisNumber" Label="Số khung" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTextField @bind-Value="_model.EngineNumber" Label="Số máy" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>

                <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.OwnerName" Label="Họ tên chủ sở hữu xe" Required="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_model.OwnerPhoneNumber" Label="Điện thoại chủ xe" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_model.OwnerCitizenId" Label="CCCD chủ xe" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.OwnerCitizenIdIssuedDate" Label="Ngày cấp CCCD" DateFormat="dd/MM/yyyy" Editable="true" Clearable="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.OwnerCitizenIdIssuedPlace" Label="Nơi cấp CCCD" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.OwnerAddress" Label="Địa chỉ chủ xe" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">3. Khách hàng/người thuê</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.CustomerName" Label="Họ tên khách hàng" Required="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_model.CustomerPhone" Label="Số điện thoại" Required="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_model.CustomerCitizenId" Label="CCCD" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.CustomerCitizenIdIssuedDate" Label="Ngày cấp CCCD" DateFormat="dd/MM/yyyy" Editable="true" Clearable="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CustomerCitizenIdIssuedPlace" Label="Nơi cấp CCCD" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CustomerAddress" Label="Địa chỉ" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.CustomerOrganizationName" Label="Tên tổ chức (nếu có)" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_model.CustomerTaxCode" Label="Mã số thuế" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_model.CustomerEmail" Label="Email" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">4. Nội dung hợp đồng</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="3"><MudDatePicker @bind-Date="_startDate" Label="Ngày bắt đầu" DateFormat="dd/MM/yyyy" Editable="true" Clearable="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTimePicker @bind-Time="_startTime" Label="Giờ bắt đầu" Editable="true" Clearable="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudDatePicker @bind-Date="_endDate" Label="Ngày kết thúc" DateFormat="dd/MM/yyyy" Editable="true" Clearable="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6" md="3"><MudTimePicker @bind-Time="_endTime" Label="Giờ kết thúc" Editable="true" Clearable="true" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.PickupLocation" Label="Điểm đi" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.DropoffLocation" Label="Điểm đến" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_model.RouteDescription" Label="Lộ trình chi tiết" Lines="3" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudNumericField T="decimal?" @bind-Value="_model.TotalKilometers" Label="Tổng km" Min="0" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudNumericField T="decimal?" @bind-Value="_model.ContractValue" Label="Giá trị hợp đồng" Min="0" Format="N0" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudSelect T="string" @bind-Value="_model.PaymentMethod" Label="Thanh toán" Disabled="IsLocked" Clearable="true" Variant="Variant.Outlined"><MudSelectItem Value='@("Tiền mặt")'>Tiền mặt</MudSelectItem><MudSelectItem Value='@("Chuyển khoản")'>Chuyển khoản</MudSelectItem></MudSelect></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_model.PaymentTime" Label="Thời điểm thanh toán" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_model.Note" Label="Ghi chú" Lines="2" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">5. Khách đi chung</MudText>
                <MudSpacer />
                <MudButton StartIcon="@Icons.Material.Filled.PersonAdd" Variant="Variant.Outlined" Disabled="@(IsLocked || _model.Passengers.Count >= 20)" OnClick="AddPassenger">Thêm người</MudButton>
            </MudStack>
            @if (_model.Passengers.Count == 0)
            {
                <MudText Color="Color.Secondary">Không có khách đi chung.</MudText>
            }
            @foreach (var passenger in _model.Passengers.Select((value, index) => new { value, index }))
            {
                <MudGrid Spacing="2" Class="mb-1">
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="passenger.value.FullName" Label="Họ tên" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="8" md="2"><MudNumericField T="int?" @bind-Value="passenger.value.BirthYear" Label="Năm sinh" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="10" md="3"><MudTextField @bind-Value="passenger.value.Note" Label="Ghi chú" Disabled="IsLocked" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="2" md="1" Class="d-flex align-center"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="IsLocked" OnClick="@(() => RemovePassenger(passenger.index))" /></MudItem>
                </MudGrid>
            }
        </MudPaper>

        <MudStack Row="true" Class="mb-4">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/driver/contracts"))">Quay lại</MudButton>
            <MudSpacer />
            @if (Id.HasValue && !IsLocked)
            {
                <MudButton Color="Color.Error" Variant="Variant.Outlined" Disabled="_cancelling" OnClick="CancelAsync">Hủy hợp đồng</MudButton>
            }
            @if (!IsLocked)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">@(_saving ? "Đang lưu..." : "Lưu tạm")</MudButton>
            }
        </MudStack>
    </MudForm>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-1">6. Chữ ký</MudText>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
            Ký chưa làm khóa hợp đồng. Chủ xe và khách hàng có thể ký lại nhiều lần. Chỉ nút Hoàn thành mới khóa khi đủ 4 chữ ký.
        </MudAlert>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1"><b>Công ty (tự động)</b></MudText>
                <SignaturePad Disabled="true" ExistingSignatureUrl="@FixedCompanySignature" SignerName="@CompanySigner" SignedAt="@FixedCompanySignedAt" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1"><b>Tài xế (tự động)</b></MudText>
                <SignaturePad Disabled="true" ExistingSignatureUrl="@FixedDriverSignature" SignerName="@FixedDriverName" SignedAt="@FixedDriverSignedAt" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1"><b>Chủ sở hữu xe (ký tay)</b></MudText>
                <SignaturePad Disabled="@(!Id.HasValue || IsLocked)"
                              ExistingSignatureUrl="@SignatureUrl(SignatureParty.VehicleOwner)"
                              SignerName="@_model.OwnerName"
                              SignedAt="@SignatureTime(SignatureParty.VehicleOwner)"
                              ConfirmationButtonText="Lưu chữ ký chủ xe"
                              SavedStatusText="Đã ký - có thể ký lại"
                              OnSignatureSaved="SaveOwnerSignatureAsync" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1"><b>Khách hàng (ký tay)</b></MudText>
                <SignaturePad Disabled="@(!Id.HasValue || IsLocked)"
                              ExistingSignatureUrl="@SignatureUrl(SignatureParty.Customer)"
                              SignerName="@_model.CustomerName"
                              SignedAt="@SignatureTime(SignatureParty.Customer)"
                              ConfirmationButtonText="Lưu chữ ký khách hàng"
                              SavedStatusText="Đã ký - có thể ký lại"
                              OnSignatureSaved="SaveCustomerSignatureAsync" />
            </MudItem>
        </MudGrid>

        @if (!Id.HasValue)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">Hãy lưu tạm hợp đồng trước khi ký.</MudAlert>
        }
        else if (!IsLocked)
        {
            <MudStack Row="true" Class="mt-4">
                <MudText Color="Color.Secondary">Đủ chữ ký: @(HasAllSignatures ? "Có" : "Chưa")</MudText>
                <MudSpacer />
                <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.TaskAlt" Disabled="@(_completing || !HasAllSignatures)" OnClick="CompleteAsync">
                    @(_completing ? "Đang hoàn thành..." : "Hoàn thành hợp đồng")
                </MudButton>
            </MudStack>
        }
        else if (_model.Status == ContractStatus.Completed)
        {
            <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="OpenPdfAsync">Mở PDF</MudButton>
        }
    </MudPaper>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private MudForm? _form;
    private bool _valid;
    private bool _loading = true;
    private bool _saving;
    private bool _savingSignature;
    private bool _completing;
    private bool _cancelling;
    private string _userId = string.Empty;
    private ApplicationUser? _driver;
    private ApplicationUser? _admin;
    private ContractDetailDto? _detail;
    private SaveContractRequest _model = NewModel();
    private List<ContractSignatureDto> _signatures = [];
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            await using var db = await Factory.CreateDbContextAsync();
            _driver = await db.Users.AsNoTracking()
                .Include(x => x.AdminAccount)
                .Include(x => x.CompanyProfile)
                .FirstOrDefaultAsync(x => x.Id == _userId);
            _admin = _driver?.AdminAccount;

            if (_admin is null && _driver?.CompanyProfileId is Guid legacyCompanyId)
            {
                _admin = await (from user in db.Users.AsNoTracking()
                                join userRole in db.UserRoles.AsNoTracking() on user.Id equals userRole.UserId
                                join role in db.Roles.AsNoTracking() on userRole.RoleId equals role.Id
                                where user.CompanyProfileId == legacyCompanyId && role.Name == "Admin" && user.IsActive && !user.IsDeleted
                                select user).FirstOrDefaultAsync();
            }

            if (!Id.HasValue)
            {
                _model = NewModel();
                _model.DriverId = _userId;
                _model.AdminId = _admin?.Id;
                _model.AreaCode = _driver?.AreaCode ?? string.Empty;
                _signatures = [];
                _detail = null;
                _startDate = DateTime.Today;
                _startTime = DateTime.Now.TimeOfDay;
                return;
            }

            _detail = await ContractService.GetByIdAsync(Id.Value);
            if (_detail is null) return;
            if (!string.Equals(_detail.DriverId, _userId, StringComparison.Ordinal))
            {
                Snackbar.Add("Bạn không có quyền xem hợp đồng này.", Severity.Error);
                Navigation.NavigateTo("/driver/contracts");
                return;
            }

            MapDetail(_detail);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static SaveContractRequest NewModel() => new()
    {
        BusinessType = ContractBusinessType.Passenger,
        Status = ContractStatus.Draft,
        Passengers = []
    };

    private void MapDetail(ContractDetailDto d)
    {
        _model = new SaveContractRequest
        {
            Id = d.Id,
            ContractNumber = d.ContractNumber,
            BusinessType = d.BusinessType,
            ContractTypeId = d.ContractTypeId,
            AdminId = d.AdminId,
            DriverId = d.DriverId,
            CustomerName = d.CustomerName,
            CustomerPhone = d.CustomerPhone,
            CustomerCitizenId = d.CustomerCitizenId,
            CustomerCitizenIdIssuedDate = d.CustomerCitizenIdIssuedDate,
            CustomerCitizenIdIssuedPlace = d.CustomerCitizenIdIssuedPlace,
            CustomerAddress = d.CustomerAddress,
            CustomerEmail = d.CustomerEmail,
            CustomerOrganizationName = d.CustomerOrganizationName,
            CustomerTaxCode = d.CustomerTaxCode,
            AreaCode = d.AreaCode,
            VehiclePlate = d.VehiclePlate,
            VehicleCode = d.VehicleCode,
            VehicleBrand = d.VehicleBrand,
            VehicleModel = d.VehicleModel,
            VehicleType = d.VehicleType,
            SeatCount = d.SeatCount,
            VehicleColor = d.VehicleColor,
            ChassisNumber = d.ChassisNumber,
            EngineNumber = d.EngineNumber,
            OwnerName = d.OwnerName,
            OwnerCitizenId = d.OwnerCitizenId,
            OwnerCitizenIdIssuedDate = d.OwnerCitizenIdIssuedDate,
            OwnerCitizenIdIssuedPlace = d.OwnerCitizenIdIssuedPlace,
            OwnerAddress = d.OwnerAddress,
            OwnerPhoneNumber = d.OwnerPhoneNumber,
            PickupLocation = d.PickupLocation,
            DropoffLocation = d.DropoffLocation,
            StartTime = d.StartTime,
            EndTime = d.EndTime,
            RouteDescription = d.RouteDescription,
            TotalKilometers = d.TotalKilometers,
            ContractValue = d.ContractValue,
            PaymentMethod = d.PaymentMethod,
            PaymentTime = d.PaymentTime,
            Note = d.Note,
            Status = d.Status,
            Passengers = d.Passengers.Select(x => new ContractPassengerDto { Id = x.Id, SortOrder = x.SortOrder, FullName = x.FullName, BirthYear = x.BirthYear, Note = x.Note }).ToList()
        };
        _signatures = d.Signatures;
        _startDate = d.StartTime?.Date;
        _startTime = d.StartTime?.TimeOfDay;
        _endDate = d.EndTime?.Date;
        _endTime = d.EndTime?.TimeOfDay;
    }

    private async Task SaveAsync() => await SaveCurrentAsync(true);

    private async Task<bool> SaveCurrentAsync(bool navigateAfterCreate)
    {
        if (IsLocked) return false;
        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_valid) return false;
        }

        ApplyDateTimes();
        _model.DriverId = _userId;
        _model.AdminId ??= _admin?.Id;
        _saving = true;
        try
        {
            var result = Id.HasValue
                ? await ContractService.UpdateAsync(Id.Value, _model, _userId)
                : await ContractService.CreateAsync(_model, _userId);
            Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
            if (!result.Succeeded) return false;

            if (!Id.HasValue && result.Id.HasValue)
            {
                if (navigateAfterCreate)
                    Navigation.NavigateTo($"/driver/contracts/{result.Id.Value}");
                return true;
            }

            await ReloadAsync();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể lưu hợp đồng: {ex.Message}", Severity.Error);
            return false;
        }
        finally { _saving = false; }
    }

    private async Task SaveOwnerSignatureAsync(string data) =>
        await SaveSignatureAsync(SignatureParty.VehicleOwner, _model.OwnerName ?? string.Empty, data);

    private async Task SaveCustomerSignatureAsync(string data) =>
        await SaveSignatureAsync(SignatureParty.Customer, _model.CustomerName, data);

    private async Task SaveSignatureAsync(SignatureParty party, string signerName, string data)
    {
        if (!Id.HasValue) throw new InvalidOperationException("Hãy lưu tạm hợp đồng trước khi ký.");
        if (_savingSignature) throw new InvalidOperationException("Đang lưu chữ ký.");

        // Lưu dữ liệu đang nhập trước; chữ ký vẫn có thể được ghi đè sau đó.
        if (!await SaveCurrentAsync(false))
            throw new InvalidOperationException("Không thể lưu dữ liệu hợp đồng trước khi ký.");

        _savingSignature = true;
        try
        {
            await DocumentService.SaveSignatureAsync(Id.Value, _userId, party.ToString(), signerName, data);
            Snackbar.Add($"Đã lưu chữ ký {PartyName(party)}. Có thể ký lại trước khi hoàn thành.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _savingSignature = false; }
    }

    private async Task CompleteAsync()
    {
        if (!Id.HasValue || _completing) return;
        _completing = true;
        try
        {
            if (!await SaveCurrentAsync(false)) return;
            var result = await ContractService.CompleteAsync(Id.Value, _userId);
            Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
            if (!result.Succeeded) return;

            try { await DocumentService.GeneratePdfAsync(Id.Value); }
            catch (Exception ex) { Snackbar.Add($"Hợp đồng đã khóa nhưng chưa tạo được PDF: {ex.Message}", Severity.Warning); }
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể hoàn thành hợp đồng: {ex.Message}", Severity.Error);
        }
        finally { _completing = false; }
    }

    private async Task CancelAsync()
    {
        if (!Id.HasValue || _cancelling) return;
        var confirm = await Dialog.ShowMessageBoxAsync("Hủy hợp đồng", "Xác nhận hủy hợp đồng này?", yesText: "Hủy", cancelText: "Không");
        if (confirm != true) return;
        _cancelling = true;
        try
        {
            var result = await ContractService.CancelByDriverAsync(Id.Value, _userId, "Tài xế hủy hợp đồng.");
            Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
            if (result.Succeeded) await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể hủy hợp đồng: {ex.Message}", Severity.Error);
        }
        finally { _cancelling = false; }
    }

    private async Task ReloadAsync()
    {
        if (!Id.HasValue) return;
        var detail = await ContractService.GetByIdAsync(Id.Value);
        if (detail is not null)
        {
            _detail = detail;
            MapDetail(detail);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenPdfAsync()
    {
        if (!Id.HasValue) return;
        try
        {
            var url = await DocumentService.GeneratePdfAsync(Id.Value);
            Navigation.NavigateTo(url, true);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void ApplyDateTimes()
    {
        _model.StartTime = Combine(_startDate, _startTime);
        _model.EndTime = Combine(_endDate, _endTime);
    }

    private static DateTime? Combine(DateTime? date, TimeSpan? time)
        => date.HasValue ? date.Value.Date.Add(time ?? TimeSpan.Zero) : null;

    private void AddPassenger() => _model.Passengers.Add(new ContractPassengerDto { SortOrder = _model.Passengers.Count + 1 });
    private void RemovePassenger(int index)
    {
        if (index >= 0 && index < _model.Passengers.Count) _model.Passengers.RemoveAt(index);
        for (var i = 0; i < _model.Passengers.Count; i++) _model.Passengers[i].SortOrder = i + 1;
    }

    private ContractSignatureDto? GetSignature(SignatureParty party) => _signatures.FirstOrDefault(x => x.Party == party);
    private string? SignatureUrl(SignatureParty party) => GetSignature(party)?.SignatureFileUrl;
    private DateTime? SignatureTime(SignatureParty party) => GetSignature(party)?.ServerSignedAt;
    private bool HasSignature(SignatureParty party) => GetSignature(party) is not null;

    private bool IsLocked => _model.Status is ContractStatus.Completed or ContractStatus.Cancelled or ContractStatus.Expired or ContractStatus.Invalidated;
    private bool HasAllSignatures =>
        !string.IsNullOrWhiteSpace(FixedCompanySignature) &&
        !string.IsNullOrWhiteSpace(FixedDriverSignature) &&
        HasSignature(SignatureParty.VehicleOwner) &&
        HasSignature(SignatureParty.Customer);

    private string CompanyDisplay => _detail?.CompanyName ?? (!string.IsNullOrWhiteSpace(_admin?.CompanyBranchName)
        ? $"{_admin.CompanyName} - {_admin.CompanyBranchName}"
        : _admin?.CompanyName ?? _admin?.FullName ?? "—");
    private string? FixedCompanyTaxCode => _detail?.CompanyTaxCode ?? _admin?.CompanyTaxCode;
    private string? FixedCompanyAddress => _detail?.CompanyAddress ?? _admin?.CompanyAddress;
    private string? FixedCompanyRepresentativeName => _detail?.CompanyRepresentativeName ?? _admin?.CompanyRepresentativeName;
    private string CompanySigner => FixedCompanyRepresentativeName ?? _admin?.FullName ?? "Đại diện công ty";
    private string? FixedCompanySignature => _detail?.CompanyRepresentativeSignatureFileUrl ?? _admin?.CompanySignatureFileUrl;
    private DateTime? FixedCompanySignedAt => _detail?.CompanyRepresentativeSignedAt ?? _admin?.CompanySignedAt;
    private string FixedDriverName => _detail?.DriverName ?? _driver?.FullName ?? "—";
    private string? FixedDriverPhone => _detail?.DriverPhone ?? _driver?.PhoneNumber;
    private string? FixedDriverLicenseNumber => _detail?.DriverLicenseNumber ?? _driver?.DriverLicenseNumber;
    private string? FixedDriverLicenseClass => _detail?.DriverLicenseClass ?? _driver?.DriverLicenseClass;
    private string? FixedDriverSignature => _detail?.DriverSignatureFileUrl ?? _driver?.DriverSignatureFileUrl;
    private DateTime? FixedDriverSignedAt => _detail?.DriverSignedAt ?? _driver?.DriverSignedAt;

    private static string PartyName(SignatureParty party) => party == SignatureParty.VehicleOwner ? "chủ sở hữu xe" : "khách hàng";
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
