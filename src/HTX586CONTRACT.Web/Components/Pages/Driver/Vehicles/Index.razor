@page "/vehicle-owner/vehicles"
@attribute [Authorize(Roles = "VehicleOwner")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MasterSignatureService MasterSignatureService
@inject ISnackbar Snackbar

<PageTitle>Xe của tôi</PageTitle>

<div class="page-heading">
    <div>
        <MudText Typo="Typo.h4">Xe và chủ sở hữu</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Một tài khoản có thể được cấp nhiều xe thuộc nhiều Công ty/Văn phòng. Thông tin xe chỉ được xem; chữ ký tài xế được xác nhận một lần riêng cho từng xe.
        </MudText>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_vehicles.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Tài khoản chưa được gán xe. Vui lòng liên hệ Chủ hệ thống/Quản lý.
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var vehicle in _vehicles)
        {
            <MudItem xs="12" md="6" xl="4">
                <MudPaper Class="pa-4 h-100" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.h6">@vehicle.PlateNumber</MudText>
                            <MudText Typo="Typo.caption">@CompanyDisplay(vehicle)</MudText>
                        </div>
                        <MudSpacer />
                        <MudChip T="string" Size="Size.Small" Color="@(vehicle.AccountDriverSignedAt.HasValue ? Color.Success : Color.Warning)">
                            @(vehicle.AccountDriverSignedAt.HasValue ? "Đã ký theo xe" : "Chưa ký")
                        </MudChip>
                    </MudStack>

                    <MudSimpleTable Dense="true" Hover="false">
                        <tbody>
                            <tr><td>Mã xe</td><td>@Text(vehicle.VehicleCode)</td></tr>
                            <tr><td>Loại xe</td><td>@Text($"{vehicle.Brand} {vehicle.Model}".Trim())</td></tr>
                            <tr><td>Số chỗ</td><td>@(vehicle.SeatCount?.ToString() ?? "—")</td></tr>
                            <tr><td>Chủ sở hữu</td><td>@vehicle.OwnerName</td></tr>
                            <tr><td>CCCD chủ xe</td><td>@Text(vehicle.OwnerCitizenId)</td></tr>
                            <tr><td>Điện thoại chủ xe</td><td>@Text(vehicle.OwnerPhoneNumber)</td></tr>
                        </tbody>
                    </MudSimpleTable>

                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Chân ký Chủ xe từ tài khoản</MudText>
                    @if (!string.IsNullOrWhiteSpace(_vehicleOwnerSignatureUrl))
                    {
                        <img src="@($"{_vehicleOwnerSignatureUrl}?v={_vehicleOwnerSignedAt?.Ticks ?? 0}")" alt="Chân ký Chủ xe" style="max-width:100%;height:90px;object-fit:contain;border:1px solid var(--mud-palette-lines-default);border-radius:8px" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">Chủ hệ thống/Quản lý chưa cập nhật chữ ký chủ xe.</MudAlert>
                    }

                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Chữ ký tài xế cho xe này</MudText>
                    @if (!string.IsNullOrWhiteSpace(vehicle.AccountDriverSignatureFileUrl))
                    {
                        <SignaturePad Disabled="true"
                                      ExistingSignatureUrl="@vehicle.AccountDriverSignatureFileUrl"
                                      SignerName="@_fullName"
                                      SignedAt="@vehicle.AccountDriverSignedAt" />
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                            Chữ ký đã khóa. Cần thay đổi, vui lòng yêu cầu Chủ hệ thống/Quản lý hỗ trợ.
                        </MudAlert>
                    }
                    else
                    {
                        <SignaturePad Disabled="@_savingVehicleIds.Contains(vehicle.Id)"
                                      SignerName="@_fullName"
                                      ConfirmationButtonText="Xác nhận chữ ký cho xe"
                                      OnSignatureSaved="@(data => SaveVehicleSignatureAsync(vehicle, data))" />
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private readonly List<Vehicle> _vehicles = [];
    private readonly HashSet<Guid> _savingVehicleIds = [];
    private bool _loading = true;
    private string _userId = string.Empty;
    private string _fullName = string.Empty;
    private string? _vehicleOwnerSignatureUrl;
    private DateTime? _vehicleOwnerSignedAt;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        _fullName = auth.User.Identity?.Name ?? "Chủ xe";

        await using var db = await Factory.CreateDbContextAsync();
        var account = await db.Users.AsNoTracking()
            .Where(x => x.Id == _userId)
            .Select(x => new
            {
                x.FullName,
                x.VehicleOwnerSignatureFileUrl,
                x.VehicleOwnerSignedAt
            })
            .FirstOrDefaultAsync();
        if (account is not null)
        {
            _fullName = account.FullName;
            _vehicleOwnerSignatureUrl = account.VehicleOwnerSignatureFileUrl;
            _vehicleOwnerSignedAt = account.VehicleOwnerSignedAt;
        }
        _vehicles.Clear();
        _vehicles.AddRange(await db.Vehicles.AsNoTracking()
            .Include(x => x.OfficeVehicles)
                .ThenInclude(x => x.CompanyProfile)
            .Where(x => x.AssignedDriverId == _userId && x.IsActive)
            .OrderBy(x => x.PlateNumber)
            .ToListAsync());
        _loading = false;
    }

    private async Task SaveVehicleSignatureAsync(Vehicle vehicle, string dataUrl)
    {
        if (!_savingVehicleIds.Add(vehicle.Id))
            return;
        try
        {
            var url = await MasterSignatureService.SaveVehicleAccountDriverSignatureAsync(vehicle.Id, _userId, dataUrl);
            vehicle.AccountDriverSignatureFileUrl = url;
            vehicle.AccountDriverSignedAt = DateTime.UtcNow;
            Snackbar.Add($"Đã khóa chữ ký tài xế cho xe {vehicle.PlateNumber}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            throw;
        }
        finally
        {
            _savingVehicleIds.Remove(vehicle.Id);
        }
    }

    private static string CompanyDisplay(Vehicle vehicle)
    {
        var names = vehicle.OfficeVehicles
            .Where(x => x.IsActive && !x.IsDeleted && x.AssignedTo == null &&
                        x.CompanyProfile.IsActive && !x.CompanyProfile.IsDeleted)
            .OrderByDescending(x => x.IsPrimary)
            .ThenBy(x => x.CompanyProfile.CompanyName)
            .Select(x => string.IsNullOrWhiteSpace(x.CompanyProfile.BranchName)
                ? x.CompanyProfile.CompanyName
                : $"{x.CompanyProfile.CompanyName} - {x.CompanyProfile.BranchName}")
            .Distinct()
            .ToArray();
        return names.Length == 0 ? "Chưa gán Công ty/Văn phòng" : string.Join(", ", names);
    }

    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
