@page "/vehicle-owner/customers"
@attribute [Authorize(Roles = "VehicleOwner")]
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CustomerExcelImportService CustomerImportService
@inject ISnackbar Snackbar

<PageTitle>Khách hàng của tôi</PageTitle>
<PageHeader Title="Khách hàng của tôi" Subtitle="Tạo và quản lý danh bạ khách hàng dùng khi lập hợp đồng." />

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="5"><MudTextField T="string" @bind-Value="_keyword" Placeholder="Tìm tên, số điện thoại, CCCD..." Immediate="true" Clearable="true" Variant="Variant.Outlined" /></MudItem>
        <MudItem xs="12" md="7">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                <MudButton Href="/templates/Template_Import_Customer_HTX586.xlsx" download="Template_Import_Customer_HTX586.xlsx"
                           Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Disabled="@(_readingImportFile || _importing)">Tải mẫu</MudButton>
                <MudFileUpload @ref="_fileUpload" T="IBrowserFile" Accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                               FilesChanged="ReadImportFileAsync" MaximumFileCount="1" Disabled="@(_readingImportFile || _importing)">
                    <CustomContent Context="upload">
                        <MudButton Color="Color.Success" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                                   Disabled="@(_readingImportFile || _importing)" OnClick="@upload.OpenFilePickerAsync">
                            @(_readingImportFile ? "Đang đọc..." : "Import Excel")
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(_readingImportFile || _importing)" OnClick="NewCustomer">Thêm khách hàng</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_importPreview is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <div><MudText Typo="Typo.h6">Kiểm tra import khách hàng</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@_importPreview.FileName</MudText></div>
            <MudSpacer /><MudIconButton Icon="@Icons.Material.Filled.Close" Disabled="_importing" OnClick="CancelImport" />
        </MudStack>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Tổng @_importPreview.TotalRows</MudChip>
            <MudChip T="string" Color="Color.Success">Hợp lệ @_importPreview.ValidRows</MudChip>
            <MudChip T="string" Color="@(_importPreview.InvalidRows > 0 ? Color.Error : Color.Default)" Variant="Variant.Outlined">Lỗi @_importPreview.InvalidRows</MudChip>
        </MudStack>
        <MudTable T="CustomerImportRowPreview" Items="_importPreview.Rows" Dense="true" Hover="true" Striped="true" RowsPerPage="10" Loading="_importing">
            <HeaderContent><MudTh>Dòng</MudTh><MudTh>Loại</MudTh><MudTh>Khách hàng</MudTh><MudTh>Điện thoại</MudTh><MudTh>Trạng thái</MudTh><MudTh>Lỗi</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd>@context.RowNumber</MudTd><MudTd>@context.TypeDisplay</MudTd><MudTd>@context.DisplayName</MudTd><MudTd>@context.PhoneNumber</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.IsValid ? Color.Success : Color.Error)">@(context.IsValid ? "Hợp lệ" : "Lỗi")</MudChip></MudTd>
                <MudTd><MudText Typo="Typo.caption" Color="Color.Error">@context.ErrorMessage</MudText></MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager PageSizeOptions="@(new int[] { 10, 20, 50, 100 })" /></PagerContent>
        </MudTable>
        <MudStack Row="true" Class="mt-4"><MudButton Variant="Variant.Outlined" Disabled="_importing" OnClick="CancelImport">Hủy</MudButton><MudSpacer />
            <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Publish"
                       Disabled="@(_importing || _importPreview.ValidRows == 0)" OnClick="ConfirmImportAsync">
                @(_importing ? "Đang import..." : $"Import {_importPreview.ValidRows} khách hàng")
            </MudButton>
        </MudStack>
    </MudPaper>
}

@if (_editing)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="4"><MudSelect T="CustomerType" @bind-Value="_model.Type" Label="Loại khách hàng" Variant="Variant.Outlined"><MudSelectItem Value="@CustomerType.Individual">Cá nhân</MudSelectItem><MudSelectItem Value="@CustomerType.Organization">Đơn vị/Tổ chức</MudSelectItem></MudSelect></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.FullName" Label="Họ tên người liên hệ" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.PhoneNumber" Label="Số điện thoại" Required="true" Variant="Variant.Outlined" /></MudItem>
            @if (_model.Type == CustomerType.Organization)
            {
                <MudItem xs="12" md="8"><MudTextField @bind-Value="_model.OrganizationName" Label="Tên đơn vị/Tổ chức" Required="true" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.TaxCode" Label="Mã số thuế" Variant="Variant.Outlined" /></MudItem>
            }
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CitizenId" Label="CCCD" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.CitizenIdIssuedDate" Label="Ngày cấp CCCD" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CitizenIdIssuedPlace" Label="Nơi cấp CCCD" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_model.DateOfBirth" Label="Ngày sinh" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_model.Address" Label="Địa chỉ" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        <MudStack Row="true" Class="mt-4"><MudButton Variant="Variant.Outlined" OnClick="CancelEdit">Hủy</MudButton><MudSpacer /><MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">Lưu khách hàng</MudButton></MudStack>
    </MudPaper>
}

<MudTable T="Customer" Items="FilteredItems" Loading="_loading" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
    <HeaderContent><MudTh>Khách hàng</MudTh><MudTh>Loại</MudTh><MudTh>Điện thoại</MudTh><MudTh>CCCD/MST</MudTh><MudTh>Số HĐ</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Khách hàng"><b>@DisplayName(context)</b><br /><small>@context.Address</small></MudTd>
        <MudTd DataLabel="Loại">@(context.Type == CustomerType.Organization ? "Đơn vị" : "Cá nhân")</MudTd>
        <MudTd DataLabel="Điện thoại">@context.PhoneNumber</MudTd>
        <MudTd DataLabel="CCCD/MST">@(context.Type == CustomerType.Organization ? context.TaxCode : context.CitizenId)</MudTd>
        <MudTd DataLabel="Số HĐ">@context.ContractCount</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => Edit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private string _userId = string.Empty;
    private bool _loading;
    private bool _saving;
    private bool _editing;
    private bool _readingImportFile;
    private bool _importing;
    private string? _keyword;
    private List<Customer> _items = [];
    private Customer _model = NewModel();
    private CustomerImportPreview? _importPreview;
    private MudFileUpload<IBrowserFile>? _fileUpload;
    private IEnumerable<Customer> FilteredItems => string.IsNullOrWhiteSpace(_keyword) ? _items : _items.Where(x => Contains(DisplayName(x)) || Contains(x.PhoneNumber) || Contains(x.CitizenId) || Contains(x.TaxCode));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadAsync();
    }

    private async Task ReadImportFileAsync(IBrowserFile? file)
    {
        if (_readingImportFile || _importing) return;
        _readingImportFile = true; _importPreview = null; _editing = false;
        try
        {
            if (file is null) return;
            await using var stream = file.OpenReadStream(CustomerExcelImportService.MaximumFileSize);
            using var memory = new MemoryStream(); await stream.CopyToAsync(memory); memory.Position = 0;
            _importPreview = await CustomerImportService.PreviewAsync(memory, file.Name, _userId);
            Snackbar.Add($"Đã kiểm tra {_importPreview.TotalRows} dòng: {_importPreview.ValidRows} hợp lệ, {_importPreview.InvalidRows} lỗi.", _importPreview.InvalidRows == 0 ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { if (_fileUpload is not null) await _fileUpload.ClearAsync(); _readingImportFile = false; }
    }

    private async Task ConfirmImportAsync()
    {
        if (_importPreview is null || _importPreview.ValidRows == 0 || _importing) return;
        _importing = true;
        try
        {
            var original = _importPreview;
            var result = await CustomerImportService.ImportAsync(original.Rows, _userId);
            var failedRows = result.Errors.Select(x => x.RowNumber).ToHashSet();
            foreach (var error in result.Errors)
            {
                var row = original.Rows.FirstOrDefault(x => x.RowNumber == error.RowNumber);
                if (row is not null) ExcelImportUtility.AddError(row.Errors, error.Error);
            }
            original.Rows = original.Rows.Where(x => !x.IsValid || failedRows.Contains(x.RowNumber)).ToList();
            if (result.ImportedCount > 0) await LoadAsync();
            Snackbar.Add($"Đã import {result.ImportedCount} khách hàng; {result.FailedCount} dòng lỗi khi lưu.", result.FailedCount == 0 ? Severity.Success : Severity.Warning);
            if (original.Rows.Count == 0) CancelImport();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _importing = false; }
    }

    private void CancelImport() => _importPreview = null;

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            _items = await db.Customers.AsNoTracking().Where(x => !x.IsDeleted && !x.PhoneNumber.StartsWith("PEND") && x.CreatedByDriverId == _userId).OrderByDescending(x => x.LastUsedAt ?? x.CreatedAt).ToListAsync();
        }
        finally { _loading = false; }
    }

    private void NewCustomer() { _model = NewModel(); _model.CreatedByDriverId = _userId; _editing = true; }
    private void Edit(Customer customer)
    {
        _model = new Customer
        {
            Id = customer.Id,
            Type = customer.Type,
            FullName = customer.FullName,
            OrganizationName = customer.OrganizationName,
            TaxCode = customer.TaxCode,
            PhoneNumber = customer.PhoneNumber,
            CitizenId = customer.CitizenId,
            CitizenIdIssuedDate = customer.CitizenIdIssuedDate,
            CitizenIdIssuedPlace = customer.CitizenIdIssuedPlace,
            DateOfBirth = customer.DateOfBirth,
            Address = customer.Address,
            Email = customer.Email,
            CreatedByDriverId = _userId
        };
        _editing = true;
    }
    private void CancelEdit() { _editing = false; _model = NewModel(); }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.FullName) || string.IsNullOrWhiteSpace(_model.PhoneNumber))
        {
            Snackbar.Add("Vui lòng nhập họ tên và số điện thoại.", Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            var normalizedPhone = _model.PhoneNumber.Trim();
            var duplicatePhone = await db.Customers.AsNoTracking().AnyAsync(x =>
                !x.IsDeleted && x.CreatedByDriverId == _userId && x.Id != _model.Id && x.PhoneNumber == normalizedPhone);
            if (duplicatePhone)
                throw new InvalidOperationException("Số điện thoại đã có trong danh bạ của bạn. Hãy dùng hồ sơ cũ.");

            var entity = await db.Customers.FirstOrDefaultAsync(x => x.Id == _model.Id && !x.IsDeleted && x.CreatedByDriverId == _userId);
            if (entity is null)
            {
                entity = new Customer { Id = Guid.NewGuid(), CreatedByDriverId = _userId, CreatedBy = _userId, CreatedAt = DateTime.UtcNow };
                db.Customers.Add(entity);
            }
            entity.Type = _model.Type;
            entity.FullName = _model.FullName.Trim();
            entity.OrganizationName = N(_model.OrganizationName);
            entity.TaxCode = N(_model.TaxCode);
            entity.PhoneNumber = normalizedPhone;
            entity.CitizenId = N(_model.CitizenId);
            entity.CitizenIdIssuedDate = _model.CitizenIdIssuedDate?.Date;
            entity.CitizenIdIssuedPlace = N(_model.CitizenIdIssuedPlace);
            entity.DateOfBirth = _model.DateOfBirth?.Date;
            entity.Address = N(_model.Address);
            entity.Email = N(_model.Email);
            entity.UpdatedAt = DateTime.UtcNow;
            entity.UpdatedBy = _userId;
            await db.SaveChangesAsync();
            Snackbar.Add("Đã lưu khách hàng.", Severity.Success);
            _editing = false;
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await using var db = await Factory.CreateDbContextAsync();
            var entity = await db.Customers.FirstOrDefaultAsync(x => x.Id == id && !x.IsDeleted && x.CreatedByDriverId == _userId);
            if (entity is null) return;
            entity.IsDeleted = true;
            entity.DeletedAt = DateTime.UtcNow;
            entity.DeletedBy = _userId;
            entity.UpdatedAt = DateTime.UtcNow;
            entity.UpdatedBy = _userId;
            await db.SaveChangesAsync();
            Snackbar.Add("Đã ẩn khách hàng khỏi danh bạ cá nhân.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private bool Contains(string? value) => !string.IsNullOrWhiteSpace(value) && value.Contains(_keyword!.Trim(), StringComparison.OrdinalIgnoreCase);
    private static string DisplayName(Customer x) => x.Type == CustomerType.Organization && !string.IsNullOrWhiteSpace(x.OrganizationName) ? x.OrganizationName : x.FullName;
    private static Customer NewModel() => new() { Type = CustomerType.Individual };
    private static string? N(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
