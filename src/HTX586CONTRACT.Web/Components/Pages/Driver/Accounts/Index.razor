@page "/vehicle-owner/account"
@attribute [Authorize(Roles = "VehicleOwner")]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject MasterSignatureService MasterSignatureService
@inject ISnackbar Snackbar

<PageTitle>Tài khoản Chủ xe</PageTitle>
<PageHeader Title="Tài khoản cá nhân" Subtitle="Cập nhật thông tin liên hệ và kiểm tra toàn bộ xe được cấp cho tài khoản.">
    <MudButton Href="/vehicle-owner/vehicles" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DirectionsCar">
        Xe của tôi
    </MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_model is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy tài khoản Chủ xe.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" lg="7">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Thông tin tài khoản</MudText>
                @if (string.IsNullOrWhiteSpace(_model.VehicleOwnerSignatureFileUrl))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-3">
                        Đây là lần khai báo chân ký đầu tiên. Vui lòng hoàn tất chân ký Chủ xe bên dưới trước khi sử dụng các chức năng khác.
                    </MudAlert>
                }
                <MudGrid>
                    <MudItem xs="12" md="6"><MudTextField Value="@_model.UserName" Label="ID đăng nhập" Disabled="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField T="string" Value="@RoleDisplayName" Label="Vai trò" Disabled="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.FullName" Label="Họ tên" Required="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.PhoneNumber" Label="Số điện thoại" Required="true" HelperText="@VietnamPhoneNumber.ValidationMessage" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.CitizenId" Label="CCCD" Required="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudDatePicker @bind-Date="_model.CitizenIdIssuedDate" Label="Ngày cấp CCCD" DateFormat="dd/MM/yyyy" Editable="true" ImmediateText="true" Culture="@AppCulture.Vietnamese" Required="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.CitizenIdIssuedPlace" Label="Nơi cấp CCCD" Required="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_model.Address" Label="Địa chỉ chủ xe" Required="true" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                            Khi lưu, thông tin pháp lý trên sẽ được đồng bộ ngay sang toàn bộ xe đang thuộc tài khoản này.
                        </MudAlert>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1">Chân ký Chủ xe</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Mỗi hợp đồng mới sẽ tự động chụp chân ký này. Có thể ký trực tiếp hoặc upload file PNG.
                        </MudText>
                        <SignaturePad ExistingSignatureUrl="@SignatureUrl"
                                      SignerName="@_model.FullName"
                                      StrokeColor="#0066CC"
                                      StrokeWidth="1.5"
                                      SignedAt="@_model.VehicleOwnerSignedAt"
                                      OnSignatureSaved="SaveVehicleOwnerSignatureAsync"
                                      ConfirmationButtonText="Lưu chân ký Chủ xe" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Class="mt-4" Justify="Justify.FlexEnd">
                    <MudButton Color="Color.Warning" Variant="Variant.Outlined" Disabled="@(_saving || _resetting)" OnClick="ResetPasswordAsync">
                        Reset mật khẩu về Htx@586
                    </MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_saving || _resetting)" OnClick="SaveAsync">
                        Cập nhật thông tin
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">Xe được cấp</MudText>
                    <MudSpacer />
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@_vehicles.Count xe</MudChip>
                </MudStack>

                @if (_vehicles.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Chưa có xe. Tài khoản chưa thể tạo hoặc nhận hợp đồng.</MudAlert>
                }
                else
                {
                    @foreach (var vehicle in _vehicles)
                    {
                        <MudPaper Class="pa-3 mb-2" Outlined="true">
                            <MudText Typo="Typo.subtitle1"><b>@vehicle.PlateNumber</b></MudText>
                            <MudText Typo="Typo.body2">@vehicle.CompanyName</MudText>
                            <MudText Typo="Typo.caption">Chủ xe: @vehicle.OwnerName</MudText><br />
                            <MudChip T="string" Size="Size.Small" Color="@(!string.IsNullOrWhiteSpace(_model.VehicleOwnerSignatureFileUrl) ? Color.Success : Color.Warning)" Class="mt-2">
                                @(!string.IsNullOrWhiteSpace(_model.VehicleOwnerSignatureFileUrl) ? "Dùng chân ký tài khoản" : "Chưa có chân ký")
                            </MudChip>
                        </MudPaper>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private const string RoleName = "VehicleOwner";
    private const string RoleDisplayName = "Chủ xe";
    private const string ResetPassword = "Htx@586";
    private AccountModel? _model;
    private List<VehicleRow> _vehicles = [];
    private bool _loading = true;
    private bool _saving;
    private bool _resetting;
    private string? SignatureUrl => string.IsNullOrWhiteSpace(_model?.VehicleOwnerSignatureFileUrl)
        ? null
        : $"{_model.VehicleOwnerSignatureFileUrl}?v={_model.VehicleOwnerSignedAt?.Ticks ?? 0}";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
        {
            _loading = false;
            return;
        }

        using (var scope = ScopeFactory.CreateScope())
        {
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userManager.FindByIdAsync(userId);
            if (user is not null && !user.IsDeleted && await userManager.IsInRoleAsync(user, RoleName))
            {
                _model = new AccountModel
                {
                    Id = user.Id,
                    UserName = user.UserName ?? string.Empty,
                    FullName = user.FullName,
                    PhoneNumber = user.PhoneNumber,
                    Email = user.Email,
                    CitizenId = user.CitizenId,
                    CitizenIdIssuedDate = user.CitizenIdIssuedDate,
                    CitizenIdIssuedPlace = user.CitizenIdIssuedPlace,
                    Address = user.Address,
                    VehicleOwnerSignatureFileUrl = user.VehicleOwnerSignatureFileUrl,
                    VehicleOwnerSignedAt = user.VehicleOwnerSignedAt
                };
            }
        }

        await using (var db = await Factory.CreateDbContextAsync())
        {
            var vehicles = await db.Vehicles.AsNoTracking()
                .Include(x => x.AssignedDriver)
                .Include(x => x.OfficeVehicles)
                    .ThenInclude(x => x.CompanyProfile)
                .Where(x => x.AssignedDriverId == userId)
                .OrderBy(x => x.PlateNumber)
                .ToListAsync();

            _vehicles = vehicles.Select(x => new VehicleRow
            {
                PlateNumber = x.PlateNumber,
                OwnerName = x.AssignedDriver != null ? x.AssignedDriver.FullName : x.OwnerName,
                CompanyName = OfficeNames(x)
            }).ToList();
        }

        _loading = false;
    }

    private async Task SaveVehicleOwnerSignatureAsync(string dataUrl)
    {
        if (_model is null)
            return;

        try
        {
            var url = await MasterSignatureService.SaveVehicleOwnerAccountSignatureAsync(_model.Id, dataUrl);
            _model.VehicleOwnerSignatureFileUrl = url;
            _model.VehicleOwnerSignedAt = DateTime.UtcNow;
            Snackbar.Add("Đã lưu chân ký Chủ xe. Các xe và hợp đồng mới sẽ sử dụng trực tiếp chân ký từ tài khoản này.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            throw;
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null || string.IsNullOrWhiteSpace(_model.FullName))
        {
            Snackbar.Add("Vui lòng nhập họ tên.", Severity.Warning);
            return;
        }
        if (!VietnamPhoneNumber.TryNormalize(_model.PhoneNumber, out var phone))
        {
            Snackbar.Add(VietnamPhoneNumber.ValidationMessage, Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.CitizenId) ||
            !_model.CitizenIdIssuedDate.HasValue ||
            string.IsNullOrWhiteSpace(_model.CitizenIdIssuedPlace) ||
            string.IsNullOrWhiteSpace(_model.Address))
        {
            Snackbar.Add("Vui lòng nhập đầy đủ CCCD, ngày cấp, nơi cấp và địa chỉ chủ xe.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userManager.FindByIdAsync(_model.Id);
            if (user is null || user.IsDeleted || !await userManager.IsInRoleAsync(user, RoleName))
                throw new InvalidOperationException("Không tìm thấy tài khoản Chủ xe.");

            var duplicate = await userManager.Users.AsNoTracking().AnyAsync(x =>
                x.Id != user.Id && !x.IsDeleted && x.PhoneNumber == phone);
            if (duplicate)
                throw new InvalidOperationException("Số điện thoại đang được tài khoản khác sử dụng.");

            user.FullName = _model.FullName.Trim();
            user.PhoneNumber = phone;
            user.Email = N(_model.Email);
            user.CitizenId = N(_model.CitizenId);
            user.CitizenIdIssuedDate = _model.CitizenIdIssuedDate?.Date;
            user.CitizenIdIssuedPlace = N(_model.CitizenIdIssuedPlace);
            user.Address = N(_model.Address);
            user.UpdatedAt = DateTime.UtcNow;
            user.UpdatedByUserId = user.Id;
            var result = await userManager.UpdateAsync(user);
            if (!result.Succeeded)
                throw new InvalidOperationException(string.Join("; ", result.Errors.Select(x => x.Description)));

            await using (var db = await Factory.CreateDbContextAsync())
            {
                var vehicles = await db.Vehicles
                    .Where(x => x.AssignedDriverId == user.Id && !x.IsDeleted)
                    .ToListAsync();
                var now = DateTime.UtcNow;
                foreach (var vehicle in vehicles)
                {
                    vehicle.OwnerName = user.FullName.Trim();
                    vehicle.OwnerPhoneNumber = N(user.PhoneNumber);
                    vehicle.OwnerCitizenId = N(user.CitizenId);
                    vehicle.OwnerCitizenIdIssuedDate = user.CitizenIdIssuedDate?.Date;
                    vehicle.OwnerCitizenIdIssuedPlace = N(user.CitizenIdIssuedPlace);
                    vehicle.OwnerAddress = N(user.Address);
                    vehicle.UpdatedAt = now;
                    vehicle.UpdatedBy = user.Id;
                }
                await db.SaveChangesAsync();
            }

            foreach (var vehicle in _vehicles)
                vehicle.OwnerName = user.FullName;

            Snackbar.Add("Đã cập nhật hồ sơ Chủ xe và đồng bộ thông tin pháp lý sang các xe đang sở hữu.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task ResetPasswordAsync()
    {
        if (_model is null) return;
        _resetting = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userManager.FindByIdAsync(_model.Id)
                ?? throw new InvalidOperationException("Không tìm thấy tài khoản.");
            var token = await userManager.GeneratePasswordResetTokenAsync(user);
            var result = await userManager.ResetPasswordAsync(user, token, ResetPassword);
            if (!result.Succeeded)
                throw new InvalidOperationException(string.Join("; ", result.Errors.Select(x => x.Description)));
            user.MustChangePassword = true;
            user.UpdatedAt = DateTime.UtcNow;
            await userManager.UpdateAsync(user);
            Snackbar.Add($"Đã reset mật khẩu về {ResetPassword}.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _resetting = false; }
    }


    private static string OfficeNames(Vehicle vehicle)
    {
        var names = vehicle.OfficeVehicles
            .Where(x => x.IsActive && !x.IsDeleted && x.AssignedTo == null &&
                        x.CompanyProfile.IsActive && !x.CompanyProfile.IsDeleted)
            .OrderByDescending(x => x.IsPrimary)
            .ThenBy(x => x.CompanyProfile.CompanyName)
            .Select(x => string.IsNullOrWhiteSpace(x.CompanyProfile.BranchName)
                ? x.CompanyProfile.CompanyName
                : $"{x.CompanyProfile.CompanyName} - {x.CompanyProfile.BranchName}")
            .Distinct()
            .ToArray();
        return names.Length == 0 ? "Chưa gán Công ty/Văn phòng" : string.Join(", ", names);
    }

    private static string? N(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class AccountModel
    {
        public string Id { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string? PhoneNumber { get; set; }
        public string? Email { get; set; }
        public string? CitizenId { get; set; }
        public DateTime? CitizenIdIssuedDate { get; set; }
        public string? CitizenIdIssuedPlace { get; set; }
        public string? Address { get; set; }
        public string? VehicleOwnerSignatureFileUrl { get; set; }
        public DateTime? VehicleOwnerSignedAt { get; set; }
    }

    private sealed class VehicleRow
    {
        public string PlateNumber { get; set; } = string.Empty;
        public string CompanyName { get; set; } = string.Empty;
        public string OwnerName { get; set; } = string.Empty;
    }
}
