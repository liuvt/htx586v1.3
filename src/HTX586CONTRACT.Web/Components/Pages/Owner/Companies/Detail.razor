@page "/owner/companies/{Id:guid}"
@attribute [Authorize(Roles = "Owner")]
@implements IAsyncDisposable
@inject ICompanyProfileService CompanyService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject MasterSignatureService MasterSignatureService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Chi tiết đơn vị</PageTitle>
<PageHeader Title="Chi tiết công ty / văn phòng" Subtitle="Quản lý thông tin chính và thông tin phụ của công ty / văn phòng.">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        <MudChip T="string"
                 Size="Size.Small"
                 Color="@(_isEditing ? Color.Warning : Color.Default)"
                 Variant="Variant.Outlined"
                 Icon="@(_isEditing ? Icons.Material.Filled.Edit : Icons.Material.Filled.Lock)">
            @(_isEditing ? "Đang chỉnh sửa" : "Chế độ xem")
        </MudChip>

        @if (!_isEditing && !_loading && _detail is not null)
        {
            <MudTooltip Text="Mở khóa để chỉnh sửa thông tin">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               Disabled="@(_saving || _deleting)"
                               OnClick="BeginEdit"
                               title="Chỉnh sửa thông tin đơn vị" />
            </MudTooltip>
        }
    </MudStack>
</PageHeader>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Error">Không tìm thấy đơn vị.</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12">
            <MudPaper Class="company-hero pa-5" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled" Class="hero-avatar">
                        <MudIcon Icon="@Icons.Material.Filled.Apartment" />
                    </MudAvatar>

                    <div>
                        <MudText Typo="Typo.h5" Class="fw-600">@_detail.CompanyName</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@DisplayBranch(_detail.BranchName)</MudText>
                        <MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Color="@(_model.IsActive ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                                @(_model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">MST: @Display(_detail.TaxCode)</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Người đại diện: @Display(_detail.RepresentativeName)</MudChip>
                        </MudStack>
                    </div>

                    <MudSpacer />

                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudPaper Class="metric-pill pa-3" Elevation="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Tài khoản Quản lý</MudText>
                            <MudText Typo="Typo.subtitle1">@_detail.AdminCount</MudText>
                        </MudPaper>
                        <MudPaper Class="metric-pill pa-3" Elevation="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Chủ xe đang cấp xe</MudText>
                            <MudText Typo="Typo.subtitle1">@_detail.DriverCount</MudText>
                        </MudPaper>
                        <MudPaper Class="metric-pill pa-3" Elevation="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Số xe</MudText>
                            <MudText Typo="Typo.subtitle1">@_detail.VehicleCount</MudText>
                        </MudPaper>
                        <MudPaper Class="metric-pill pa-3" Elevation="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Số hợp đồng</MudText>
                            <MudText Typo="Typo.subtitle1">@_detail.ContractCount</MudText>
                        </MudPaper>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudTabs Elevation="0" Class="company-tabs">
                <MudTabPanel Text="Thông tin chính">
                    <MudGrid Spacing="3" Class="pt-3">
                        <MudItem xs="12" md="6">
                            <MudPaper Class="detail-section pa-4 fill-height" Elevation="1">
                                <MudText Typo="Typo.h6">Thông tin đơn vị</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Thông tin cơ bản của công ty / văn phòng đại diện.</MudText>
                                <MudDivider Class="mb-3" />
                                <MudGrid>
                                    <MudItem xs="12"><MudTextField @bind-Value="_model.CompanyName" Label="Tên đơn vị" Required="true" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12"><MudTextField @bind-Value="_model.BranchName" Label="Tên chi nhánh / văn phòng" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.TaxCode" Label="Mã số thuế" Required="true" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.BusinessLicenseNumber" Label="Giấy phép kinh doanh" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12"><MudTextField @bind-Value="_model.Address" Label="Địa chỉ" Required="true" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudPaper Class="detail-section pa-4 fill-height" Elevation="1">
                                <MudText Typo="Typo.h6">Thông tin người đại diện</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Dữ liệu pháp lý dùng để in hợp đồng và hồ sơ liên quan.</MudText>
                                <MudDivider Class="mb-3" />
                                <MudGrid>
                                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.RepresentativeName" Label="Người đại diện" Required="true" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.RepresentativePosition" Label="Chức vụ" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.RepresentativeCitizenId" Label="CCCD người đại diện" Required="true" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudDatePicker @bind-Date="_model.RepresentativeCitizenIdIssuedDate"
                                                       Label="Ngày cấp CCCD"
                                                       Variant="Variant.Outlined"
                                                       DateFormat="dd/MM/yyyy"
                                                       Editable="true"
                                                       ImmediateText="true"
                                                       Placeholder="dd/MM/yyyy"
                                                       Culture="@AppCulture.Vietnamese"
                                                       AutoClose="true"
                                                       Disabled="@IsFormLocked" />
                                    </MudItem>
                                    <MudItem xs="12"><CitizenIdIssuedPlaceInput @bind-Value="_model.RepresentativeCitizenIdIssuedPlace" Disabled="@IsFormLocked" /></MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudPaper Class="detail-section pa-4 fill-height" Elevation="1">
                                <MudText Typo="Typo.h6">Liên hệ & tài chính</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Thông tin kết nối và tài khoản ngân hàng của đơn vị.</MudText>
                                <MudDivider Class="mb-3" />
                                <MudGrid>
                                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.PhoneNumber" Label="Điện thoại" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.BankAccountNumber" Label="Số tài khoản" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.BankName" Label="Ngân hàng" Variant="Variant.Outlined" Disabled="@IsFormLocked" /></MudItem>
                                    <MudItem xs="12">
                                        <MudPaper Class="soft-box pa-3" Elevation="0">
                                            <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Success" Label="Đơn vị đang hoạt động" Disabled="@IsFormLocked" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Tắt trạng thái nếu tạm ngưng khai thác hoặc dừng tiếp nhận hợp đồng mới.</MudText>
                                        </MudPaper>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudPaper Class="detail-section pa-4 fill-height" Elevation="1">
                                <MudText Typo="Typo.h6">Chữ ký người đại diện</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Hợp đồng sẽ tự động lấy chữ ký này khi xuất biểu mẫu.</MudText>
                                <MudDivider Class="mb-3" />
                                <SignaturePad ExistingSignatureUrl="@_detail.RepresentativeSignatureFileUrl"
                                              SignerName="@_detail.RepresentativeName"
                                              SignedAt="@_detail.RepresentativeSignedAt"
                                              Disabled="@IsFormLocked"
                                              OnSignatureSaved="SaveCompanySignatureAsync" />

                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                                    Đơn vị này hiện có @_detail.AdminCount tài khoản Quản lý, @_detail.DriverCount Chủ xe đang được cấp xe, @_detail.VehicleCount xe và @_detail.ContractCount hợp đồng.
                                </MudAlert>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Thông tin phụ">
                    <MudPaper Class="detail-section pa-4 mt-3" Elevation="1">
                        <MudText Typo="Typo.h6">Thông tin phụ</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Thông tin bổ sung của đơn vị dùng trên hợp đồng và hồ sơ liên quan.</MudText>
                        <MudDivider Class="mb-3" />
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.BusinessLicenseIssuedPlace"
                                              Label="Nơi cấp phép"
                                              Variant="Variant.Outlined"
                                              Disabled="@IsFormLocked" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.ComplaintContact"
                                              Label="Liên hệ phản ánh"
                                              HelperText="Được chụp snapshot vào hợp đồng khi tạo/phát hợp đồng."
                                              Variant="Variant.Outlined"
                                              Disabled="@IsFormLocked" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudTabPanel>
            </MudTabs>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/owner/companies"))">Quay lại danh sách</MudButton>
                    <MudButton Color="Color.Error"
                               Variant="Variant.Outlined"
                               Disabled="@(IsFormLocked || _saving || _deleting)"
                               StartIcon="@Icons.Material.Filled.DeleteOutline"
                               OnClick="DeleteAsync">
                        Xóa mềm
                    </MudButton>
                    <MudSpacer />
                    @if (_isEditing)
                    {
                        <MudButton Color="Color.Default"
                                   Variant="Variant.Outlined"
                                   Disabled="@(_saving || _deleting)"
                                   StartIcon="@Icons.Material.Filled.Close"
                                   OnClick="CancelEdit">
                            Hủy
                        </MudButton>
                    }
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               Disabled="@(IsFormLocked || _saving || _deleting)"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAsync">
                        @(_saving ? "Đang lưu..." : "Lưu thay đổi")
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<style>
    .company-hero {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(16,185,129,0.05));
    }

    .hero-avatar {
        font-size: 1.25rem;
    }

    .metric-pill {
        min-width: 145px;
        border-radius: 16px;
        background: rgba(255,255,255,0.72);
        border: 1px solid rgba(15, 23, 42, 0.08);
    }

    .detail-section {
        border-radius: 22px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        background: #fff;
    }

    .soft-box {
        border-radius: 16px;
        background: rgba(15, 23, 42, 0.03);
        border: 1px dashed rgba(15, 23, 42, 0.12);
    }

    .fill-height {
        height: 100%;
    }
</style>

@code {
    [Parameter] public Guid Id { get; set; }
    private CompanyProfileDto? _detail;
    private UpdateCompanyProfileRequest _model = new();
    private bool _loading = true;
    private bool _saving;
    private bool _deleting;
    private bool _isEditing;
    private DotNetObjectReference<Detail>? _dotNetReference;
    private string? _tabSyncToken;

    private bool IsFormLocked => !_isEditing || _saving || _deleting;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _detail = await CompanyService.GetByIdAsync(Id);
            if (_detail is not null)
            {
                ResetModelFromDetail();
                _isEditing = false;
            }
        }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dotNetReference = DotNetObjectReference.Create(this);

        try
        {
            _tabSyncToken = await JS.InvokeAsync<string>(
                "htx586CompanyTabSync.register",
                _dotNetReference,
                Id.ToString("D"));
        }
        catch (JSDisconnectedException)
        {
            // Circuit vừa đóng; không cần đăng ký đồng bộ tab.
        }
        catch (JSException)
        {
            // Không làm hỏng trang nếu browser chặn API đồng bộ tab.
        }
    }

    [JSInvokable]
    public async Task HandleCompanyChangedInAnotherTabAsync()
    {
        if (_loading || _saving || _deleting)
            return;

        try
        {
            _loading = true;
            _isEditing = false;

            _detail = await CompanyService.GetByIdAsync(Id);
            if (_detail is not null)
                ResetModelFromDetail();

            Snackbar.Add(
                "Dữ liệu đơn vị vừa thay đổi ở tab khác. Màn hình đã được đồng bộ và khóa chỉnh sửa.",
                Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể đồng bộ dữ liệu từ tab khác: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PublishCompanyChangedAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("htx586CompanyTabSync.publish", Id.ToString("D"));
        }
        catch (JSDisconnectedException)
        {
            // Browser đang rời trang hoặc circuit vừa mất kết nối.
        }
        catch (JSException)
        {
            // Đồng bộ tab là lớp bảo vệ bổ sung, không được làm thất bại thao tác lưu.
        }
    }

    private async Task SaveCompanySignatureAsync(string data)
    {
        if (!_isEditing || _saving || _deleting)
            return;

        try
        {
            await MasterSignatureService.SaveCompanyRepresentativeSignatureAsync(Id, data);
            Snackbar.Add("Đã lưu chữ ký cố định người đại diện.", Severity.Success);
            _detail = await CompanyService.GetByIdAsync(Id);
            await PublishCompanyChangedAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync()
    {
        if (!_isEditing || _deleting || _saving)
            return;

        _deleting = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            await CompanyService.DeleteAsync(Id, userId);
            await PublishCompanyChangedAsync();
            Snackbar.Add("Đã xóa mềm Công ty/Văn phòng. Dữ liệu hợp đồng lịch sử vẫn được giữ nguyên.", Severity.Success);
            Navigation.NavigateTo("/owner/companies");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!_isEditing || _saving || _deleting)
            return;

        _saving = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _model.UpdatedByUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
            await CompanyService.UpdateAsync(Id, _model);
            _detail = await CompanyService.GetByIdAsync(Id);

            if (_detail is not null)
                ResetModelFromDetail();

            _isEditing = false;
            await PublishCompanyChangedAsync();
            Snackbar.Add("Đã cập nhật đơn vị.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void BeginEdit()
    {
        if (_saving || _deleting)
            return;

        ResetModelFromDetail();
        _isEditing = true;
    }

    private void CancelEdit()
    {
        if (_saving || _deleting)
            return;

        ResetModelFromDetail();
        _isEditing = false;
    }

    private void ResetModelFromDetail()
    {
        if (_detail is null)
            return;

        _model = new UpdateCompanyProfileRequest
        {
            CompanyName = _detail.CompanyName,
            BranchName = _detail.BranchName,
            TaxCode = _detail.TaxCode,
            BusinessLicenseNumber = _detail.BusinessLicenseNumber,
            BusinessLicenseIssuedPlace = _detail.BusinessLicenseIssuedPlace ?? CompanyProfile.DefaultBusinessLicenseIssuedPlace,
            Address = _detail.Address,
            PhoneNumber = _detail.PhoneNumber,
            Email = _detail.Email,
            ComplaintContact = _detail.ComplaintContact,
            RepresentativeName = _detail.RepresentativeName,
            RepresentativePosition = _detail.RepresentativePosition,
            RepresentativeCitizenId = _detail.RepresentativeCitizenId,
            RepresentativeCitizenIdIssuedDate = _detail.RepresentativeCitizenIdIssuedDate,
            RepresentativeCitizenIdIssuedPlace = _detail.RepresentativeCitizenIdIssuedPlace,
            BankAccountNumber = _detail.BankAccountNumber,
            BankName = _detail.BankName,
            IsActive = _detail.IsActive
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrWhiteSpace(_tabSyncToken))
        {
            try
            {
                await JS.InvokeVoidAsync("htx586CompanyTabSync.unregister", _tabSyncToken);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        _dotNetReference?.Dispose();
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DisplayBranch(string? branchName) => string.IsNullOrWhiteSpace(branchName) ? "Công ty chính" : branchName;
}
