    private async Task<string> SavePreviewDocxFileAsync(byte[] bytes, string prefix)
    {
        var segments = new[] { "templates", "sub-contracts" };
        var directory = Storage.GetPhysicalDirectory(segments);
        Directory.CreateDirectory(directory);

        var targetSlug = SelectedCompany?.TaxCode
            ?? (_selectedTargetKey == PresetCaoSonKey ? "CaoSonCar" : "MekongXanh");
        var safeSlug = string.Concat(targetSlug.Where(ch => char.IsLetterOrDigit(ch) || ch is '-' or '_'));
        if (string.IsNullOrWhiteSpace(safeSlug))
            safeSlug = "DonVi";

        var fileName = $"{prefix}-HDP-{safeSlug}-{DateTime.UtcNow:yyyyMMddHHmmss}.docx";
        var fullPath = Path.Combine(directory, fileName);
        await File.WriteAllBytesAsync(fullPath, bytes);
        return Storage.BuildRelativeUrl(segments, fileName);
    }

    private async Task OnDocxInputFileChangedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        if (!file.Name.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Vui lòng chọn đúng định dạng file Word (.docx).", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var companyName = SelectedCompany?.CompanyName
                ?? (_selectedTargetKey == PresetCaoSonKey ? "CAO SƠN CAR" : "HTX CỘNG ĐỒNG MEKONG XANH");
            var taxCode = SelectedCompany?.TaxCode
                ?? (_selectedTargetKey == PresetCaoSonKey ? "0319340385-001" : "0316700428-002");

            var imported = await TemplateService.ImportFromDocxAsync(
                AuthenticationStateProvider,
                SelectedCompany?.Id,
                stream,
                file.Name,
                companyName,
                taxCode);

            _editingTemplate = imported;
            LoadTargetIntoEditor(_selectedTargetKey);
            Snackbar.Add($"Đã nạp và lưu nội dung từ file Word '{file.Name}' cho Đơn vị đang chọn.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể đọc file Word (.docx): {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

