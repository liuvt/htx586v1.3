                                }
                                <div class="a4-signature-space">(Chữ ký Khách hàng)</div>
                                <div class="a4-bold">@RenderLine("{{SIG_CUSTOMER_NAME}}")</div>
                            </div>
                            <div class="a4-signature-col">
                                <div class="a4-bold">@RenderLine(_editingTemplate.Page2SigRightTitle)</div>
                                @if (!string.IsNullOrWhiteSpace(_editingTemplate.Page2SigRightSubTitle))
