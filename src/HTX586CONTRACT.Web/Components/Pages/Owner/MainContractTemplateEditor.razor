@code {
    private const string DefaultTargetKey = "DEFAULT";

    private bool _authChecked;
    private bool _isOwner;
    private bool _loading = true;
    private bool _saving;
    private bool _previewWithSampleData = true;
    private ContractBusinessType _selectedBusinessType = ContractBusinessType.Passenger;
    private string _selectedTargetKey = DefaultTargetKey;
    private bool _isCustomForSelectedCompany;

    private List<CompanyProfile> _companies = [];
    private MainContractTemplateDto _editingTemplate = MainContractTemplateService.CreateDefaultPreset(ContractBusinessType.Passenger);
    private Dictionary<string, string> _samplePlaceholders = new(StringComparer.OrdinalIgnoreCase);

    private CompanyProfile? SelectedCompany
        => Guid.TryParse(_selectedTargetKey, out var id)
            ? _companies.FirstOrDefault(x => x.Id == id)
            : null;

    private string TargetStatusBadgeText
    {
        get
        {
            var typeName = _selectedBusinessType == ContractBusinessType.Cargo
                ? "HĐ Vận chuyển Hàng hóa"
                : "HĐ Vận chuyển Hành khách";

            if (_selectedTargetKey == DefaultTargetKey)
                return $"Mẫu gốc mặc định toàn hệ thống ({typeName})";

            return _isCustomForSelectedCompany
                ? $"Mẫu tùy chỉnh riêng ({typeName}): {SelectedCompany?.CompanyName}"
                : $"Đang kế thừa mẫu mặc định ({typeName}): {SelectedCompany?.CompanyName}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _isOwner = auth.User.Identity?.IsAuthenticated == true && auth.User.IsInRole("Owner");
            _authChecked = true;

            if (!_isOwner)
                return;

            await using var db = await Factory.CreateDbContextAsync();
            _companies = await db.CompanyProfiles.AsNoTracking()
                .Where(x => x.IsActive && !x.IsDeleted)
                .OrderBy(x => x.CompanyName)
                .ToListAsync();

            LoadTargetIntoEditor();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnBusinessTypeChangedAsync(ContractBusinessType businessType)
    {
        _selectedBusinessType = businessType;
        LoadTargetIntoEditor();
        return Task.CompletedTask;
    }

    private Task OnTargetChangedAsync(string newKey)
    {
        _selectedTargetKey = newKey;
        LoadTargetIntoEditor();
        return Task.CompletedTask;
    }

    private void LoadTargetIntoEditor()
    {
        if (_selectedTargetKey == DefaultTargetKey)
        {
            _editingTemplate = TemplateService.GetTemplate(_selectedBusinessType, companyProfileId: null);
            _isCustomForSelectedCompany = false;
            _samplePlaceholders = MainContractTemplateService.BuildSamplePlaceholders(_companies.FirstOrDefault());
            return;
        }

        if (Guid.TryParse(_selectedTargetKey, out var companyId))
        {
            var company = _companies.FirstOrDefault(x => x.Id == companyId);
            _isCustomForSelectedCompany = TemplateService.HasCustomCompanyTemplate(_selectedBusinessType, companyId);
            _editingTemplate = TemplateService.GetTemplate(_selectedBusinessType, companyId, company?.CompanyName);
            _samplePlaceholders = MainContractTemplateService.BuildSamplePlaceholders(company);
        }
    }

    private async Task SaveTemplateAsync()
    {
        if (_saving)
            return;

        _saving = true;
        try
        {
            var companyId = SelectedCompany?.Id;
            await TemplateService.SaveTemplateAsync(
                AuthenticationStateProvider,
                _selectedBusinessType,
                companyId,
                _editingTemplate);

            var typeLabel = _selectedBusinessType == ContractBusinessType.Cargo ? "HĐ Hàng hóa" : "HĐ Hành khách";
            Snackbar.Add(
                companyId.HasValue
                    ? $"Đã lưu mẫu {typeLabel} riêng cho đơn vị '{SelectedCompany?.CompanyName}'."
                    : $"Đã lưu mẫu {typeLabel} mặc định toàn hệ thống.",
                Severity.Success);

            LoadTargetIntoEditor();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetToDefaultAsync()
    {
        if (_saving)
            return;

        _saving = true;
        try
        {
            var companyId = SelectedCompany?.Id;
            await TemplateService.ResetToDefaultAsync(
                AuthenticationStateProvider,
                _selectedBusinessType,
                companyId,
                SelectedCompany?.CompanyName);

            Snackbar.Add("Đã khôi phục mẫu Hợp đồng chính về bản convert từ PDF gốc.", Severity.Success);
            LoadTargetIntoEditor();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DownloadTemplateDocxAsync()
    {
        try
        {
            var bytes = TemplateService.ExportTemplateAsDocxBytes(_editingTemplate, replacements: null);
            var url = await SavePreviewDocxFileAsync(bytes, "Mau-Bien-Dong");
            await JS.InvokeVoidAsync("open", url, "_blank");
            Snackbar.Add("Đã xuất file Word (.docx) 2 trang chứa các biến {{...}}. Bạn có thể chỉnh sửa trên Word rồi Upload lại.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DownloadSampleFilledDocxAsync()
    {
        try
        {
            var bytes = TemplateService.ExportTemplateAsDocxBytes(_editingTemplate, _samplePlaceholders);
            var url = await SavePreviewDocxFileAsync(bytes, "Xem-Truoc-Da-Dien");
            await JS.InvokeVoidAsync("open", url, "_blank");
            Snackbar.Add("Đã xuất file Word (.docx) 2 trang điền sẵn dữ liệu mẫu.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task<string> SavePreviewDocxFileAsync(byte[] bytes, string prefix)
    {
        var segments = new[] { "templates", "main-contracts" };
        var directory = Storage.GetPhysicalDirectory(segments);
        Directory.CreateDirectory(directory);

        var typeSlug = _selectedBusinessType == ContractBusinessType.Cargo ? "HD-HangHoa" : "HD-HanhKhach";
        var targetSlug = SelectedCompany?.TaxCode ?? "MacDinh";
        var fileName = $"{typeSlug}-{prefix}-{targetSlug}-{DateTime.UtcNow:yyyyMMddHHmmss}.docx";
        var fullPath = Path.Combine(directory, fileName);
        await File.WriteAllBytesAsync(fullPath, bytes);
        return Storage.BuildRelativeUrl(segments, fileName);
    }

    private async Task OnDocxInputFileChangedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        if (!file.Name.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Vui lòng chỉ chọn file Word định dạng .docx.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            _editingTemplate = await TemplateService.ImportFromDocxAsync(
                AuthenticationStateProvider,
                _selectedBusinessType,
                SelectedCompany?.Id,
                stream,
                file.Name,
                SelectedCompany?.CompanyName);

            LoadTargetIntoEditor();
            Snackbar.Add($"Đã nạp và lưu mẫu Hợp đồng chính từ file Word '{file.Name}'.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CopyPlaceholderAsync(string token)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", token);
            Snackbar.Add($"Đã sao chép biến {token}", Severity.Info);
        }
        catch
        {
            Snackbar.Add($"Biến: {token}", Severity.Info);
        }
    }

    private string RenderLine(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        return _previewWithSampleData
            ? MainContractTemplateService.ReplacePlaceholders(text, _samplePlaceholders)
            : text;
    }

    private static IEnumerable<string> SplitLines(string? block)
    {
        if (string.IsNullOrWhiteSpace(block))
            return [];

        return block
            .Replace("\r\n", "\n")
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x));
    }

    private static DateTime VietnamTime(DateTime utc)
        => utc.Kind == DateTimeKind.Utc ? utc.AddHours(7) : utc;
}
