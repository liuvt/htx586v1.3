@page "/owner/main-contract-templates"
@attribute [Authorize(Roles = "Owner")]
@inject MainContractTemplateService TemplateService
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUploadFileStorage Storage
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Quản lý mẫu Hợp đồng chính (Web &amp; Word)</PageTitle>
<PageHeader Title="Quản lý mẫu Hợp đồng chính (2 trang A4 — Hành khách &amp; Hàng hóa)"
            Subtitle="Đã convert 100% từ 2 mẫu PDF gốc (HopDongVanChuyenHanhKhach.template.pdf &amp; HopDongVanChuyenHangHoa.template.pdf) sang Web &amp; Word (.docx). Chỉ Owner mới có quyền chỉnh sửa." />

@if (!_authChecked || _loading)
{
    <MudPaper Class="pa-6" Outlined="true">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">Đang tải cấu hình mẫu Hợp đồng chính (2 trang)...</MudText>
        </MudStack>
    </MudPaper>
}
else if (!_isOwner)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
        Chỉ tài khoản <b>Owner (Chủ hệ thống)</b> mới có quyền truy cập và chỉnh sửa mẫu Hợp đồng chính.
    </MudAlert>
}
else
{
    <MudStack Spacing="3" Class="maincontract-editor-page">
        <!-- THANH CÔNG CỤ CHỌN LOẠI HỢP ĐỒNG + ĐƠN VỊ + WORD (.DOCX) + LƯU -->
        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="3">
                    <MudSelect T="ContractBusinessType"
                               Label="1. Chọn loại Hợp đồng chính (2 trang)"
                               Value="@_selectedBusinessType"
                               ValueChanged="OnBusinessTypeChangedAsync"
                               Variant="Variant.Outlined"
                               Dense="true"
                               AdornmentIcon="@(_selectedBusinessType == ContractBusinessType.Cargo ? Icons.Material.Filled.LocalShipping : Icons.Material.Filled.DirectionsBus)"
                               AdornmentColor="Color.Primary">
                        <MudSelectItem T="ContractBusinessType" Value="ContractBusinessType.Passenger">
                            HĐ Vận chuyển Hành khách (2 trang + DS khách)
                        </MudSelectItem>
                        <MudSelectItem T="ContractBusinessType" Value="ContractBusinessType.Cargo">
                            HĐ Vận chuyển Hàng hóa (2 trang + Giấy vận tải)
                        </MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Label="2. Phạm vi áp dụng (Toàn hệ thống hoặc theo Đơn vị)"
                               Value="@_selectedTargetKey"
                               ValueChanged="OnTargetChangedAsync"
                               Variant="Variant.Outlined"
                               Dense="true"
                               AdornmentIcon="@Icons.Material.Filled.Apartment"
                               AdornmentColor="Color.Primary">
                        <MudSelectItem T="string" Value="@DefaultTargetKey">
                            [Mẫu gốc mặc định toàn hệ thống] — Convert từ PDF gốc
                        </MudSelectItem>
                        @foreach (var company in _companies)
                        {
                            <MudSelectItem T="string" Value="@company.Id.ToString()">
                                @company.CompanyName @(TemplateService.HasCustomCompanyTemplate(_selectedBusinessType, company.Id) ? " — [Đã tùy chỉnh riêng]" : " — [Đang kế thừa mặc định]")
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@_saving"
                                   OnClick="SaveTemplateAsync">
                            @(_saving ? "Đang lưu..." : "Lưu mẫu HĐ chính")
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@_saving"
                                   OnClick="DownloadTemplateDocxAsync">
                            Tải mẫu Word (.docx)
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   Disabled="@_saving"
                                   OnClick="DownloadSampleFilledDocxAsync">
                            Tải Word (.docx) điền mẫu
                        </MudButton>

                        <InputFile id="maincontract-docx-upload"
                                   OnChange="OnDocxInputFileChangedAsync"
                                   accept=".docx"
                                   style="display:none" />
                        <MudButton HtmlTag="label"
                                   Variant="Variant.Filled"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.UploadFile"
                                   Disabled="@_saving"
                                   for="maincontract-docx-upload">
                            Upload file Word (.docx)
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   Disabled="@_saving"
                                   OnClick="ResetToDefaultAsync">
                            Khôi phục mặc định
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />

            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudChip T="string" Color="@(_isCustomForSelectedCompany ? Color.Success : Color.Info)" Variant="Variant.Filled" Size="Size.Small">
                        @TargetStatusBadgeText
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.PictureAsPdf">
                        Nguồn gốc PDF: @(_selectedBusinessType == ContractBusinessType.Cargo ? "HopDongVanChuyenHangHoa.template.pdf (2 trang)" : "HopDongVanChuyenHanhKhach.template.pdf (2 trang)")
                    </MudChip>
                    @if (!string.IsNullOrWhiteSpace(_editingTemplate.UploadedDocxFileName))
                    {
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Description">
                            File Word: @_editingTemplate.UploadedDocxFileName
                        </MudChip>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Cập nhật lần cuối: @VietnamTime(_editingTemplate.UpdatedAtUtc).ToString("dd/MM/yyyy HH:mm")
                    </MudText>
                </MudStack>

                <MudSwitch T="bool"
                           @bind-Value="_previewWithSampleData"
                           Color="Color.Primary"
                           Label="Xem trước 2 trang A4 với dữ liệu mẫu đã điền" />
            </MudStack>
        </MudPaper>

        <!-- TỪ ĐIỂN BIẾN TỰ ĐỘNG {{...}} -->
        <MudPaper Class="pa-3" Elevation="0" Outlined="true">
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" Class="mr-1" />
                    Từ điển biến Hợp đồng chính (Bấm vào biến để sao chép nhanh khi soạn thảo trên Web hoặc trong file Word .docx)
                </MudText>
                <div class="placeholder-chip-list">
                    @foreach (var p in MainContractTemplateService.SupportedPlaceholders)
                    {
                        <MudTooltip Text="@($"{p.Category}: {p.Label} — Ví dụ: {p.SampleValue}")">
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="Color.Primary"
                                     OnClick="@(() => CopyPlaceholderAsync(p.Token))">
                                <b>@p.Token</b>&nbsp;<span class="text-muted">(@p.Label)</span>
                            </MudChip>
                        </MudTooltip>
                    }
                </div>
            </MudStack>
        </MudPaper>

        <!-- KHUNG SOẠN THẢO TRỰC TIẾP (BÊN TRÁI) & XEM TRƯỚC 2 TRANG A4 (BÊN PHẢI) -->
        <MudGrid Spacing="3">
            <!-- BÊN TRÁI: TRÌNH SOẠN THẢO WEB (HƯỚNG 1) -->
            <MudItem xs="12" lg="6">
                <MudPaper Class="pa-4 editor-scroll-panel" Elevation="1">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6" Color="Color.Primary">
                            TRANG 1/2 — Quốc hiệu, Tiêu đề &amp; Số Hợp đồng
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_editingTemplate.TemplateName"
                                              Immediate="true"
                                              Label="Tên mẫu quản lý"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            @if (_selectedBusinessType == ContractBusinessType.Cargo)
                            {
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_editingTemplate.LeftHeaderLine1"
                                                  Immediate="true"
                                                  Label="Tiêu đề góc trái dòng 1 (Sở GTVT / Nơi cấp)"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_editingTemplate.LeftHeaderLine2"
                                                  Immediate="true"
                                                  Label="Tiêu đề góc trái dòng 2 (Tên Đơn vị / HTX)"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            }
                            <MudItem xs="12" md="7">
                                <MudTextField @bind-Value="_editingTemplate.DocumentTitle"
                                              Immediate="true"
                                              Label="Tiêu đề Hợp đồng chính (Trang 1)"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudTextField @bind-Value="_editingTemplate.ContractNumberLine"
                                              Immediate="true"
                                              Label="Dòng Số Hợp đồng"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>

                        @if (_selectedBusinessType == ContractBusinessType.Passenger)
                        {
                            <MudTextField @bind-Value="_editingTemplate.LegalBasesText"
                                          Immediate="true"
                                          Label="Căn cứ pháp lý (mỗi dòng 1 căn cứ)"
                                          Lines="3"
                                          Variant="Variant.Outlined" />
                        }

                        <MudTextField @bind-Value="_editingTemplate.IntroDateLocationText"
                                      Immediate="true"
                                      Label="Dòng thời gian &amp; địa điểm mở đầu hợp đồng"
                                      Lines="2"
                                      Variant="Variant.Outlined" />

                        <MudDivider />
                        <MudText Typo="Typo.h6" Color="Color.Primary">
                            TRANG 1/2 — Thông tin Đại diện Bên A &amp; Bên B
                        </MudText>

                        <MudTextField @bind-Value="_editingTemplate.PartyASectionTitle"
                                      Immediate="true"
                                      Label="Tiêu đề mục Bên A"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudTextField @bind-Value="_editingTemplate.PartyABodyText"
                                      Immediate="true"
                                      Label="Nội dung chi tiết Bên A (mỗi dòng 1 mục)"
                                      Lines="5"
                                      Variant="Variant.Outlined" />

                        <MudTextField @bind-Value="_editingTemplate.PartyBSectionTitle"
                                      Immediate="true"
                                      Label="Tiêu đề mục Bên B"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudTextField @bind-Value="_editingTemplate.PartyBBodyText"
                                      Immediate="true"
                                      Label="Nội dung chi tiết Bên B (mỗi dòng 1 mục)"
                                      Lines="5"
                                      Variant="Variant.Outlined" />

                        <MudDivider />
                        <MudText Typo="Typo.h6" Color="Color.Primary">
                            TRANG 1/2 — Nội dung vận chuyển, Lịch trình &amp; Giá cước
                        </MudText>

                        <MudTextField @bind-Value="_editingTemplate.TransportDetailsTitle"
                                      Immediate="true"
                                      Label="Lời dẫn nội dung vận chuyển"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudTextField @bind-Value="_editingTemplate.TransportDetailsBodyText"
                                      Immediate="true"
                                      Label="@(_selectedBusinessType == ContractBusinessType.Cargo ? "Nội dung Điều 1, Điều 2, Điều 3 (Hàng hóa, Hành trình, Cước phí)" : "Thông tin Xe, Tài xế 1-2, Điểm đón/trả, Hành trình, Giá cước & Thanh toán")"
                                      Lines="11"
                                      Variant="Variant.Outlined" />

                        <MudDivider />
                        <MudText Typo="Typo.h6" Color="Color.Primary">
                            TRANG 1/2 — III. Trách nhiệm các bên &amp; Chữ ký 3 cột
                        </MudText>

                        <MudTextField @bind-Value="_editingTemplate.ResponsibilitiesSectionTitle"
                                      Immediate="true"
                                      Label="Tiêu đề mục III"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_editingTemplate.ResponsibilityHtxTitle"
                                              Immediate="true"
                                              Label="Tiêu đề mục Bên HTX"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="8">
                                <MudTextField @bind-Value="_editingTemplate.ResponsibilityHtxBodyText"
                                              Immediate="true"
                                              Label="Trách nhiệm Bên HTX"
                                              Lines="2"
                                              Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>

                        <MudTextField @bind-Value="_editingTemplate.ResponsibilityOwnerTitle"
                                      Immediate="true"
                                      Label="Tiêu đề mục Bên Chủ xe"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudTextField @bind-Value="_editingTemplate.ResponsibilityOwnerBodyText"
                                      Immediate="true"
                                      Label="Trách nhiệm Bên Chủ xe (mỗi dòng 1 ý)"
                                      Lines="8"
                                      Variant="Variant.Outlined" />

                        <MudTextField @bind-Value="_editingTemplate.ResponsibilityCustomerTitle"
                                      Immediate="true"
                                      Label="Tiêu đề mục Trách nhiệm Bên thuê"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudTextField @bind-Value="_editingTemplate.ResponsibilityCustomerBodyText"
                                      Immediate="true"
                                      Label="Trách nhiệm Bên thuê &amp; Liên hệ phản ánh"
                                      Lines="6"
                                      Variant="Variant.Outlined" />

                        <MudTextField @bind-Value="_editingTemplate.GeneralCommitmentText"
                                      Immediate="true"
                                      Label="Cam kết chung cuối Trang 1"
                                      Lines="3"
                                      Variant="Variant.Outlined" />

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_editingTemplate.Page1SigLeftTitle"
                                              Immediate="true"
                                              Label="Cột ký 1 (Trái)"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_editingTemplate.Page1SigCenterTitle"
                                              Immediate="true"
                                              Label="Cột ký 2 (Giữa)"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_editingTemplate.Page1SigRightTitle"
                                              Immediate="true"
                                              Label="Cột ký 3 (Phải)"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>

                        <MudDivider />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">
                            TRANG 2/2 — @(_selectedBusinessType == ContractBusinessType.Cargo ? "GIẤY VẬN TẢI (5 mục + Xếp/Dỡ hàng)" : "DANH SÁCH HÀNH KHÁCH (Bảng 20 hành khách)")
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_editingTemplate.Page2LeftHeaderLine1"
                                              Immediate="true"
                                              Label="Tiêu đề góc trái Trang 2 (Dòng 1)"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_editingTemplate.Page2LeftHeaderLine2"
                                              Immediate="true"
                                              Label="Tiêu đề góc trái Trang 2 (Dòng 2)"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_editingTemplate.Page2Title"
                                              Immediate="true"
                                              Label="Tiêu đề chính Trang 2"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            @if (_selectedBusinessType == ContractBusinessType.Passenger)
                            {
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_editingTemplate.Page2FooterSummaryLine"
                                                  Immediate="true"
                                                  Label="Dòng tổng kết cuối bảng hành khách"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            }
                        </MudGrid>

                        <MudTextField @bind-Value="_editingTemplate.Page2Subtitle"
                                      Immediate="true"
                                      Label="Phụ đề dưới tiêu đề Trang 2"
                                      Lines="2"
                                      Variant="Variant.Outlined" />

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_editingTemplate.Page2SigLeftTitle"
                                              Immediate="true"
                                              Label="Cột ký bên trái Trang 2"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_editingTemplate.Page2SigRightTitle"
                                              Immediate="true"
                                              Label="Cột ký bên phải Trang 2"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_editingTemplate.Page2SigLeftSubTitle"
                                              Immediate="true"
                                              Label="Ghi chú dưới cột ký trái Trang 2"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_editingTemplate.Page2SigRightSubTitle"
                                              Immediate="true"
                                              Label="Ghi chú dưới cột ký phải Trang 2"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- BÊN PHẢI: XEM TRƯỚC 2 TRANG GIẤY A4 TRỰC TIẾP -->
            <MudItem xs="12" lg="6">
                <MudPaper Class="pa-4 preview-scroll-panel" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                        <MudText Typo="Typo.subtitle1" Class="fw-700">
                            Xem trước Bản in 2 Trang A4 (@(_previewWithSampleData ? "Đã điền dữ liệu mẫu" : "Hiển thị nguyên biến {{...}}"))
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                            2 Trang A4 · Times New Roman
                        </MudChip>
                    </MudStack>

                    <!-- ==================== TỜ A4 TRANG 1/2 ==================== -->
                    <div class="a4-preview-sheet mb-5">
                        <div class="a4-page-badge">TRANG 1/2</div>

                        @if (_selectedBusinessType == ContractBusinessType.Cargo)
                        {
                            <div class="a4-header-grid">
                                <div class="a4-header-left">
                                    <div class="a4-bold">@RenderLine(_editingTemplate.LeftHeaderLine1)</div>
                                    <div class="a4-bold">@RenderLine(_editingTemplate.LeftHeaderLine2)</div>
                                </div>
                                <div class="a4-header-right">
                                    <div class="a4-bold">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                                    <div class="a4-bold">Độc lập - Tự do - Hạnh phúc</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="a4-center-motto">
                                <div class="a4-bold">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                                <div class="a4-bold">Độc lập – Tự do – Hạnh phúc</div>
                            </div>
                        }

                        <div class="a4-title-block">
                            <div class="a4-main-title">@RenderLine(_editingTemplate.DocumentTitle)</div>
                            <div class="a4-sub-number">@RenderLine(_editingTemplate.ContractNumberLine)</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_editingTemplate.LegalBasesText))
                        {
                            <div class="a4-section">
                                @foreach (var line in SplitLines(_editingTemplate.LegalBasesText))
                                {
                                    <div class="a4-paragraph">@RenderLine(line)</div>
                                }
                            </div>
                        }

                        <div class="a4-section">
                            @foreach (var line in SplitLines(_editingTemplate.IntroDateLocationText))
                            {
                                <div class="a4-paragraph">@RenderLine(line)</div>
                            }
                        </div>

                        <div class="a4-section">
                            <div class="a4-paragraph a4-bold">@RenderLine(_editingTemplate.PartyASectionTitle)</div>
                            @foreach (var line in SplitLines(_editingTemplate.PartyABodyText))
                            {
                                <div class="a4-paragraph">@RenderLine(line)</div>
                            }
                        </div>

                        <div class="a4-section">
                            <div class="a4-paragraph a4-bold">@RenderLine(_editingTemplate.PartyBSectionTitle)</div>
                            @foreach (var line in SplitLines(_editingTemplate.PartyBBodyText))
                            {
                                <div class="a4-paragraph">@RenderLine(line)</div>
                            }
                        </div>

                        <div class="a4-section">
                            @if (!string.IsNullOrWhiteSpace(_editingTemplate.TransportDetailsTitle))
                            {
                                <div class="a4-paragraph">@RenderLine(_editingTemplate.TransportDetailsTitle)</div>
                            }
                            @foreach (var line in SplitLines(_editingTemplate.TransportDetailsBodyText))
                            {
                                <div class="a4-paragraph @(line.StartsWith("Điều ", StringComparison.OrdinalIgnoreCase) ? "a4-bold" : "")">@RenderLine(line)</div>
                            }
                        </div>

                        <div class="a4-section">
                            <div class="a4-paragraph a4-bold">@RenderLine(_editingTemplate.ResponsibilitiesSectionTitle)</div>
                            <div class="a4-paragraph a4-bold">@RenderLine(_editingTemplate.ResponsibilityHtxTitle)</div>
                            @foreach (var line in SplitLines(_editingTemplate.ResponsibilityHtxBodyText))
                            {
