<MudAutocomplete T="string"
                 Value="@Value"
                 ValueChanged="HandleValueChanged"
                 Label="@Label"
                 Placeholder="Chọn hoặc nhập nơi cấp CCCD"
                 SearchFunc="SearchIssuedPlaces"
                 CoerceText="true"
                 CoerceValue="true"
                 Clearable="true"
                 MinCharacters="0"
                 OpenOnFocus="true"
                 Required="@Required"
                 Disabled="@Disabled"
                 Variant="Variant.Outlined" />

@code {
    private static readonly string[] IssuedPlaceOptions =
    [
        "Bộ Công An",
        "Cục CS QLHC về TTXH",
        "Cục CS ĐKQL cư trú và DLQG về dân cư"
    ];

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Nơi cấp CCCD";

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private async Task HandleValueChanged(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private Task<IEnumerable<string>> SearchIssuedPlaces(string? value, CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();

        var keyword = value?.Trim();
        IEnumerable<string> result = string.IsNullOrWhiteSpace(keyword)
            ? IssuedPlaceOptions
            : IssuedPlaceOptions.Where(x => x.Contains(keyword, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }
}
