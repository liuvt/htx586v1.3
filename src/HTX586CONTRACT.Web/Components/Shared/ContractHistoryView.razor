@code {
    [Parameter, EditorRequired] public ContractDetailDto Detail { get; set; } = null!;
    [Parameter, EditorRequired] public string BackUrl { get; set; } = "/";
    [Parameter] public bool AllowPdfSync { get; set; }

    private IReadOnlyList<ContractPdfVersionDto> _syncedPdfs = Array.Empty<ContractPdfVersionDto>();
    private Guid? _loadedSyncContractId;
    private bool _syncingPdf;

    private ContractSignatureDto? CustomerSignature
        => Detail.Signatures.FirstOrDefault(x => x.Party == SignatureParty.Customer);

    private string CustomerSignatureSignerName
        => Detail.CustomerIsCompany && !string.IsNullOrWhiteSpace(Detail.CustomerRepresentativeName)
            ? Detail.CustomerRepresentativeName.Trim()
            : !string.IsNullOrWhiteSpace(CustomerSignature?.SignerName)
                ? CustomerSignature!.SignerName.Trim()
                : Detail.CustomerName;


    private RenderFragment DataBlock(string label, string? value, string cssClass = "") => @<div class="data-card @cssClass">
        <span class="data-label">@label</span>
        <span class="data-value">@DisplayText(value)</span>
    </div>;

    protected override async Task OnParametersSetAsync()
    {
        if (AllowPdfSync &&
            Detail.Status == ContractStatus.Completed &&
            _loadedSyncContractId != Detail.Id)
        {
            await ReloadSyncedPdfsAsync();
            _loadedSyncContractId = Detail.Id;
        }
        else if (!AllowPdfSync)
        {
            _syncedPdfs = Array.Empty<ContractPdfVersionDto>();
            _loadedSyncContractId = null;
        }
    }

    private async Task SyncPdfAsync()
    {
        if (_syncingPdf)
            return;

        try
        {
            _syncingPdf = true;
            await DocumentService.GenerateSyncedPdfAsync(Detail.Id);
            await ReloadSyncedPdfsAsync();
            Snackbar.Add("Đã cập nhật PDF đồng bộ mới nhất. PDF chính thức vẫn được giữ nguyên.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _syncingPdf = false;
        }
    }

    private async Task ReloadSyncedPdfsAsync()
    {
        try
        {
            _syncedPdfs = await DocumentService.GetSyncedPdfsAsync(Detail.Id);
        }
        catch (Exception ex)
        {
            _syncedPdfs = Array.Empty<ContractPdfVersionDto>();
            Snackbar.Add($"Không thể đọc danh sách PDF đồng bộ: {ex.Message}", Severity.Warning);
        }
    }

    private static string SyncPdfButtonText(ContractPdfVersionDto pdf)
    {
        var local = pdf.GeneratedAtUtc.Kind == DateTimeKind.Utc
            ? pdf.GeneratedAtUtc.AddHours(7)
            : pdf.GeneratedAtUtc;
        return $"PDF đồng bộ mới nhất {local:dd/MM/yyyy HH:mm}";
    }

    private async Task OpenPdfAsync()
    {
        try
        {
            var url = await DocumentService.GeneratePdfAsync(Detail.Id);
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenSubContractPdfAsync()
    {
        try
        {
            var url = await DocumentService.GenerateSubContractPdfAsync(Detail.Id);
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenSubContractDocxAsync()
    {
        try
        {
            var url = await DocumentService.GenerateSubContractDocxAsync(Detail.Id);
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string BusinessName(ContractBusinessType type) => type switch
    {
        ContractBusinessType.Passenger => "Hợp đồng vận chuyển hành khách",
        ContractBusinessType.Cargo => "HỢP ĐỒNG VẬN CHUYỂN HÀNG HÓA BẰNG XE Ô TÔ",
        _ => type.ToString()
    };

    private static string BusinessNameShort(ContractBusinessType type) => type switch
    {
        ContractBusinessType.Passenger => "Hành khách",
        ContractBusinessType.Cargo => "Hàng hóa",
        _ => type.ToString()
    };

    private static string StatusName(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "Đã tạo",
        ContractStatus.WaitingCustomerSignature => "Đã phát - chờ nhận",
        ContractStatus.CustomerSigned => "Khách đã ký",
        ContractStatus.WaitingDriverConfirmation => "Đã nhận - đang xử lý",
        ContractStatus.Completed => "Hoàn tất",
        ContractStatus.Cancelled => "Đã hủy",
        ContractStatus.Expired => "Hết hạn",
        ContractStatus.Invalidated => "Vô hiệu hóa",
        _ => status.ToString()
    };

    private readonly ContractPassengerDto _customerTravelRow = new() { SortOrder = 0 };
    private IEnumerable<ContractPassengerDto> PassengerRows =>
        Detail.CustomerTravelsWithGroup && !string.IsNullOrWhiteSpace(TravelCompanionDisplayName)
            ? new[] { _customerTravelRow }.Concat(Detail.Passengers)
            : Detail.Passengers;
    private bool IsCustomerTravelRow(ContractPassengerDto row) => object.ReferenceEquals(row, _customerTravelRow);
    private string TravelCompanionDisplayName => Detail.CustomerIsCompany
        ? (string.IsNullOrWhiteSpace(Detail.CustomerRepresentativeName) ? Detail.CustomerName : Detail.CustomerRepresentativeName)
        : Detail.CustomerName;

    private static DateTime VietnamTime(DateTime value)
        => value.Kind == DateTimeKind.Utc ? value.AddHours(7) : value;

    private static string FormatDateTime(DateTime value)
        => VietnamTime(value).ToString("dd/MM/yyyy HH:mm");

    private static string FormatDateTime(DateTime? value)
        => value.HasValue ? FormatDateTime(value.Value) : "-";

    private static string FormatDate(DateTime? value)
        => value?.ToString("dd/MM/yyyy") ?? "-";

    private static string FormatNumber(int? value)
        => value?.ToString("N0") ?? "-";

    private static string FormatDecimal(decimal? value, string suffix = "")
        => value.HasValue ? $"{value.Value:N1}{suffix}" : "-";

    private static string FormatMoney(decimal? value)
        => value.HasValue ? $"{value.Value:N0} VNĐ" : "-";

    private static string FormatRange(DateTime? start, DateTime? end)
        => $"{FormatDateTime(start)} → {FormatDateTime(end)}";

    private static string YesNo(bool value) => value ? "Có" : "Không";

    private static string DisplayText(string? value)
        => string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;
}
