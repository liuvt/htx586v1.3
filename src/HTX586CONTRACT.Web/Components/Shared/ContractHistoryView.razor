@inject IContractDocumentService DocumentService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<div class="contract-history-page">
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="contract-lock-alert">
        Hợp đồng đã kết thúc và được khóa bất biến. Thông tin bên dưới là dữ liệu đã lưu tại thời điểm lập/chốt hợp đồng,
        không lấy lại từ hồ sơ Công ty, xe, tài xế hoặc khách hàng hiện tại.
    </MudAlert>

    <MudPaper Class="contract-hero" Elevation="0">
        <div class="contract-hero__left">
            <div class="section-eyebrow">
                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
                <span>HỒ SƠ HỢP ĐỒNG ĐÃ KHÓA SNAPSHOT</span>
            </div>
            <MudText Typo="Typo.h4" Class="contract-title">@Detail.ContractNumber</MudText>
            <MudText Typo="Typo.body1" Class="contract-subtitle">
                @Detail.CompanyName · @BusinessName(Detail.BusinessType)
            </MudText>
            <div class="contract-chip-row">
                <ContractStatusChip Status="Detail.Status" ChipSize="Size.Medium" />
                <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Badge">@BusinessNameShort(Detail.BusinessType)</MudChip>
                <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.DirectionsCar">@(Detail.VehiclePlate ?? "Chưa có biển số")</MudChip>
                <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Tag">HĐ phụ: @Detail.SubContractNumber</MudChip>
            </div>
            <div class="contract-hero__quick-actions">
                @if (Detail.Status == ContractStatus.Completed)
                {
                    <MudButton Color="Color.Error"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               OnClick="OpenPdfAsync">
                        Mở PDF HĐ chính
                    </MudButton>
                }
                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="OpenSubContractPdfAsync">
                    Hợp đồng phụ (PDF)
                </MudButton>
                <MudButton Color="Color.Info"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Article"
                           OnClick="OpenSubContractDocxAsync">
                    Tải HĐ phụ (.docx)
                </MudButton>
                <MudButton Href="@BackUrl"
                           Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.ArrowBack">
                    Danh sách HĐ
                </MudButton>
            </div>
        </div>

        <div class="contract-hero__right">
            <div class="hero-meta-card">
                <span class="hero-meta-label">Ngày khởi tạo</span>
                <span class="hero-meta-value">@FormatDateTime(Detail.CreatedAt)</span>
            </div>
            <div class="hero-meta-card">
                <span class="hero-meta-label">Thời điểm hoàn tất</span>
                <span class="hero-meta-value">@FormatDateTime(Detail.CompletedAt)</span>
            </div>
            <div class="hero-meta-card">
                <span class="hero-meta-label">Người khởi tạo / Phát HĐ</span>
                <span class="hero-meta-value">@Detail.CreatedByName · @(Detail.AssignedByName ?? "Tài xế tự tạo")</span>
            </div>
        </div>
    </MudPaper>

    <div class="contract-kpis">
        <div class="kpi-card">
            <div class="kpi-label">Giá trị hợp đồng</div>
            <div class="kpi-value">@FormatMoney(Detail.ContractValue)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Tổng quãng đường</div>
            <div class="kpi-value">@FormatDecimal(Detail.TotalKilometers, " km")</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">@(Detail.BusinessType == ContractBusinessType.Cargo ? "Loại hàng" : "Số hành khách thực tế")</div>
            <div class="kpi-value">@(Detail.BusinessType == ContractBusinessType.Cargo ? (Detail.CargoName ?? "-") : FormatNumber(Detail.ActualPassengerCount))</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Khoảng thời gian</div>
            <div class="kpi-value kpi-value--sm">@FormatRange(Detail.StartTime, Detail.EndTime)</div>
        </div>
    </div>

    <MudPaper Class="section-card" Elevation="1">
        <div class="section-header">
            <div>
                <MudText Typo="Typo.h6">1. Tổng quan hợp đồng</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Thông tin hành chính và luồng xử lý hợp đồng.</MudText>
            </div>
        </div>
        <div class="data-grid">
            @DataBlock("Số hợp đồng", Detail.ContractNumber)
            @DataBlock("Loại hợp đồng", BusinessName(Detail.BusinessType))
            @DataBlock("Trạng thái", StatusName(Detail.Status))
            @DataBlock("Công ty/Văn phòng", Detail.CompanyName, "wide")
            @DataBlock("Liên hệ phản ánh", Detail.CompanyComplaintContact, "wide")
            @DataBlock("Người tạo", Detail.CreatedByName)
            @DataBlock("Người phát xuống", Detail.AssignedByName ?? "Tài xế tự tạo")
            @DataBlock("Ngày tạo", FormatDateTime(Detail.CreatedAt))
            @DataBlock("Ngày phát xuống", FormatDateTime(Detail.AssignedAt))
            @DataBlock("Ngày nhận HĐ", FormatDateTime(Detail.ReceivedAt))
            @DataBlock("Ngày hoàn thành", FormatDateTime(Detail.CompletedAt))
            @DataBlock("Khu vực", string.IsNullOrWhiteSpace(Detail.AreaCode) ? "Chưa cập nhật" : Detail.AreaCode)
        </div>
    </MudPaper>

    <MudPaper Class="section-card" Elevation="1">
        <div class="section-header">
            <div>
                <MudText Typo="Typo.h6">@(Detail.BusinessType == ContractBusinessType.Cargo ? "2. Văn phòng/Công ty và Chủ phương tiện" : "2. Phương tiện, chủ xe và người lái")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Dữ liệu Công ty/Văn phòng và Chủ xe được chụp snapshot; Tài xế 1/Tài xế 2 là người thực tế điều khiển phương tiện của hợp đồng.</MudText>
            </div>
        </div>
        @if (Detail.BusinessType == ContractBusinessType.Cargo)
        {
            <div class="data-grid">
                @DataBlock("Tên Văn phòng/Công ty", Detail.CompanyOfficeName ?? Detail.CompanyName, "wide")
                @DataBlock("Mã số thuế", Detail.CompanyTaxCode)
                @DataBlock("GPKDVT", Detail.CompanyBusinessLicenseNumber)
                @DataBlock("Nơi cấp Phép", Detail.CompanyBusinessLicenseIssuedPlace)
                @DataBlock("Địa chỉ", Detail.CompanyAddress, "wide")
                @DataBlock("Số điện thoại", Detail.CompanyPhoneNumber)
                @DataBlock("Tên người đại diện", Detail.CompanyRepresentativeName)
                @DataBlock("CCCD người đại diện", Detail.CompanyRepresentativeCitizenId)
                @DataBlock("Ngày cấp CCCD đại diện", FormatDate(Detail.CompanyRepresentativeCitizenIdIssuedDate))
                @DataBlock("Tên chủ phương tiện", Detail.OwnerName)
                @DataBlock("CCCD chủ phương tiện", Detail.OwnerCitizenId)
                @DataBlock("Ngày cấp CCCD chủ phương tiện", FormatDate(Detail.OwnerCitizenIdIssuedDate))
                @DataBlock("Biển kiểm soát", Detail.VehiclePlate)
                @DataBlock("Tài xế 1", Detail.OperatingDriverName)
                @DataBlock("Số GPLX TX1", Detail.OperatingDriverLicenseNumber)
                @DataBlock("Hạng GPLX TX1", Detail.OperatingDriverLicenseClass)
                @DataBlock("SĐT TX1", Detail.OperatingDriverPhoneNumber)
                @DataBlock("Tài xế 2", string.IsNullOrWhiteSpace(Detail.SecondDriverName) ? "Không có" : Detail.SecondDriverName)
                @DataBlock("Số GPLX TX2", string.IsNullOrWhiteSpace(Detail.SecondDriverName) ? "N/A" : Detail.SecondDriverLicenseNumber)
                @DataBlock("Hạng GPLX TX2", string.IsNullOrWhiteSpace(Detail.SecondDriverName) ? "N/A" : Detail.SecondDriverLicenseClass)
                @DataBlock("SĐT TX2", string.IsNullOrWhiteSpace(Detail.SecondDriverName) ? "N/A" : Detail.SecondDriverPhoneNumber)
            </div>
        }
        else
        {
            <div class="data-grid">
                @DataBlock("Biển kiểm soát", Detail.VehiclePlate)
                @DataBlock("Mã xe", Detail.VehicleCode)
                @DataBlock("Hãng / Loại xe", Detail.VehicleBrand)
                @DataBlock("Số chỗ", FormatNumber(Detail.SeatCount))
                @DataBlock("Chủ sở hữu", Detail.OwnerName)
                @DataBlock("CCCD chủ sở hữu", Detail.OwnerCitizenId)
                @DataBlock("Ngày cấp CCCD", FormatDate(Detail.OwnerCitizenIdIssuedDate))
                @DataBlock("Tài khoản nhận HĐ", Detail.DriverName)
                @DataBlock("Người lái thực tế", Detail.OperatingDriverName)
                @DataBlock("Hạng GPLX", Detail.OperatingDriverLicenseClass)
                @DataBlock("Số GPLX", Detail.OperatingDriverLicenseNumber)
                @DataBlock("SĐT người lái", Detail.OperatingDriverPhoneNumber)
            </div>
        }
    </MudPaper>

    <MudPaper Class="section-card" Elevation="1">
        <div class="section-header">
            <div>
                <MudText Typo="Typo.h6">@(Detail.BusinessType == ContractBusinessType.Cargo ? "3. Khách hàng / Bên A" : "3. Khách hàng / người thuê")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Thông tin khách hàng được khóa theo hợp đồng tại thời điểm tạo/chốt; hỗ trợ cả khách hàng cá nhân và Công ty/Doanh nghiệp.</MudText>
            </div>
        </div>
        <div class="data-grid">
            @DataBlock(Detail.CustomerIsCompany ? "Tên công ty" : "Tên khách hàng", Detail.CustomerName)
            @if (Detail.CustomerIsCompany)
            {
                @DataBlock("Tên người đại diện", Detail.CustomerRepresentativeName)
                @DataBlock("Mã số thuế", Detail.CustomerTaxCode)
                @DataBlock("CCCD người đại diện", Detail.CustomerCitizenId)
            }
            else
            {
                @DataBlock("Số điện thoại", Detail.CustomerPhone)
                @DataBlock("CCCD", Detail.CustomerCitizenId)
            }
            @if (Detail.CustomerIsCompany)
            {
                @DataBlock("Số điện thoại", Detail.CustomerPhone)
            }
            @DataBlock("Ngày cấp CCCD", FormatDate(Detail.CustomerCitizenIdIssuedDate))
            @if (Detail.BusinessType == ContractBusinessType.Passenger)
            {
                @DataBlock("Người đặt đi cùng", YesNo(Detail.CustomerTravelsWithGroup))
            }
            @DataBlock("Địa chỉ", Detail.CustomerAddress, "wide")
        </div>
    </MudPaper>

    <MudPaper Class="section-card" Elevation="1">
        <div class="section-header">
            <div>
                <MudText Typo="Typo.h6">4. Nội dung hợp đồng</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Lịch trình, tuyến đường, thanh toán và các ghi chú liên quan.</MudText>
            </div>
        </div>
        <div class="data-grid">
            @DataBlock("Thời gian bắt đầu", FormatDateTime(Detail.StartTime))
            @DataBlock("Thời gian kết thúc", FormatDateTime(Detail.EndTime))
            @DataBlock("Tổng km", FormatDecimal(Detail.TotalKilometers, " km"))
            @DataBlock(Detail.BusinessType == ContractBusinessType.Cargo ? "Cước vận chuyển" : "Giá trị hợp đồng", FormatMoney(Detail.ContractValue))
            @DataBlock(Detail.BusinessType == ContractBusinessType.Cargo ? "Nơi nhận hàng" : "Điểm đi", Detail.PickupLocation)
            @DataBlock(Detail.BusinessType == ContractBusinessType.Cargo ? "Nơi trả hàng" : "Điểm đến", Detail.DropoffLocation)
            @DataBlock(Detail.BusinessType == ContractBusinessType.Cargo ? "Hành trình xe chạy" : "Lộ trình chi tiết", Detail.RouteDescription, "wide")
            @if (Detail.BusinessType == ContractBusinessType.Cargo)
            {
                @DataBlock("Thanh toán", Detail.PaymentMethod, "wide")
            }
            else
            {
                @DataBlock("Hình thức thanh toán", Detail.PaymentMethod)
                @DataBlock("Thời gian thanh toán", Detail.PaymentTime)
            }
            @DataBlock("Ghi chú", Detail.Note, "wide")
        </div>

        @if (Detail.BusinessType == ContractBusinessType.Cargo)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle1" Class="mb-3">Thông tin hàng hóa</MudText>
            <div class="data-grid">
                @DataBlock("Loại hàng", Detail.CargoName)
                @DataBlock("Quy cách", Detail.CargoSpecification)
                @DataBlock("Số lượng", Detail.CargoQuantity)
                @DataBlock("Khối lượng", Detail.CargoWeight?.ToString("N2"))
                @DataBlock("Tên hàng hóa (Giấy vận tải)", Detail.CargoTransportGoodsName, "wide")
                @DataBlock("Tuyến vận chuyển", Detail.CargoTransportRoute, "wide")
                @DataBlock("Điểm xếp hàng", Detail.CargoLoadingPoint, "wide")
                @DataBlock("Điểm giao hàng", Detail.CargoDeliveryPoint, "wide")
                @DataBlock("Thông tin khác", Detail.CargoOtherInformation, "wide")
            </div>

            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Các lần xếp/dỡ hàng</MudText>
            @if (Detail.CargoHandlingEvents.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">Không có dữ liệu xếp/dỡ hàng.</MudAlert>
            }
            else
            {
                <MudTable T="ContractCargoHandlingEventDto" Items="@Detail.CargoHandlingEvents.OrderBy(x => x.Type).ThenBy(x => x.SortOrder)" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Loại</MudTh><MudTh>Lần</MudTh><MudTh>Địa điểm</MudTh><MudTh>Khối lượng</MudTh><MudTh>Thời gian</MudTh><MudTh>Xác nhận</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(context.Type == CargoHandlingType.Loading ? "Xếp" : "Dỡ")</MudTd>
                        <MudTd>@context.SortOrder</MudTd>
                        <MudTd>@DisplayText(context.Location)</MudTd>
                        <MudTd>@DisplayText(context.CargoWeight)</MudTd>
                        <MudTd>@(context.EventTime.HasValue ? FormatDateTime(context.EventTime) : "N/A")</MudTd>
                        <MudTd>@DisplayText(context.Confirmation)</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudPaper>

    @if (Detail.BusinessType == ContractBusinessType.Passenger)
    {
    <MudPaper Class="section-card" Elevation="1">
        <div class="section-header">
            <div>
                <MudText Typo="Typo.h6">5. Danh sách hành khách</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Danh sách hành khách đi cùng hợp đồng tại thời điểm khóa dữ liệu.</MudText>
            </div>
            <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary">Tổng số: @FormatNumber(Detail.ActualPassengerCount)</MudChip>
        </div>

        @if (!PassengerRows.Any())
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Không có hành khách.</MudAlert>
        }
        else
        {
            <MudTable T="ContractPassengerDto" Items="PassengerRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>STT</MudTh>
                    <MudTh>Họ tên</MudTh>
                    <MudTh>Năm sinh</MudTh>
                    <MudTh>Ghi chú</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @if (IsCustomerTravelRow(context))
                    {
                        <MudTd DataLabel="STT">1</MudTd>
                        <MudTd DataLabel="Họ tên">@TravelCompanionDisplayName</MudTd>
                        <MudTd DataLabel="Năm sinh">@(Detail.CustomerTravelBirthYear?.ToString() ?? "-")</MudTd>
                        <MudTd DataLabel="Ghi chú">@(string.IsNullOrWhiteSpace(Detail.CustomerTravelNote) ? "-" : Detail.CustomerTravelNote)</MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="STT">@(context.SortOrder + (Detail.CustomerTravelsWithGroup ? 1 : 0))</MudTd>
                        <MudTd DataLabel="Họ tên">@context.FullName</MudTd>
                        <MudTd DataLabel="Năm sinh">@(context.BirthYear?.ToString() ?? "-")</MudTd>
                        <MudTd DataLabel="Ghi chú">@(string.IsNullOrWhiteSpace(context.Note) ? "-" : context.Note)</MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
    }

    <MudPaper Class="section-card" Elevation="1">
        <div class="section-header">
            <div>
                <MudText Typo="Typo.h6">@(Detail.BusinessType == ContractBusinessType.Cargo ? "5. Chữ ký theo hợp đồng" : "6. Chữ ký theo hợp đồng")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Cả hai loại HĐ lưu chữ ký Văn phòng, Chủ xe, Tài xế 1 và khách hàng/Đại diện Bên A theo từng hợp đồng.</MudText>
            </div>
        </div>
        <div class="signature-grid">
            <div class="signature-card">
                <div class="signature-card__title">Văn phòng đại diện</div>
                <SignaturePad Disabled="true"
                              ExistingSignatureUrl="@Detail.CompanyRepresentativeSignatureFileUrl"
                              SignerName="@(Detail.CompanyRepresentativeName ?? "Đại diện văn phòng")"
                              SignedAt="@Detail.CompanyRepresentativeSignedAt" />
            </div>
            <div class="signature-card">
                <div class="signature-card__title">Chủ sở hữu xe</div>
                <SignaturePad Disabled="true"
                              ExistingSignatureUrl="@Detail.VehicleOwnerSignatureFileUrl"
                              SignerName="@(Detail.OwnerName ?? "Chủ sở hữu xe")"
                              SignedAt="@Detail.VehicleOwnerSignedAt" />
            </div>
            <div class="signature-card">
                <div class="signature-card__title">Tài xế 1</div>
                <SignaturePad Disabled="true"
                              ExistingSignatureUrl="@Detail.DriverSignatureFileUrl"
                              SignerName="@(string.IsNullOrWhiteSpace(Detail.OperatingDriverName) ? Detail.DriverName : Detail.OperatingDriverName)"
                              SignedAt="@Detail.DriverSignedAt" />
            </div>
            <div class="signature-card">
                <div class="signature-card__title">@(Detail.BusinessType == ContractBusinessType.Cargo ? "Đại diện Bên A" : "Khách hàng")</div>
                <SignaturePad Disabled="true"
                              ExistingSignatureUrl="@(CustomerSignature?.SignatureFileUrl)"
                              SignerName="@CustomerSignatureSignerName"
                              SignedAt="@(CustomerSignature?.ServerSignedAt)" />
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="section-card" Elevation="1">
        <div class="section-header">
            <div>
                <MudText Typo="Typo.h6">@(Detail.BusinessType == ContractBusinessType.Cargo ? "6. Hợp đồng phụ kèm theo — HỢP ĐỒNG DỊCH VỤ VẬN TẢI" : "7. Hợp đồng phụ kèm theo — HỢP ĐỒNG DỊCH VỤ VẬN TẢI")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Hợp đồng dịch vụ vận tải đi kèm theo Đơn vị (@Detail.CompanyName) và Chủ phương tiện/Xe, tự động ánh xạ từ dữ liệu hợp đồng.</MudText>
            </div>
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="OpenSubContractPdfAsync">
                    Hợp đồng phụ (PDF)
                </MudButton>
                <MudButton Color="Color.Info"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Article"
                           OnClick="OpenSubContractDocxAsync">
                    Tải HĐ phụ (.docx)
                </MudButton>
            </MudStack>
        </div>
        @{
            var subUnit = SubContractHelper.ResolveFixedUnitProfile(
                Detail.CompanyName,
                Detail.CompanyTaxCode,
                Detail.CompanyAddress,
                Detail.CompanyPhoneNumber,
                Detail.CompanyBusinessLicenseNumber,
                Detail.CompanyBusinessLicenseIssuedPlace,
                Detail.CompanyRepresentativeName,
                Detail.CompanyRepresentativePosition,
                Detail.CompanyRepresentativeCitizenId,
                Detail.CompanyRepresentativeCitizenIdIssuedDate,
                Detail.CompanyRepresentativeCitizenIdIssuedPlace);
        }
        <div class="data-grid">
            @DataBlock("Số Hợp đồng phụ", Detail.SubContractNumber)
            @DataBlock("Thời hạn hiệu lực (4 năm)", $"{FormatDate(Detail.SubContractEffectiveFrom)} → {FormatDate(Detail.SubContractEffectiveTo)}")
            @DataBlock("Đơn vị áp dụng cứng (Bên A)", subUnit.PartyAName, "wide")
            @DataBlock("Mã số thuế Bên A", subUnit.TaxCode)
            @DataBlock("Số GPKDVT / ĐKKD", string.IsNullOrWhiteSpace(subUnit.LicenseIssuedDateText) ? subUnit.LicenseNumber : $"{subUnit.LicenseNumber} (cấp {subUnit.LicenseIssuedDateText})")
            @DataBlock("Nơi cấp GPKDVT", subUnit.LicenseIssuedPlace)
            @DataBlock("SĐT Bên A", subUnit.PhoneNumber)
            @DataBlock("Địa chỉ trụ sở Bên A", subUnit.Address, "wide")
            @DataBlock("Đại diện Bên A", subUnit.RepresentativeName)
            @DataBlock("Chức vụ Bên A", subUnit.RepresentativePosition)
            @DataBlock("CCCD Đại diện Bên A", subUnit.RepresentativeCitizenId)
            @DataBlock("Ngày & nơi cấp CCCD Bên A", $"{subUnit.RepresentativeCitizenIdIssuedDateText} ({subUnit.RepresentativeCitizenIdIssuedPlace})")
            @DataBlock("Chủ phương tiện (Bên B)", Detail.OwnerName)
            @DataBlock("CCCD Bên B", Detail.OwnerCitizenId)
            @DataBlock("Ngày cấp CCCD Bên B", FormatDate(Detail.OwnerCitizenIdIssuedDate))
            @DataBlock("Nơi cấp CCCD Bên B", Detail.OwnerCitizenIdIssuedPlace ?? "Cục Cảnh Sát QLHC về TTXH")
            @DataBlock("Địa chỉ Bên B", Detail.OwnerAddress, "wide")
            @DataBlock("Biển số phương tiện", Detail.VehiclePlate)
            @DataBlock("Nhãn hiệu / Số chỗ", $"{Detail.VehicleBrand ?? "-"} ({FormatNumber(Detail.SeatCount)} chỗ)")
            @DataBlock("Số khung", Detail.VehicleChassisNumber)
            @DataBlock("Số máy", Detail.VehicleEngineNumber)
            @DataBlock("Nơi sản xuất", "VIỆT NAM")
            @DataBlock("Loại phương tiện", Detail.BusinessType == ContractBusinessType.Cargo ? "XE TẢI" : "XE HỢP ĐỒNG")
        </div>
    </MudPaper>

    <MudPaper Class="contract-actions" Elevation="0">
        <div class="contract-actions__sync">
            @if (AllowPdfSync && Detail.Status == ContractStatus.Completed)
            {
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Sync"
                           Disabled="@_syncingPdf"
                           OnClick="SyncPdfAsync">
                    @(_syncingPdf ? "Đang đồng bộ..." : "Đồng bộ PDF")
                </MudButton>

                @foreach (var pdf in _syncedPdfs)
                {
                    <MudTooltip Text="@pdf.FileName">
                        <MudButton Color="Color.Info"
                                   Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                   Href="@pdf.FileUrl"
                                   Target="_blank">
                            @SyncPdfButtonText(pdf)
                        </MudButton>
                    </MudTooltip>
                }
            }
        </div>

        <div class="contract-actions__right">
            <MudButton Href="@BackUrl" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">
                Quay lại danh sách
            </MudButton>
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="OpenSubContractPdfAsync">
                    Hợp đồng phụ (PDF)
                </MudButton>
                <MudButton Color="Color.Info"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Article"
                           OnClick="OpenSubContractDocxAsync">
                    Tải HĐ phụ (.docx)
                </MudButton>
            </MudStack>
            @if (Detail.Status == ContractStatus.Completed)
            {
                <MudButton Color="Color.Error"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="OpenPdfAsync">
                    Mở PDF chính thức
                </MudButton>
            }
        </div>
    </MudPaper>
</div>

