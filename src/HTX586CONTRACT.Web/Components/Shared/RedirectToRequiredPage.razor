@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@* Component cố ý không render nội dung.
   Mọi redirect chỉ chạy sau first render để không phát sinh NavigationException
   trong giai đoạn SSR/prerender của Interactive Server. *@

@code {
    private bool _redirected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _redirected)
            return;

        _redirected = true;

        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var principal = authenticationState.User;
        var currentUrl = GetCurrentLocalUrl();

        if (principal.Identity?.IsAuthenticated != true)
        {
            var loginUrl = IsRootUrl(currentUrl)
                ? "/account/login"
                : "/account/login?returnUrl=" + Uri.EscapeDataString(currentUrl);

            NavigateIfDifferent(loginUrl, forceLoad: true);
            return;
        }

        string? targetUrl = null;

        // Admin được ưu tiên trước để thống nhất với luồng login server-side.
        if (principal.IsInRole("Admin"))
            targetUrl = "/admin/dashboard";
        else if (principal.IsInRole("Owner"))
            targetUrl = "/owner/dashboard";
        else if (principal.IsInRole("VehicleOwner"))
            targetUrl = "/vehicle-owner/dashboard";

        if (!string.IsNullOrWhiteSpace(targetUrl))
        {
            // Tuyệt đối không NavigateTo chính URL hiện tại.
            // Điều này tránh vòng lặp khi AuthorizeRouteView phát sinh NotAuthorized
            // trong lúc circuit Blazor đang khởi tạo/khôi phục.
            NavigateIfDifferent(targetUrl);
            return;
        }

        NavigateIfDifferent("/account/login", forceLoad: true);
    }

    private void NavigateIfDifferent(string targetUrl, bool forceLoad = false)
    {
        var currentPath = NormalizePath(GetCurrentLocalUrl());
        var targetPath = NormalizePath(targetUrl);

        if (string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase))
            return;

        Navigation.NavigateTo(
            targetUrl,
            forceLoad: forceLoad,
            replace: true);
    }

    private string GetCurrentLocalUrl()
    {
        var relativeUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        if (string.IsNullOrWhiteSpace(relativeUrl))
            return "/";

        return "/" + relativeUrl;
    }

    private static string NormalizePath(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "/";

        var value = url.Trim();
        var queryIndex = value.IndexOfAny(['?', '#']);
        if (queryIndex >= 0)
            value = value[..queryIndex];

        if (!value.StartsWith('/'))
            value = "/" + value;

        return value.Length > 1
            ? value.TrimEnd('/')
            : value;
    }

    private static bool IsRootUrl(string? url)
        => string.Equals(NormalizePath(url), "/", StringComparison.Ordinal);
}
