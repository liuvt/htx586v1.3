@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject NavigationManager Navigation

@code {
    private readonly CancellationTokenSource _disposeCts = new();
    private Task? _watchTask;
    private bool _redirecting;
    private bool _locationHooked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!_locationHooked)
        {
            Navigation.LocationChanged += OnLocationChanged;
            _locationHooked = true;
        }

        // Chỉ điều hướng sau khi component đã interactive để tránh NavigationException
        // trong giai đoạn static prerender của Blazor Server.
        await ValidateCurrentAccountAsync(_disposeCts.Token);

        if (!_redirecting)
            _watchTask = WatchAccountAsync(_disposeCts.Token);
    }


    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_disposeCts.IsCancellationRequested)
            return;

        try
        {
            await InvokeAsync(() => ValidateCurrentAccountAsync(_disposeCts.Token));
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        catch
        {
            // Không làm hỏng circuit nếu kiểm tra trạng thái tạm thời thất bại.
        }
    }

    private async Task WatchAccountAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    await ValidateCurrentAccountAsync(cancellationToken);
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    break;
                }
                catch
                {
                    // Lỗi kết nối DB tạm thời không được làm hỏng circuit;
                    // lần kiểm tra kế tiếp sẽ tiếp tục xác thực trạng thái.
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Component đã được giải phóng.
        }
    }

    private async Task ValidateCurrentAccountAsync(CancellationToken cancellationToken)
    {
        if (_redirecting)
            return;

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = state.User;

        if (principal.Identity?.IsAuthenticated != true)
            return;

        var userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
        {
            await InvokeAsync(RedirectToInactiveLogin);
            return;
        }

        await using var db = await Factory.CreateDbContextAsync(cancellationToken);

        var userState = await db.Users.AsNoTracking()
            .Where(x => x.Id == userId)
            .Select(x => new
            {
                x.IsActive,
                x.IsDeleted,
                x.RegistrationStatus,
                x.VehicleOwnerSignatureFileUrl,
                HasActiveCompany = db.AdminOffices.Any(a => a.AdminUserId == x.Id &&
                    a.IsActive && !a.IsDeleted && a.CompanyProfile.IsActive && !a.CompanyProfile.IsDeleted),
                HasAssignedVehicleWithoutPermit = db.Vehicles.Any(v =>
                    v.AssignedDriverId == x.Id &&
                    v.IsActive &&
                    !v.IsDeleted &&
                    (v.PermitNumber == null || v.PermitNumber.Trim() == string.Empty))
            })
            .FirstOrDefaultAsync(cancellationToken);

        var isOwner = principal.IsInRole("Owner");
        var isAdmin = principal.IsInRole("Admin");
        var isVehicleOwner = principal.IsInRole("VehicleOwner");

        var hasSupportedRole = isOwner || isAdmin || isVehicleOwner;
        var isValid = userState is not null &&
                      userState.IsActive &&
                      !userState.IsDeleted &&
                      hasSupportedRole &&
                      (!isAdmin || isOwner || userState.HasActiveCompany) &&
                      (!isVehicleOwner || string.Equals(
                          userState.RegistrationStatus,
                          "Approved",
                          StringComparison.OrdinalIgnoreCase));

        if (!isValid)
        {
            await InvokeAsync(RedirectToInactiveLogin);
            return;
        }

        if (isVehicleOwner && string.IsNullOrWhiteSpace(userState!.VehicleOwnerSignatureFileUrl))
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            if (!string.Equals(path, "/vehicle-owner/account", StringComparison.OrdinalIgnoreCase))
                await InvokeAsync(() => Navigation.NavigateTo("/vehicle-owner/account?signatureRequired=1"));
            return;
        }

        // Xe được phép tạo/import/gán khi chưa có Số phù hiệu. Sau khi tài khoản
        // VehicleOwner nhận xe, bắt buộc nhập Số phù hiệu đúng một lần trước khi
        // tiếp tục sử dụng các chức năng khác. Xe đã có PermitNumber sẽ không hỏi lại.
        if (isVehicleOwner && userState!.HasAssignedVehicleWithoutPermit)
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            if (!string.Equals(path, "/vehicle-owner/vehicles", StringComparison.OrdinalIgnoreCase))
            {
                var returnUrl = GetCurrentLocalUrl();
                await InvokeAsync(() => Navigation.NavigateTo(
                    "/vehicle-owner/vehicles?permitRequired=1&returnUrl=" +
                    Uri.EscapeDataString(returnUrl)));
            }
        }
    }

    private string GetCurrentLocalUrl()
    {
        var relativeUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        return string.IsNullOrWhiteSpace(relativeUrl) ? "/" : "/" + relativeUrl;
    }

    private void RedirectToInactiveLogin()
    {
        if (_redirecting)
            return;

        _redirecting = true;
        var returnUrl = Uri.EscapeDataString("/account/login?error=inactive");
        Navigation.NavigateTo($"/account/logout?returnUrl={returnUrl}", forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_locationHooked)
        {
            Navigation.LocationChanged -= OnLocationChanged;
            _locationHooked = false;
        }

        await _disposeCts.CancelAsync();

        if (_watchTask is not null)
        {
            try
            {
                await _watchTask;
            }
            catch (OperationCanceledException)
            {
                // Không cần xử lý khi component bị dispose.
            }
        }

        _disposeCts.Dispose();
    }
}
