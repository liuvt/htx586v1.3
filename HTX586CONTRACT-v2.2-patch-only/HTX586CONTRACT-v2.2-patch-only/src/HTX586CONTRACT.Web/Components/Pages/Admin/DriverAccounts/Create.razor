@page "/admin/vehicle-owner-accounts/create"
@page "/admin/driver-accounts/create"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject IDriverAccountService DriverAccountService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Thêm tài khoản VehicleOwner</PageTitle>
<PageHeader Title="Thêm tài khoản VehicleOwner" Subtitle="Tài khoản không gán cố định vào công ty; công ty được xác định theo từng xe được cấp." />

<MudForm @ref="_form" @bind-IsValid="_valid">
    <MudPaper Class="pa-4" Elevation="1">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
            Mật khẩu khởi tạo dùng chung: <b>Htx@586</b>. Người dùng phải đổi mật khẩu sau lần đăng nhập đầu.
        </MudAlert>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.UserName" Label="ID đăng nhập" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.FullName" Label="Họ và tên" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.PhoneNumber" Label="Số điện thoại" Required="true"
                              HelperText="@VietnamPhoneNumber.ValidationMessage" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.EmployeeCode" Label="Mã tài khoản (không bắt buộc)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Value="@ResetPassword" Label="Mật khẩu khởi tạo" Disabled="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Email" Label="Email (không bắt buộc)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_model.Address" Label="Địa chỉ (không bắt buộc)" Lines="2" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
        <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/admin/vehicle-owner-accounts"))">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">
            @(_saving ? "Đang tạo..." : "Tạo tài khoản")
        </MudButton>
    </MudStack>
</MudForm>

@code {
    private const string ResetPassword = "Htx@586";
    private MudForm? _form;
    private bool _valid;
    private bool _saving;
    private CreateDriverAccountRequest _model = new()
    {
        Password = ResetPassword,
        MustChangePassword = true
    };

    private async Task SaveAsync()
    {
        if (_form is not null)
            await _form.ValidateAsync();
        if (!_valid) return;
        if (!VietnamPhoneNumber.TryNormalize(_model.PhoneNumber, out _))
        {
            Snackbar.Add(VietnamPhoneNumber.ValidationMessage, Severity.Warning);
            return;
        }

        try
        {
            _saving = true;
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _model.CreatedByUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
            var id = await DriverAccountService.CreateAsync(_model);
            Snackbar.Add("Đã tạo tài khoản VehicleOwner.", Severity.Success);
            Navigation.NavigateTo($"/admin/vehicle-owner-accounts/{id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
